    skos:broader eusoilvoc:AnthropogenicSoils ;
    skos:exactMatch agrovoc:c_5498,
        nalt:10101 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "paddy soils"@en .

eusoilvoc:Palaeosols a skos:Concept ;
    skos:broader eusoilvoc:PalaeosolicSoilTypes ;
    skos:closeMatch nalt:20443 ;
    skos:exactMatch agrovoc:c_5511 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "palaeosols"@en .

eusoilvoc:ParentDeposition a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source glosis_sp:parentDepositionProperty ;
            rdf:value "Parent Deposition refers to the accumulation of materials, such as sediments or volcanic ash, that contribute to soil formation. These parent materials are deposited through natural processes such as erosion, weathering, or sediment transport, influencing soil texture, nutrient content, and water retention properties. Source: USDA NRCS, 'Soil Genesis and Classification'"@en ] ;
    skos:exactMatch glosis_sp:parentDepositionProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "parent deposition"@en .

eusoilvoc:ParentLithology a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source glosis_sp:parentLithologyProperty ;
            rdf:value "Parent Lithology is the specific geological composition of the parent material (e.g., bedrock or sediment) from which the soil develops. The mineral content and texture of this material directly affect the physical and chemical properties of the soil, such as fertility, permeability, and soil depth. Source: USDA NRCS, 'Soil Genesis and Classification'"@en ] ;
    skos:exactMatch glosis_sp:parentLithologyProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "parent lithology"@en .

eusoilvoc:ParentTextureUnconsolidated a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source glosis_sp:parentTextureUnconsolidatedProperty ;
            rdf:value "Parent Texture Unconsolidated refers to the texture of the unconsolidated parent material, such as loose sediments or debris, that has not been solidified into rock. This texture affects soil properties such as aeration, drainage, and root penetration, as well as its ability to retain nutrients. Source: USDA NRCS, 'Soil Genesis and Classification'"@en ] ;
    skos:exactMatch glosis_sp:parentTextureUnconsolidatedProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "parent texture unconsolidated"@en .

eusoilvoc:ParticleSizeFractionSum a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilParticlePhysicalProperties ;
    skos:definition [ dcterms:source glosis_lh:particleSizeFractionsSumProperty ;
            rdf:value "The Particle Size Fractions Sum refers to the total proportion of sand, silt, and clay particles in soil, expressed as a percentage. It ensures the sum of individual particle size fractions adds up to 100%, a check for accurate soil texture analysis. Particle size distribution impacts water retention, permeability, and soil structure. Source: Hillel, D. (2004). Introduction to Environmental Soil Physics."@en ] ;
    skos:exactMatch glosis_lh:particleSizeFractionsSumProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "particle size fraction sum"@en .

eusoilvoc:PavementStability a skos:Concept ;
    skos:broader eusoilvoc:SoilEngineeringFunctions ;
    skos:exactMatch spp:PavementStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "pavement stability"@en .

eusoilvoc:PeatDecompostion a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Peat ;
    skos:definition [ dcterms:source glosis_lh:peatDecompostionProperty ;
            rdf:value "The Peat Decomposition evaluates the degree of decomposition in organic soils or peat. Categories include fibric (least decomposed), hemic (moderately decomposed), and sapric (highly decomposed), which influence soil fertility and drainage. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:peatDecompostionProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "peat decompostion"@en .

eusoilvoc:PeatDrainage a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Peat ;
    skos:definition [ dcterms:source glosis_lh:peatDrainageProperty ;
            rdf:value "The Peat Drainage assesses the water removal capacity in peat soils, essential for determining their suitability for agriculture, conservation, or other uses. Poorly drained peat often accumulates organic material due to low decomposition rates. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:peatDrainageProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "peat drainage"@en .

eusoilvoc:PeatSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:exactMatch agrovoc:c_5648,
        nalt:24690,
        she:PeatSoils ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
