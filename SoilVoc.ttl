    skos:altLabel "soil volumetric moisture content"@en ;
    skos:broader eusoilvoc:SoilMoistureContents ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The volume of soil water divided by the total volume of soil."@en ],
        [ dcterms:source agrovoc:c_4b440f7a ;
            rdf:value "The volumetric water content is the volume of water per unit volume of soil, expressed as a percentage of the volume."@en ] ;
    skos:exactMatch agrovoc:c_4b440f7a,
        spp:SoilVolumetricMoistureContent ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil volumetric moisture contents"@en .

