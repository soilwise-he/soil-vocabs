eusoilvoc:SoilViscosity a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The coefficient k identified as viscosity in the soil-flow expression V = kμ(F − F′), where V is the volume of flow, μ is the coefficient of mobility, F is the applied force, and F′ is the force needed to overcome cohesion; in viscous flow F′ is zero."@en ] ;
    skos:exactMatch spp:SoilViscosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil viscosity"@en .

