    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ability of a soil to retain its arrangement of solids and void space when external forces are applied."@en ] ;
    skos:exactMatch spp:SoilStructuralStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil structural stability"@en .

eusoilvoc:SoilSuitability a skos:Concept ;
