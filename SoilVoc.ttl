eusoilvoc:SoilTillage a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:closeMatch nalt:25207 ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The mechanical manipulation of soil to improve aeration, control weeds and incorporate organic matter."@en ],
        [ dcterms:source agrovoc:c_7771 ;
            rdf:value "Any physical loosening of the soil carried out in a range of cultivation operations, either by hand or mechanized."@en ] ;
    skos:exactMatch agrovoc:c_7771,
        spp:SoilTillage ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:ConservationTillage,
        eusoilvoc:ConventionalTillage,
        eusoilvoc:DeepTillage,
        eusoilvoc:Disking,
        eusoilvoc:FieldPreparation,
        eusoilvoc:Harrowing,
        eusoilvoc:Planking,
        eusoilvoc:Ploughing,
        eusoilvoc:PrimaryTillage,
        eusoilvoc:RippingTillage,
        eusoilvoc:RotaryCultivation,
        eusoilvoc:SecondaryTillage,
        eusoilvoc:SeedbedPreparation,
        eusoilvoc:SoilBreaking,
        eusoilvoc:SoilPuddling,
        eusoilvoc:SoilScarification,
        eusoilvoc:StoneClearing,
        eusoilvoc:Subsoiling,
        eusoilvoc:SurfaceCultivation ;
    skos:prefLabel "soil tillage"@en .

eusoilvoc:SulfurTotalElements a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Sulfur ;
    skos:definition [ dcterms:source glosis_cl:physioChemicalPropertyCode-Sultot ;
            rdf:value "Total sulfur in soil includes both organic and inorganic forms, such as sulfates and sulfur in organic matter. Sulfur is essential for protein synthesis and enzyme functions in plants. Deficiency leads to stunted growth and yellowing of leaves. Total sulfur provides insight into the soil's potential to release plant-available sulfur over time, critical for sustaining crop health. Source: Havlin, J.L., et al. (2014). Soil Fertility and Fertilizers."@en ] ;
    skos:exactMatch glosis_cl:physioChemicalPropertyCode-Sultot ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
