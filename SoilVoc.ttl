        eusoilvoc:SoilStrain,
        eusoilvoc:SoilVolumeChange ;
    skos:prefLabel "soil deformation"@en .

eusoilvoc:SoilErodibilityIndex a skos:Concept ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
