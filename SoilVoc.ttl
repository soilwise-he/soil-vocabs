    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ratio of soil thermal conductivity KT to volumetric heat capacity CV, expressed as DT = KT/CV."@en ] ;
    skos:exactMatch spp:SoilThermalDiffusivity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil thermal diffusivity"@en .

