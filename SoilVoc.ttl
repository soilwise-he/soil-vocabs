    skos:altLabel "soil erosion by wind"@en ;
    skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source nalt:63376 ;
            rdf:value "The process of detachment, transport, and deposition of soil by wind."@en ] ;
    skos:exactMatch agrovoc:c_8393,
        inrae:c_11222,
        gemet:9330,
        nalt:63376,
        she:SoilErosionByWind ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wind erosion"@en .

eusoilvoc:WoodChipsMulches a skos:Concept ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_b6875485 ;
            rdf:value "A mulch where wood chips are used to cover soil surface. "@en ] ;
    skos:exactMatch agrovoc:c_b6875485 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wood chips mulches"@en .

eusoilvoc:XericSoils a skos:Concept ;
