            rdf:value "The ability of soil structure to recover after a major disruption of the aggregation process."@en ] ;
    skos:exactMatch spp:SoilStructuralResilience ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil structural resilience"@en .

