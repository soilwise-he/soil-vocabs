    skos:exactMatch agrovoc:c_7021 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "shale soils"@en .

eusoilvoc:SheetErosion a skos:Concept ;
    skos:broader eusoilvoc:WaterErosion ;
    skos:definition [ dcterms:source nalt:62999 ;
            rdf:value "Soil erosion occurring from a thin, relatively uniform layer of soil particles on the soil surface."@en ] ;
    skos:exactMatch agrovoc:c_548566f4,
        inrae:c_1534,
        nalt:62999 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "sheet erosion"@en .

eusoilvoc:SilicaSesquioxideRatio a skos:Concept ;
    skos:broader eusoilvoc:SoilErodibilityIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil erodibility based on the relative proportions of silica (SiO2), the material being cemented, and sesquioxides (R2O3), the cementing agents."@en ] ;
    skos:exactMatch spp:SilicaSesquioxideRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "silica sesquioxide ratio"@en .

eusoilvoc:Silt a skos:Concept ;
    skos:broader eusoilvoc:SoilPrimaryParticles ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The intermediate soil-particle fraction that forms part of the soil skeleton, with particle diameters of 0.002–0.02 mm in the classification presented in the textbook."@en ] ;
    skos:exactMatch agrovoc:c_331558,
        spp:Silt,
        inrae:c_11574,
        gemet:7698,
        nalt:62743 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "silt"@en .

