eusoilvoc:SoilChemicalProperties a skos:Concept ;
    skos:altLabel "soil chemical property"@en ;
    skos:broader eusoilvoc:SoilChemicophysicalProperties ;
    skos:definition [ dcterms:source <https://soilhealthnexus.org/resources/soil-properties/soil-chemical-properties/> ;
            rdf:value "Chemical properties of soils include the following aspects: inorganic matters of soil, organic matters in soil, colloidal properties of soil particles and soil reactions and buffering action in acidic soils and basic soils."@en ],
        [ dcterms:source <https://www.sciencedirect.com/topics/earth-and-planetary-sciences/soil-chemical-property> ;
            rdf:value "Soil chemical properties refer to the chemical attributes of soil that influence its ability to supply nutrients to plants, retain harmful elements, and affect plant growth and microbial populations. These properties include nutrient concentrations, pH levels, and the presence of elements such as nitrogen, phosphorus, and potassium, which are critical for soil quality assessment and agricultural productivity."@en ] ;
    skos:exactMatch spp:SoilChemicalProperty,
        nalt:9595,
        she:SoilChemicalProperties ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:BaseSaturation,
        eusoilvoc:BoronContent,
        eusoilvoc:Carbonate,
        eusoilvoc:HydrogenExchangeableBases,
        eusoilvoc:NitrogenContent,
        eusoilvoc:OxalateExtractableOpticalDensity,
        eusoilvoc:PhosphorusContent,
        eusoilvoc:Sodium,
        eusoilvoc:SodiumAdsorptionRatio,
        eusoilvoc:SoilChargeProperties,
        eusoilvoc:SoilChemicalCapacity,
        eusoilvoc:SoilNutrients,
        eusoilvoc:SoilReactivity,
        eusoilvoc:SoilRedoxPotential,
        eusoilvoc:SoilSalinity,
        eusoilvoc:SoilToxicity,
        eusoilvoc:SoilpH ;
    skos:prefLabel "soil chemical properties"@en ;
    skos:related eusoilvoc:SoilQuality .

