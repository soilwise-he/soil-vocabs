eusoilvoc:SoilMoistureContents a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "moisture content"@en,
        "soil moisture content"@en ;
    skos:broader eusoilvoc:SoilProperties,
        eusoilvoc:SoilWaterPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The amount of water removed from soil by heating at 105°C to constant weight, expressed as a fraction or percentage on a mass or volume basis. On a gravimetric basis it equals the difference between wet and dry soil mass divided by dry soil mass."@en ],
        [ dcterms:source glosis_lh:moistureContentProperty ;
            rdf:value "The Moisture Content measures the amount of water present in soil, expressed as a percentage of its dry weight. This property is critical for assessing soil water retention, irrigation needs, and plant-available water. Source: Hillel, D. (2004). Introduction to Environmental Soil Physics."@en ],
        [ dcterms:source agrovoc:c_7208 ;
            rdf:value "Soil-water content is the basic state characteristic of soil; it expresses the relative quantity of water in the soil. Soil-water content can be expressed as the ratio of water amount and the amount of soil."@en ] ;
    skos:exactMatch agrovoc:c_7208,
        spp:SoilMoistureContent,
        glosis_lh:moistureContentProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:AntecedentSoilMoistureContents,
        eusoilvoc:DegreeOfSaturation,
        eusoilvoc:LeastLimitingWaterRange,
        eusoilvoc:LiquidRatio,
        eusoilvoc:PermanentWiltingPoint,
        eusoilvoc:SoilFieldMoistureCapacity,
        eusoilvoc:SoilGravimetricMoistureContents,
        eusoilvoc:SoilVolumetricMoistureContents ;
    skos:prefLabel "soil moisture contents"@en ;
    sosa:hasProcedure eusoilvoc:moistureContentProcedure-VMC_calcul-ptf,
