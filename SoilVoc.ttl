    skos:definition [ dcterms:source agrovoc:c_090f427c ;
            rdf:value "Content of mineral particles with sizes between 6.3-20µm in soil. Note: According to different national and international particle-size classification systems, size classes may differ slightly. "@en ] ;
    skos:exactMatch agrovoc:c_090f427c ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
