eusoilvoc:SoilConservation a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_7165 ;
            rdf:value "Soil conservation is a combination of all methods of management and land use that safeguard the soil against depletion or deterioration by natural or human-induced factors. It most often attempts to ensure that soil does not erode and wash into streams and lakes or blow away in the wind, but it also involves the protection of the soil from damage by machinery (e.g., compaction) or by harmful changes to its chemistry (e.g., acidification or salinization)."@en ] ;
    skos:exactMatch agrovoc:c_7165,
        inrae:c_11631,
        gemet:7852,
        nalt:17339 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:ErosionControl,
        eusoilvoc:InSituSoilConservation,
        eusoilvoc:SoilConservationLegislation,
        eusoilvoc:SoilStabilization ;
    skos:prefLabel "soil conservation"@en .

