eusoilvoc:SlippingOfSoil a skos:Concept ;
    skos:broader eusoilvoc:SoilMovement ;
    skos:exactMatch agrovoc:c_14336 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "slipping of soil"@en .

eusoilvoc:SlopeForms a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "slope form"@en ;
    skos:broader eusoilvoc:Slope ;
    skos:definition [ dcterms:source glosis_sp:slopeFormProperty ;
            rdf:value "Slope Form describes the shape or curvature of a slope, including its concave, convex, or straight profile. Slope form affects water runoff, erosion rates, and soil accumulation, influencing both the fertility and stability of the soil in hilly or mountainous regions. Source: FAO, 'Soil and Water Conservation'"@en ] ;
    skos:exactMatch glosis_sp:slopeFormProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "slope forms"@en .

eusoilvoc:SlopeGradientClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_sp:slopeGradientClassProperty ;
            rdf:value "Slope Gradient Class refers to the classification of slope steepness, such as flat, moderate, or steep, based on its angle. The gradient of a slope influences soil erosion rates, water drainage, and the suitability of land for agriculture, with steeper slopes typically being more prone to erosion. Source: USDA NRCS, 'Soil Erosion and Conservation'"@en ] ;
    skos:exactMatch glosis_sp:slopeGradientClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "slope gradient class"@en .

eusoilvoc:SlopeGradientNumeric a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SlopeGradient ;
    skos:definition [ dcterms:source glosis_sp:slopeGradientProperty ;
            rdf:value "Slope Gradient Property refers to the numerical measurement of the steepness of a slope, usually expressed as a percentage or angle. This property is crucial in determining soil erosion potential, water runoff, and suitability for land use, as steeper slopes are more prone to erosion and less suitable for cultivation without proper soil conservation measures. Source: USDA NRCS, 'Soil Erosion and Conservation'"@en ] ;
    skos:exactMatch glosis_sp:slopeGradientProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "slope gradient numeric"@en .

eusoilvoc:SlopeOrientationClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_sp:slopeOrientationClassProperty ;
            rdf:value "Slope Orientation Class classifies the direction in which a slope faces (north, south, east, west) and can significantly affect local climate conditions, such as sunlight exposure, moisture, and temperature. For instance, south-facing slopes in the Northern Hemisphere receive more sunlight, influencing soil temperature, vegetation types, and soil moisture availability. Source: FAO, 'Soil and Water Conservation'"@en ] ;
    skos:exactMatch glosis_sp:slopeOrientationClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "slope orientation class"@en .

eusoilvoc:SlopeOrientationNumeric a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SlopeOrientation ;
    skos:definition [ dcterms:source glosis_sp:slopeOrientationProperty ;
            rdf:value "Slope Orientation refers to the precise directional orientation of a slope, measured in degrees from a cardinal direction (e.g., 0° for north, 180° for south). The slope orientation impacts factors such as solar radiation, evaporation rates, and vegetation cover, all of which affect soil temperature, moisture retention, and erosion potential. Source: USDA NRCS, 'Soil Erosion and Landscape Analysis'"@en ] ;
    skos:exactMatch glosis_sp:slopeOrientationProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "slope orientation numeric"@en .

eusoilvoc:SlopePathways a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "slope pathway"@en ;
    skos:broader eusoilvoc:Slope ;
    skos:definition [ dcterms:source glosis_sp:slopePathwaysProperty ;
            rdf:value "Slope Pathways identifies the natural flow paths of water, sediment, or other materials across a slope. These pathways, often defined by the topography, influence how water moves, erodes soil, and accumulates nutrients or contaminants. Understanding these pathways is critical for effective erosion control and water management in sloped areas. Source: FAO, 'Soil Erosion and Conservation'"@en ] ;
    skos:exactMatch glosis_sp:slopePathwaysProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "slope pathways"@en .

