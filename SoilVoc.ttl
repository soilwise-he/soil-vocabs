    skos:closeMatch nalt:51864 ;
    skos:exactMatch agrovoc:c_8462 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "xeric soils"@en .

eusoilvoc:XerosolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:exactMatch agrovoc:c_8463,
        nalt:306591 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "xerosols"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:YermosolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:exactMatch agrovoc:c_8484 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "yermosols"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:acidityExchangeableProcedure-ExchAcid_ph0-kcl1m a skos:Concept,
        sosa:Procedure ;
    skos:definition [ dcterms:source glosis_proc:acidityExchangeableProcedure-ExchAcid_ph0-kcl1m ;
