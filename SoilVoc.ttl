        eusoilvoc:SoilProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The relative volume of soil voids or pores, expressed as a fraction or percentage of total soil volume or of the volume of soil solids, according to the measure used."@en ],
        [ dcterms:source glosis_cl:physioChemicalPropertyCode-Por ;
            rdf:value "Porosity refers to the percentage of soil volume occupied by pores or voids, which hold air and water. It directly impacts water infiltration, drainage, and root growth. Soils with high porosity are better suited for crop cultivation, as they provide good aeration and water availability. Source: Brady & Weil (2017)."@en ] ;
    skos:exactMatch agrovoc:c_35320,
        spp:SoilPorosity,
        inrae:c_16324,
        glosis_cl:physioChemicalPropertyCode-Por,
        she:SoilPorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:AirFilledPorosity,
        eusoilvoc:AirPorosity,
        eusoilvoc:AirRatio,
        eusoilvoc:InterAggregatePorosity,
        eusoilvoc:IntraAggregatePorosity,
        eusoilvoc:Macroporosity,
        eusoilvoc:StructuralPorosity,
        eusoilvoc:TexturalPorosity,
        eusoilvoc:TotalPorosity,
        eusoilvoc:VoidRatio ;
    skos:prefLabel "soil porosity"@en ;
    sosa:hasProcedure eusoilvoc:porosityProcedure-Poros_calcul-pf0 .

eusoilvoc:SoilThreats a skos:Concept ;
    skos:altLabel "soil threat"@en ;
    skos:definition [ dcterms:source <https://soilhealthbenchmarks.eu/glossary/soil-threat/> ;
            rdf:value "Soil threats are processes that could degrade (some of) the functions of soils and the services that soils provide. Examples of soil threats are: acidification, compaction, contamination (pollution), decline in soil organic matter, decline in soil biodiversity, desertification, erosion, flooding and water logging, landslides, salinization."@en ] ;
    skos:exactMatch she:SoilThreats ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:SOCLoss,
        eusoilvoc:Salinisation,
        eusoilvoc:SoilAcidification,
        eusoilvoc:SoilBiodiversityLoss,
        eusoilvoc:SoilCompaction,
        eusoilvoc:SoilDeficiencies,
        eusoilvoc:SoilDegradation,
        eusoilvoc:SoilErosion,
        eusoilvoc:SoilNutrientLoss,
        eusoilvoc:SoilPollution,
        eusoilvoc:SoilSealing,
        eusoilvoc:Waterlogging ;
    skos:prefLabel "soil threats"@en ;
    skos:topConceptOf <https://w3id.org/eusoilvoc> .

