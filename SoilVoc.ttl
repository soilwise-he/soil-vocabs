eusoilvoc:Biodrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:definition [ dcterms:source agrovoc:c_ac7696b9 ;
            rdf:value "Biodrainage is defined as the process of removing the excess soil water through transpiration using bio-energy of the plant and radiation energy of the sun."@en ] ;
    skos:exactMatch agrovoc:c_ac7696b9 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biodrainage"@en .

eusoilvoc:BiologicalAbundance a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilBiologicalProperties ;
    skos:definition [ dcterms:source glosis_lh:biologicalAbundanceProperty ;
            rdf:value "The Biological Abundance evaluates the presence and quantity of soil organisms, such as microbes, insects, and earthworms. This property reflects soil health, nutrient cycling, and organic matter decomposition, which are vital for maintaining soil fertility. Source: Lavelle, P., & Spain, A.V. (2001). Soil Ecology."@en ] ;
    skos:exactMatch glosis_lh:biologicalAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biological abundance"@en .

eusoilvoc:BiologicalFeatures a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "biological feature"@en ;
    skos:broader eusoilvoc:SoilBiologicalProperties ;
    skos:definition [ dcterms:source glosis_lh:biologicalFeaturesProperty ;
            rdf:value "The Biological Features examines qualitative aspects of soil biological activity, including the types of organisms present, their diversity, and their roles in soil ecosystems. It encompasses processes like nitrogen fixation, organic matter decomposition, and bioturbation. Source: Soil Science Society of America (SSSA) Glossary."@en ] ;
    skos:exactMatch glosis_lh:biologicalFeaturesProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biological features"@en .

eusoilvoc:BiologicalNitrogenFixation a skos:Concept ;
    skos:broader eusoilvoc:SoilBiologicalProcesses ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The process by which bacteria absorb nitrogen gas from the air and convert it to ammonium that plants can use."@en ] ;
    skos:exactMatch agrovoc:c_27742,
        spp:BiologicalNitrogenFixation,
        gemet:862 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biological nitrogen fixation"@en .

eusoilvoc:BiomassProductivity a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctionIndicators ;
    skos:exactMatch she:BiomassProductivity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biomass productivity"@en .

eusoilvoc:BleachedSand a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Sand ;
    skos:definition [ dcterms:source glosis_cm:bleachedSandProperty ;
            rdf:value "The Bleached Sand refers to the physical characteristic of sandy soil that has undergone a bleaching process due to leaching, where minerals such as iron and other elements have been removed by water. This process often occurs in areas with high rainfall, leading to a soil that appears lighter in color. Bleached sand typically indicates low fertility and poor nutrient-holding capacity due to the lack of iron and other nutrients that are washed away. Source: Brady, N. C., & Weil, R. R. (2008). The Nature and Properties of Soils (14th ed.). Pearson Prentice Hall."@en ] ;
    skos:exactMatch glosis_cm:bleachedSandProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bleached sand"@en .

eusoilvoc:BogSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_986,
        nalt:18400 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bog soils"@en .

eusoilvoc:BottomlandSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_1033,
        nalt:18873 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bottomland soils"@en .

eusoilvoc:BoulderClaySoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_1036 ;
            rdf:value "The boulder clay soils typically comprise very slightly stony (<5% stones), non-calcareous or very slightly calcareous (<1% CaCO-), heavy clay loam or clay topsoil overlying a clay or heavy clay loam upper subsoil passing to a clay lower subsoil within 45-60 cm."@en ] ;
    skos:exactMatch agrovoc:c_1036 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "boulder clay soils"@en .

eusoilvoc:BoundaryDistinctness a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilHorizonBoundary ;
    skos:definition [ dcterms:source glosis_lh:boundaryDistinctnessProperty ;
            rdf:value "The Boundary Distinctness describes the sharpness of transitions between soil horizons. Boundaries can range from abrupt (clear demarcation) to diffuse (gradual blending), providing insights into soil formation processes and profile development. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:boundaryDistinctnessProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "boundary distinctness"@en .

eusoilvoc:BoundaryTopography a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilHorizonBoundary ;
    skos:definition [ dcterms:source glosis_lh:boundaryTopographyProperty ;
            rdf:value "The Boundary Topography characterizes the shape of soil horizon boundaries, which may be smooth, wavy, irregular, or broken. It reflects processes like erosion, deposition, or biological activity that influence horizon development. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:boundaryTopographyProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "boundary topography"@en .

eusoilvoc:Building a skos:Concept ;
    skos:broader eusoilvoc:LandCover ;
    skos:closeMatch she:Buildings ;
    skos:exactMatch spp:Building,
        inrae:c_2560,
        gemet:1029 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "building"@en .

eusoilvoc:BuildingStability a skos:Concept ;
    skos:broader eusoilvoc:SoilEngineeringFunctions ;
    skos:exactMatch spp:BuildingStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "building stability"@en .

eusoilvoc:BulkDensityMineral a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilBulkDensity ;
    skos:definition [ dcterms:source glosis_lh:bulkDensityMineralProperty ;
            rdf:value "The Bulk Density of Mineral Soil refers specifically to the density of the mineral portion of the soil, excluding organic matter. It provides insights into the physical state and compaction of mineral-dominated soils, influencing water movement and root growth. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."@en ] ;
    skos:exactMatch glosis_lh:bulkDensityMineralProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bulk density mineral"@en .

eusoilvoc:BulkDensityPeat a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilBulkDensity ;
    skos:definition [ dcterms:source glosis_lh:bulkDensityPeatProperty ;
            rdf:value "The Bulk Density of Peat measures the mass of dry organic soil (peat) per unit volume. Peat soils typically have low bulk density due to their high organic matter content and porosity, which significantly affects their water retention and drainage characteristics. Source: Rydin, H., & Jeglum, J. (2006). The Biology of Peatlands."@en ] ;
    skos:exactMatch glosis_lh:bulkDensityPeatProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bulk density peat"@en .

eusoilvoc:BuriedSoils a skos:Concept ;
    skos:broader eusoilvoc:PalaeosolicSoilTypes ;
    skos:exactMatch agrovoc:c_1154,
        nalt:20442 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "buried soils"@en .

eusoilvoc:CHorizons a skos:Concept ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:exactMatch agrovoc:c_016fddeb,
        nalt:20702 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "C horizons"@en .

eusoilvoc:CalamineSoils a skos:Concept ;
    skos:broader eusoilvoc:MineralogicalSoilTypes ;
    skos:exactMatch agrovoc:c_1189 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "calamine soils"@en .

eusoilvoc:CalcisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_ea60e31f ;
            rdf:value "Calcisols accommodate soils with substantial accumulation of secondary carbonates. Calcisols are widespread in arid and semi-arid environments, often associated with highly calcareous parent materials. Many Calcisols have formerly been called Desert soils. In the United States of America most of them belong to the Calcids, and in Australia to the Calcarosols. In the Soil Map of the World (FAO–UNESCO, 1971–1981) most of them belong to the Xerosols and to a lesser extent to the Yermosols."@en ] ;
    skos:exactMatch agrovoc:c_ea60e31f,
        nalt:216343,
        she:Calcisols ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Calcisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:CalciticLimeAmendment a skos:Concept ;
    skos:broader eusoilvoc:LimingMaterials ;
    skos:definition [ dcterms:source agrovoc:c_36453 ;
            rdf:value "Liming material. Calcitic lime is derived from deposits of primarily calcium carbonate. "@en ] ;
    skos:exactMatch agrovoc:c_36453 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "calcitic lime (amendment)"@en .

eusoilvoc:CambisolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils having a cambic B horizon or an umbric A horizon which is more than 25 cm thick."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Cambisols"@en .

eusoilvoc:CambisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_1224 ;
            rdf:value "Cambisols combine soils with at least an incipient subsurface soil formation. Transformation of parent material is evident from structure formation and mostly brownish discoloration, increasing clay percentage, and/or carbonate removal. Other soil classification systems refer to many Cambisols as Braunerden and Terrae fuscae (Germany), Sols bruns (France), burozems (Russia) and Tenosols (Australia). The name Cambisols was coined for the Soil Map of the World (FAO–UNESCO, 1971–1981) and later adopted by Brazil (Cambissolos). In the United States of America they were formerly called Brown soils/Brown forest soils and are now named Inceptisols."@en ] ;
    skos:exactMatch agrovoc:c_1224 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Cambisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:CarbonPools a skos:Concept ;
    skos:altLabel "carbon pool"@en ;
    skos:broader eusoilvoc:SoilFunctions ;
    skos:closeMatch nalt:75002 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "carbon pools"@en .

eusoilvoc:CarbonStorageCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctionIndicators ;
    skos:exactMatch she:CarbonStorageCapacity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "carbon storage capacity"@en .

eusoilvoc:CarbonateContents a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "carbonate content"@en ;
    skos:broader eusoilvoc:Carbonate ;
    skos:definition [ dcterms:source glosis_lh:carbonatesContentProperty ;
            rdf:value "The Carbonate Content quantifies the concentration of carbonate minerals (e.g., CaCO₃, MgCO₃) in soil. These compounds influence soil pH, fertility, and structure, and are prevalent in calcareous soils. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."@en ] ;
    skos:exactMatch glosis_lh:carbonatesContentProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "carbonate contents"@en .

eusoilvoc:CarbonateForms a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "carbonate form"@en ;
    skos:broader eusoilvoc:Carbonate ;
    skos:definition [ dcterms:source glosis_lh:carbonatesFormsProperty ;
            rdf:value "The Carbonate Form describes the types of carbonate minerals present in soil, such as calcite, dolomite, or aragonite. These forms impact soil chemistry, fertility, and physical characteristics differently depending on their composition and solubility. Source: Sparks, D.L. (2003). Environmental Soil Chemistry."@en ] ;
    skos:exactMatch glosis_lh:carbonatesFormsProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "carbonate forms"@en .

eusoilvoc:CationExchange a skos:Concept ;
    skos:broader eusoilvoc:IonExchange ;
    skos:exactMatch spp:CationExchange,
        inrae:c_3a30d01b,
        nalt:143145,
        she:CationExchange ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cation exchange"@en .

eusoilvoc:CationExchangeCapacityEffective a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:CationExchangeCapacity ;
    skos:definition [ dcterms:source glosis_lh:cationExchangeCapacityEffectiveProperty ;
            rdf:value "The Effective Cation Exchange Capacity (ECEC) measures the ability of soil to hold and exchange cations at a given pH, often near field conditions. It provides insight into soil fertility, nutrient availability, and buffering capacity in acidic soils. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."@en ] ;
    skos:exactMatch glosis_lh:cationExchangeCapacityEffectiveProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cation exchange capacity effective"@en .

eusoilvoc:CationSum a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "cations sum"@en ;
    skos:broader eusoilvoc:ExchangeableCations ;
    skos:definition [ dcterms:source glosis_lh:cationsSumProperty ;
            rdf:value "The Cations Sum calculates the total concentration of exchangeable cations (e.g., Ca²⁺, Mg²⁺, K⁺, Na⁺) in the soil. It helps determine soil fertility and salinity and is commonly expressed in milliequivalents per 100 grams of soil. Source: Soil Science Society of America (SSSA) Glossary."@en ] ;
    skos:exactMatch glosis_lh:cationsSumProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cation sum"@en .

eusoilvoc:CementationContinuity a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Cementation ;
    skos:definition [ dcterms:source glosis_lh:cementationContinuityProperty ;
            rdf:value "The Cementation Continuity describes the extent to which soil particles are bound together by cementing agents, such as calcium carbonate, iron oxides, or silica. Cementation affects soil permeability, root penetration, and the development of soil horizons. Continuity can be classified as continuous, discontinuous, or patchy. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:cementationContinuityProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cementation continuity"@en .

eusoilvoc:CementationDegree a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Cementation ;
    skos:definition [ dcterms:source glosis_lh:cementationDegreeProperty ;
            rdf:value "The Cementation Degree measures how strongly soil particles are bonded by cementing agents. It ranges from weakly cemented (friable) to strongly cemented (hard). This property influences soil strength and its suitability for agricultural and engineering purposes. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:cementationDegreeProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cementation degree"@en .

eusoilvoc:CementationFabric a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Cementation ;
    skos:definition [ dcterms:source glosis_lh:cementationFabricProperty ;
            rdf:value "The Cementation Fabric examines the texture, structure, and arrangement of cementing materials within the soil. It provides insights into soil formation processes and the mechanical stability of the soil matrix. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:cementationFabricProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cementation fabric"@en .

eusoilvoc:CementationNature a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Cementation ;
    skos:definition [ dcterms:source glosis_lh:cementationNatureProperty ;
            rdf:value "The Cementation Nature identifies the specific type of material responsible for binding soil particles, such as carbonates, silica, or iron oxides. Understanding this helps in soil classification and predicting behavior under varying environmental conditions. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:cementationNatureProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cementation nature"@en .

eusoilvoc:ChalkSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_1493,
        nalt:24304 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "chalk soils"@en .

eusoilvoc:ChernozemsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils having a mollic A horizon with a moist chroma of 2 or less to a depth of at least IS cm; having one or more of the following: a calcic or a gypsic horizon, or concentrations of soft powdery lime within 125 cm of the surface when the weighted average textural class is coarse, within 90 cm for medium textures, within 75 cm for fine textures."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Chernozems"@en .

eusoilvoc:ChernozemsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_1533 ;
            rdf:value "Chernozems accommodate soils with a thick blackish mineral surface layer that is rich in organic matter. The Russian soil scientist V.V. Dokuchaev coined the name Chernozem in 1883 to denote the typical soils of the tall-grass steppes in continental Russia. Many Chernozems correspond to Kalktschernoseme (Germany), Chernosols (France), Eluviated black soils (Canada) and Chernossolos (Brazil). In the United States of America they were formerly called Calcareous black soils and belong now to several Suborders (especially Udolls) of the Mollisols."@en ] ;
    skos:exactMatch agrovoc:c_1533 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Chernozems"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:Chromium a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:exactMatch agrovoc:c_1595,
        inrae:c_15743,
        gemet:1401,
        nalt:25802,
        she:Chromium ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "chromium"@en .

eusoilvoc:ClayRatio a skos:Concept ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index, also called the mechanical ratio, equal to the sand content divided by the combined silt and clay content."@en ] ;
    skos:exactMatch spp:ClayRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "clay ratio"@en .

eusoilvoc:ClaypanSoils a skos:Concept ;
    skos:broader eusoilvoc:StructuralSoilTypes ;
    skos:exactMatch agrovoc:c_1660,
        nalt:26756 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "claypan soils"@en .

eusoilvoc:ClimateRegulation a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctions ;
    skos:exactMatch gemet:15098,
        she:ClimateRegulation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "climate regulation"@en .

eusoilvoc:CoarseSilt a skos:Concept ;
    skos:broader eusoilvoc:SoilTexture ;
    skos:definition [ dcterms:source agrovoc:c_c1b90f01 ;
            rdf:value "Content of mineral particles with sizes between 20-63µm in soil. Note: According to different national and international particle-size classification systems, size classes may differ slightly. "@en ] ;
    skos:exactMatch agrovoc:c_c1b90f01 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coarse silt"@en .

eusoilvoc:CoastalSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_1699,
        nalt:27365 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coastal soils"@en .

eusoilvoc:CoatingAbundance a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilCoating ;
    skos:definition [ dcterms:source glosis_lh:coatingAbundanceProperty ;
            rdf:value "The Coating Abundance evaluates the quantity of coatings on soil particles, such as organic matter, clay, or iron oxides. Coatings influence soil color, nutrient availability, and water movement. The abundance is typically classified as few, common, or many. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."@en ] ;
    skos:exactMatch glosis_lh:coatingAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coating abundance"@en .

eusoilvoc:CoatingContrast a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilCoating ;
    skos:definition [ dcterms:source glosis_lh:coatingContrastProperty ;
            rdf:value "The Coating Contrast assesses the visual distinction between coatings on soil particles and the underlying material. High contrast indicates significant differences in composition or color, providing clues about soil processes like illuviation or biological activity. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:coatingContrastProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coating contrast"@en .

eusoilvoc:CoatingForms a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "coating form"@en ;
    skos:broader eusoilvoc:SoilCoating ;
    skos:definition [ dcterms:source glosis_lh:coatingFormProperty ;
            rdf:value "The Coating Form describes the shape and distribution of coatings on soil particles, such as patchy, continuous, or layered. These forms are indicative of soil genesis and chemical weathering processes. Source: Soil Science Society of America (SSSA) Glossary."@en ] ;
    skos:exactMatch glosis_lh:coatingFormProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coating forms"@en .

eusoilvoc:CoatingLocation a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilCoating ;
    skos:definition [ dcterms:source glosis_lh:coatingLocationProperty ;
            rdf:value "The Coating Location identifies where coatings are found within the soil profile, such as along root channels, pore spaces, or on particle surfaces. This property helps determine the movement of water and nutrients in the soil. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."@en ] ;
    skos:exactMatch glosis_lh:coatingLocationProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coating location"@en .

eusoilvoc:CoatingNature a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilCoating ;
    skos:definition [ dcterms:source glosis_lh:coatingNatureProperty ;
            rdf:value "The Coating Nature examines the composition of soil coatings, such as organic, clay, or iron-rich coatings. The nature of these coatings can influence nutrient retention, soil color, and water dynamics. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."@en ] ;
    skos:exactMatch glosis_lh:coatingNatureProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coating nature"@en .

