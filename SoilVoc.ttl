    skos:prefLabel "Regosols"@en .

eusoilvoc:RegosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_6492 ;
            rdf:value "Regosols are very weakly developed mineral soils in unconsolidated materials that do not have a mollic or umbric horizon, are not very thin or very rich in coarse fragments (Leptosols), not sandy (Arenosols), and not with fluvic materials (Fluvisols). Regosols are extensive in eroding lands and accumulation zones, particularly in arid and semiarid areas and in mountainous terrain. Many Regosols correlate with soil taxa that are marked by incipient soil formation such as Entisols (United States of America), Rudosols (Australia), Regosole (Germany), Sols peu évolués régosoliques d’érosion or even Sols minéraux bruts d’apport éolien ou volcanique (France), Pelozems (Russia) and Neossolos (Brazil)."@en ] ;
    skos:exactMatch agrovoc:c_6492 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Regosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:RegulatingServices a skos:Concept ;
    skos:altLabel "regulating service"@en ;
    skos:broader eusoilvoc:EcosystemServices ;
    skos:exactMatch agrovoc:c_eff3625d,
        she:RegulatingServices ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "regulating services"@en .

eusoilvoc:RendzinasFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:closeMatch agrovoc:c_6501 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rendzinas"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:ResidualShrinkage a skos:Concept ;
    skos:broader eusoilvoc:SoilShrinkage ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The stage of soil shrinkage following normal shrinkage, in which further shrinkage results from compression and orientation of particles, air enters the soil, and the shrinkage-curve slope is less than one."@en ] ;
    skos:exactMatch spp:ResidualShrinkage ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "residual shrinkage"@en .

eusoilvoc:RetisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_ff831af0 ;
            rdf:value "Retisols have a clay illuviation horizon with an interfingering of bleached coarsertextured soil material into the illuviation horizon forming a net-like pattern. The interfingering bleached coarser-textured material is characterized by a partial removal of clay and free iron oxides. There may be also bleached coarser-textured material falling from the overlying horizon into cracks in the illuvial horizon. Many Retisols correlate with the Podzoluvisols of the Soil Map of the World (FAO–UNESCO, 1971–1981). In other systems they are called Soddy-podzolic or Sodzolic soils (Russia), Fahlerden (Germany), and Glossaqualfs, Glossocryalfs and Glossudalfs (United States of America). Albeluvisols of the former editions of WRB are included in the concept of Retisols."@en ] ;
    skos:exactMatch agrovoc:c_ff831af0 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Retisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:RevisedUniversalSoilLossEquation a skos:Concept ;
    skos:broader eusoilvoc:SoilErosionModels ;
    skos:definition [ dcterms:source agrovoc:c_9021e8ed ;
            rdf:value "The potential for erosion can be calculated using the Revised Universal Soil Loss Equation (RUSLE). The equation is written as A = R x K x LS x C x P where: A = predicted soil loss R = rainfall and runoff K = soil erodibility LS = slope length and steepness C = crop management P = support practices (farming direction, strip cropping, etc.)"@en ] ;
    skos:exactMatch agrovoc:c_9021e8ed,
        nalt:37667 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Revised Universal Soil Loss Equation"@en .

eusoilvoc:Rhizosphere a skos:Concept ;
    skos:broader eusoilvoc:Soil ;
    skos:definition [ dcterms:source agrovoc:c_6569 ;
            rdf:value "Rhizosphere: region of soil near the roots of growing plants."@en ] ;
    skos:exactMatch agrovoc:c_6569,
        inrae:c_6958,
        nalt:52688 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rhizosphere"@en .

eusoilvoc:RhizospherePH a skos:Concept ;
    skos:broader eusoilvoc:SoilpH ;
    skos:exactMatch agrovoc:c_36313,
        inrae:c_16621 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rhizosphere pH"@en .

eusoilvoc:RidgeTillage a skos:Concept ;
    skos:broader eusoilvoc:ConservationTillage ;
    skos:definition [ dcterms:source agrovoc:c_25818 ;
            rdf:value "Ridge  tillage or ridge-till describes  the practice  of  forming ridges from tilled soil into which widely spaced row crops are drilled. Such ridges may remain in place for several seasons while successive crops are no-tilled into the ridges,or they might be re-formed annually."@en ] ;
    skos:exactMatch agrovoc:c_25818,
        nalt:28632 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ridge tillage"@en .

eusoilvoc:RillErosion a skos:Concept ;
    skos:broader eusoilvoc:WaterErosion ;
    skos:definition [ dcterms:source nalt:61575 ;
            rdf:value "The process by which numerous small channels, at the most only several inches deep, are formed on recently cultivated or exposed soils."@en ] ;
    skos:exactMatch agrovoc:c_27001,
        nalt:61575,
        she:RillErosion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rill erosion"@en .

eusoilvoc:RippingTillage a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_36248 ;
            rdf:value "Ripping in tillage refers to the deep mechanical loosening of soil using specialized equipment, such as rippers or subsoilers."@en ] ;
    skos:exactMatch agrovoc:c_36248 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ripping (tillage)"@en .

eusoilvoc:RiverTerraceSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_6616,
        nalt:305595 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "river terrace soils"@en .

eusoilvoc:Road a skos:Concept ;
    skos:broader eusoilvoc:Pavements ;
    skos:exactMatch spp:Road,
        inrae:c_21732,
        gemet:7272 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "road"@en .

eusoilvoc:RoadsideSoils a skos:Concept ;
    skos:broader eusoilvoc:AnthropogenicSoils ;
    skos:exactMatch agrovoc:c_6622,
        nalt:10105 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "roadside soils"@en .

eusoilvoc:RockAbundance a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Rock ;
    skos:definition [ dcterms:source glosis_cm:rockAbundanceProperty ;
            rdf:value "The Rock Abundance refers to the proportion or percentage of rock fragments in the soil profile. High rock abundance can affect soil tillage, water retention, root penetration, and overall soil fertility. It is often used to assess land suitability for agriculture and vegetation. Source: FAO (2006). Guidelines for Soil Description (4th ed.). Food and Agriculture Organization of the United Nations."@en ] ;
    skos:exactMatch glosis_cm:rockAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rock abundance"@en .

eusoilvoc:RockOutcropCover a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "rock outcrops cover"@en ;
    skos:broader eusoilvoc:RockOutcrops ;
    skos:definition [ dcterms:source glosis_sp:rockOutcropsCoverProperty ;
            rdf:value "Rock Outcrops Cover measures the extent to which rock outcrops (exposed bedrock or rock masses) cover the landscape. The presence of rock outcrops can influence soil depth and water retention, as well as contribute to erosion and landscape stability, particularly in areas with minimal soil cover. Source: USDA NRCS, 'Soil Survey Manual'"@en ] ;
    skos:exactMatch glosis_sp:rockOutcropsCoverProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rock outcrop cover"@en .

eusoilvoc:RockOutcropDistance a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "rock outcrops distance"@en ;
    skos:broader eusoilvoc:RockOutcrops ;
    skos:definition [ dcterms:source glosis_sp:rockOutcropsDistanceProperty ;
            rdf:value "Rock Outcrops Distance quantifies the distance from a given point or area to the nearest rock outcrop. The proximity to rock outcrops can influence soil development, with areas closer to outcrops often having thinner soils and higher vulnerability to erosion. Source: FAO, 'Soil Formation and Classification'"@en ] ;
    skos:exactMatch glosis_sp:rockOutcropsDistanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rock outcrop distance"@en .

eusoilvoc:RockShape a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Rock ;
    skos:definition [ dcterms:source glosis_cm:rockShapeProperty ;
            rdf:value "The Rock Shape describes the physical form of rock fragments in the soil, which can range from angular to rounded. Angular rocks are generally a sign of recent weathering, while rounded rocks have been smoothed by long-term weathering processes. The shape of rocks influences soil texture, drainage, and tillage requirements. Source: FAO (2006). Guidelines for Soil Description (4th ed.). Food and Agriculture Organization of the United Nations."@en ] ;
    skos:exactMatch glosis_cm:rockShapeProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rock shape"@en .

eusoilvoc:RockSize a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Rock ;
    skos:definition [ dcterms:source glosis_cm:rockSizeProperty ;
            rdf:value "The Rock Size refers to the dimensions of the rock fragments present in the soil. Rocks are typically classified by their size, from small gravel to large boulders. Larger rocks can limit root growth, hinder water infiltration, and complicate soil management practices. Source: Soil Science Society of America. (2008). Soil Science Glossary. Soil Science Society of America."@en ] ;
    skos:exactMatch glosis_cm:rockSizeProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rock size"@en .

eusoilvoc:RootAbundance a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "roots abundance"@en ;
    skos:broader eusoilvoc:Roots ;
    skos:definition [ dcterms:source glosis_lh:rootsAbundanceProperty ;
            rdf:value "The Roots Abundance describes the quantity of plant roots within a soil profile, typically categorized as few, common, or many. Root abundance reflects plant-soil interactions, soil fertility, and the physical structure that supports vegetation. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:rootsAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "root abundance"@en .

eusoilvoc:RootBiomass a skos:Concept ;
    skos:broader eusoilvoc:Biomass ;
    skos:exactMatch spp:RootBiomass,
        inrae:c_6400 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "root biomass"@en .

eusoilvoc:RootPresence a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "roots presence"@en ;
    skos:broader eusoilvoc:Roots ;
    skos:definition [ dcterms:source glosis_lh:rootsPresenceProperty ;
            rdf:value "The Roots Presence identifies whether roots are visible in a soil profile or horizon. It indicates biological activity, soil health, and the suitability of the soil for plant growth. Roots are commonly observed during soil surveys and are classified by type and density. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."@en ] ;
    skos:exactMatch glosis_lh:rootsPresenceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "root presence"@en .

eusoilvoc:RootRespiration a skos:Concept ;
    skos:broader eusoilvoc:SoilBiologicalProcesses ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The oxidation of organic compounds by plant roots, accompanied by oxygen absorption and carbon dioxide release."@en ] ;
    skos:exactMatch spp:RootRespiration,
        inrae:c_8243 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "root respiration"@en .

eusoilvoc:RotaryCultivation a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:closeMatch nalt:61706 ;
    skos:definition [ dcterms:source agrovoc:c_24233 ;
            rdf:value "A method of cultivation by a motorized cultivator that works the soil by means of rotating tines or blades."@en ] ;
    skos:exactMatch agrovoc:c_24233 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rotary cultivation"@en .

eusoilvoc:SOCLoss a skos:Concept ;
    skos:altLabel "SOC loss"@en ;
    skos:broader eusoilvoc:SoilThreats ;
    skos:closeMatch she:SOCLosses ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil organic carbon loss"@en .

eusoilvoc:SalineSodicSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:exactMatch agrovoc:c_6750,
        nalt:24691 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "saline sodic soils"@en .

eusoilvoc:Salinisation a skos:Concept ;
    skos:broader eusoilvoc:SoilThreats ;
    skos:closeMatch she:SoilSalinisation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salinisation"@en .

eusoilvoc:SalinityControl a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:exactMatch agrovoc:c_32681 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salinity control"@en .

eusoilvoc:SaltContents a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "salt content"@en ;
    skos:broader eusoilvoc:SolubleSalts ;
    skos:definition [ dcterms:source glosis_lh:saltContentProperty ;
            rdf:value "The Salt Content measures the concentration of soluble salts in soil, critical for assessing salinity. Excess salts can hinder plant growth by affecting osmotic potential, leading to reduced water uptake by roots. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."@en ] ;
    skos:exactMatch glosis_lh:saltContentProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salt contents"@en .

eusoilvoc:SaltCover a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Salts ;
    skos:definition [ dcterms:source glosis_su:saltCoverProperty ;
            rdf:value "Salt cover refers to the accumulation of salts on the surface of the soil, often visible as a crystalline crust. This phenomenon occurs when capillary action causes soluble salts to move upwards through the soil, where they crystallize as water evaporates. Salt cover can interfere with seed germination, plant growth, and water infiltration, and is commonly found in arid and semi-arid regions with high evaporation rates. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils (14th ed.). Pearson Education."@en ] ;
    skos:exactMatch glosis_su:saltCoverProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salt cover"@en .

eusoilvoc:SaltIncrustation a skos:Concept ;
    skos:broader eusoilvoc:SoilChemicalProcesses ;
    skos:exactMatch spp:SaltIncrustation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salt incrustation"@en .

eusoilvoc:SaltPresence a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Salts ;
    skos:definition [ dcterms:source glosis_su:saltPresenceProperty ;
            rdf:value "The salt presence of soil refers to the concentration of soluble salts, such as sodium, calcium, and magnesium, within the soil profile. High salt levels can lead to soil salinity, negatively affecting plant growth by altering water availability and soil structure. The presence of salts is typically measured using electrical conductivity (EC) or specific ion concentration tests. Soils with high salt presence are often found in arid regions where evaporation exceeds precipitation, leading to salt accumulation at or near the surface. Source: Rhoades, J.D., & Kandiah, A. (1992). Soil Salinity Management in Agriculture. Springer."@en ] ;
    skos:exactMatch glosis_su:saltPresenceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salt presence"@en .

eusoilvoc:SaltSieving a skos:Concept ;
    skos:broader eusoilvoc:SoilPhenomena ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The restriction of salt passage by soil pores when water is forced through the soil, while the pores permit water molecules to pass."@en ] ;
    skos:exactMatch spp:SaltSieving ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salt sieving"@en .

eusoilvoc:SaltThickness a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Salts ;
    skos:definition [ dcterms:source glosis_su:saltThicknessProperty ;
            rdf:value "Salt thickness refers to the depth of the soil profile at which soluble salts are present in significant concentrations. This property is particularly important in regions subject to evaporation and capillary rise, where salts accumulate near the surface or at specific depths. Salt thickness can impact soil fertility and water retention, as the concentrated salts can inhibit root growth and water uptake. This property is commonly determined through soil sampling and electrical conductivity measurements at various depths. Source: United States Salinity Laboratory Staff. (1954). Diagnosis and Improvement of Saline and Alkali Soils. U.S. Department of Agriculture Handbook No. 60."@en ] ;
    skos:exactMatch glosis_su:saltThicknessProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salt thickness"@en .

eusoilvoc:SaturatedHydraulicConductivity a skos:Concept ;
    skos:broader eusoilvoc:SoilHydraulicConductivity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ability of a porous soil medium to conduct water when all its pores are filled with water."@en ] ;
    skos:exactMatch spp:SaturatedHydraulicConductivity,
        nalt:46278,
        she:SaturatedHydraulicConductivity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "saturated hydraulic conductivity"@en .

eusoilvoc:SaturatedVapourPressure a skos:Concept ;
    skos:broader eusoilvoc:SoilVapourPressure ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The pressure of water vapor at saturation, when liquid and vapor are in equilibrium and molecules escape from and condense into the liquid at equal rates."@en ] ;
    skos:exactMatch spp:SaturatedVaporPressure ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "saturated vapour pressure"@en .

eusoilvoc:SaturatedWaterFlow a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterFlow ;
    skos:closeMatch nalt:59559 ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Water flow through soil with constant water content, zero or nearly zero air content, and continuous water-filled flow paths."@en ] ;
    skos:exactMatch spp:SaturatedWaterFlow ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "saturated water flow"@en .

eusoilvoc:SchistSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_6845 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "schist soils"@en .

eusoilvoc:ScrublandSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_6886,
        nalt:35699 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "scrubland soils"@en .

eusoilvoc:Season a skos:Concept ;
    skos:broader eusoilvoc:PlanetaryPhenomena ;
    skos:exactMatch spp:Season,
        inrae:c_11384,
        gemet:7529 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "season"@en .

eusoilvoc:SecondaryTillage a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_330784 ;
            rdf:value "Secondary tillage produces finer soil and sometimes shapes the rows, preparing the seed bed. It also provides weed control throughout the growing season during the maturation of the crop plants, unless such weed control is instead achieved with low-till or no-till methods involving herbicides."@en ] ;
    skos:exactMatch agrovoc:c_330784 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "secondary tillage"@en .

eusoilvoc:SeedlingEmergence a skos:Concept ;
    skos:broader eusoilvoc:SoilBiologicalProcesses ;
    skos:exactMatch agrovoc:c_2547,
        spp:SeedlingEmergence,
        inrae:c_8199,
        iso11074:3.434,
        nalt:36845 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "seedling emergence"@en .

eusoilvoc:SemiAridSoils a skos:Concept ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:closeMatch nalt:26887 ;
    skos:exactMatch agrovoc:c_14192 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "semi-arid soils"@en .

