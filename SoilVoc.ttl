eusoilvoc:SolonchaksWRB a skos:Concept ;
    skos:broader eusoilvoc:SalineSoils,
        eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_7231 ;
            rdf:value "Solonchaks have a high concentration of soluble salts at some time in the year. Solonchaks are largely confined to the arid and semi-arid climate zones and to coastal regions in all climates. Common international names are Saline soils and Salt-affected soils. In national soil classification systems many Solonchaks belong to Halomorphic soils (Russia), Halosols (China) and Salids (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_7231 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Solonchaks"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:SpodicHorizons a skos:Concept ;
    skos:broader eusoilvoc:DiagnosticHorizons,
        eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_6843b260 ;
            rdf:value "The spodic horizon (from Gr. spodos, wood ash) is a dark coloured subsurface horizon which contains illuvial amorphous substances composed of organic matter and aluminium, with or without iron. "@en ] ;
    skos:exactMatch agrovoc:c_6843b260,
        nalt:63390 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "spodic horizons"@en .

eusoilvoc:Subsoil a skos:Concept ;
    skos:broader eusoilvoc:Soil,
        eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source agrovoc:c_7486 ;
            rdf:value "A collective and general term for the layers of soil below the uppermost layer or topsoil. It can consist of sand, silt and clay but has little, if any, humus or other organic matter. Subsoil provides structure, holds moisture, and is a good foothold for rooting plants."@en ] ;
    skos:exactMatch agrovoc:c_7486,
        inrae:c_11573,
        gemet:8167,
        nalt:63414,
        she:Subsoil ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "subsoil"@en .

eusoilvoc:Subsoiling a skos:Concept ;
    skos:broader eusoilvoc:DeepTillage,
        eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_15593 ;
            rdf:value "Tillage of the subsoil or soil pan below the normal plough depth."@en ] ;
    skos:exactMatch agrovoc:c_15593,
        nalt:31941 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "subsoiling"@en .

eusoilvoc:SubsurfaceDrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:definition [ dcterms:source agrovoc:c_25349 ;
            rdf:value "The removal of excess water and salts from soils via groundwater flow to the drains, so that the watertable and rootzone salinity are controlled."@en ] ;
    skos:exactMatch agrovoc:c_25349,
        inrae:c_11463,
        nalt:34483 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:TileDrainage ;
    skos:prefLabel "subsurface drainage"@en .

eusoilvoc:TileDrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage,
        eusoilvoc:SubsurfaceDrainage ;
    skos:definition [ dcterms:source agrovoc:c_25598 ;
            rdf:value "Tile drainage is a form of agricultural drainage system that removes excess sub-surface water from fields to allow sufficient air space within the soil, proper cultivation, and access by heavy machinery to tend and harvest crops. The phrase \"tile drainage\" derives from its original composition from ceramic tiles of fired clay, which were similar to terracotta pipes yet not always shaped as pipes."@en ] ;
    skos:exactMatch agrovoc:c_25598,
        nalt:34494 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "tile drainage"@en .

