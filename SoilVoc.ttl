    skos:broader eusoilvoc:SoilManagement ;
    skos:exactMatch spp:FertilizerUse ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fertiliser use"@en .

eusoilvoc:FineSilt a skos:Concept ;
    skos:broader eusoilvoc:SoilTexture ;
    skos:definition [ dcterms:source agrovoc:c_0f15e6e6 ;
            rdf:value "Content of mineral particles with sizes between 2-6.3µm in soil. Note: According to different national and international particle-size classification systems, size classes may differ slightly. "@en ] ;
    skos:exactMatch agrovoc:c_0f15e6e6 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fine silt"@en .

eusoilvoc:FineSoil a skos:Concept ;
    skos:broader eusoilvoc:Soil ;
    skos:definition [ dcterms:source agrovoc:c_5749f32e ;
            rdf:value "Fine soil comprises all soilid compartments smaller than 2 mm."@en ] ;
    skos:exactMatch agrovoc:c_5749f32e ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fine soil"@en .

eusoilvoc:FloodDuration a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Floods ;
    skos:definition [ dcterms:source glosis_sp:floodDurationProperty ;
            rdf:value "Flood Duration refers to the length of time during which an area is inundated by floodwaters. The duration of flooding can significantly affect soil structure, nutrient availability, and plant growth, especially in flood-prone regions. Source: USGS, 'Floodplain Management'"@en ] ;
    skos:exactMatch glosis_sp:floodDurationProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "flood duration"@en .

eusoilvoc:FloodFrequency a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Floods ;
    skos:definition [ dcterms:source glosis_sp:floodFrequencyProperty ;
            rdf:value "Flood Frequency refers to how often flooding occurs in a particular area, typically expressed in terms of recurrence intervals (e.g., once every 10 years). This property is vital for assessing flood risk, soil erosion, and the potential for soil nutrient loss due to repeated flooding events. Source: USGS, 'Floodplain Management'"@en ] ;
    skos:exactMatch glosis_sp:floodFrequencyProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "flood frequency"@en .

eusoilvoc:FluvisolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils developed from recent alluvial deposits, having no diagnostic horizons other than (unless buried by 50 cm or more new material) an ochric or an umbric A horizon, an H horizon, or a sulfuric horizon."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Fluvisols"@en .

eusoilvoc:FluvisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:exactMatch agrovoc:c_3000 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Fluvisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:FluxControlledWaterInfiltration a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterInfiltration ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Water infiltration in which the water-supply rate determines the infiltration rate because water is applied more slowly than the soil's instantaneous infiltration rate."@en ] ;
    skos:exactMatch spp:FluxControlledWaterInfiltration ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "flux controlled water infiltration"@en .

eusoilvoc:Fog a skos:Concept ;
    skos:broader eusoilvoc:Precipitation ;
    skos:exactMatch agrovoc:c_3007,
        spp:Fog,
        gemet:3347 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fog"@en .

eusoilvoc:FoodProduction a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctions ;
    skos:exactMatch agrovoc:c_3025,
        inrae:c_2879,
        nalt:40879,
        she:FoodProduction ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "food production"@en .

eusoilvoc:ForestSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_3051 ;
            rdf:value "Forest soils, where soil formation has been influenced by forest vegetation, are generally characterized by deeply rooted trees, significant ‘litter layers’ or O horizons, recycling of organic matter and nutrients, including wood, and wide varieties of soil-dwelling organisms."@en ] ;
    skos:exactMatch agrovoc:c_3051,
        nalt:35691,
        she:ForestSoils ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "forest soils"@en .

eusoilvoc:FoundationStability a skos:Concept ;
    skos:broader eusoilvoc:SoilEngineeringFunctions ;
    skos:exactMatch spp:FoundationStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "foundation stability"@en .

eusoilvoc:FoundationStrength a skos:Concept ;
    skos:broader eusoilvoc:SoilEngineeringFunctions ;
    skos:exactMatch spp:FoundationStrength ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "foundation strength"@en .

eusoilvoc:FragmentClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_lh:fragmentsClassProperty ;
            rdf:value "The Fragments Class categorizes the size, shape, and quantity of coarse fragments (e.g., gravel, stones) present in the soil. These fragments affect soil porosity, water retention, and root penetration. The classification includes gravelly, stony, or bouldery soils. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:fragmentsClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fragment class"@en .

eusoilvoc:FragmentCover a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Fragments ;
    skos:definition [ dcterms:source glosis_cm:fragmentCoverProperty ;
            rdf:value "The Fragment Cover describes the proportion of the soil surface covered by coarse fragments such as rocks, stones, or other large particles. This property is important because a high fragment cover can reduce soil erosion but may also interfere with water infiltration and root growth. Fragment cover is often used as an indicator of soil stability and erosion potential. Source: FAO (2006). Guidelines for Soil Description (4th ed.). Food and Agriculture Organization of the United Nations."@en ] ;
    skos:exactMatch glosis_cm:fragmentCoverProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fragment cover"@en .

eusoilvoc:FragmentSize a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Fragments ;
    skos:definition [ dcterms:source glosis_cm:fragmentsSizeProperty ;
            rdf:value "The Fragment Size refers to the dimensions of rock or mineral fragments present in the soil. These fragments are categorized based on their size, ranging from small gravel particles to larger stones and boulders. Larger fragments tend to reduce soil fertility, inhibit root growth, and decrease water retention. Smaller fragments, in contrast, contribute to soil texture and permeability. Source: Soil Science Society of America. (2008). Soil Science Glossary. Soil Science Society of America."@en ] ;
    skos:exactMatch glosis_cm:fragmentsSizeProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fragment size"@en .

eusoilvoc:FriableConsistence a skos:Concept ;
    skos:broader eusoilvoc:SoilConsistence ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The condition of a soil that easily crumbles into granules or crumbs."@en ] ;
    skos:exactMatch spp:FriableConsistence ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "friable consistence"@en .

eusoilvoc:FrigidSoils a skos:Concept ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_3108,
        nalt:301420 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "frigid soils"@en .

eusoilvoc:FrostHeave a skos:Concept ;
    skos:broader eusoilvoc:SoilMovement ;
    skos:definition [ dcterms:source agrovoc:c_8cbca199 ;
            rdf:value "Frost heaving (or a frost heave) is an upwards swelling of soil during freezing conditions caused by an increasing presence of ice as it grows towards the surface, upwards from the depth in the soil where freezing temperatures have penetrated into the soil (the freezing front or freezing boundary)."@en ] ;
    skos:exactMatch agrovoc:c_8cbca199,
        nalt:41621,
        she:FrostHeave ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "frost heave"@en .

eusoilvoc:GasTurbation a skos:Concept ;
    skos:broader eusoilvoc:Pedoturbation ;
    skos:definition [ dcterms:source agrovoc:c_b09277cb ;
            rdf:value "The mixing of soil or sediment from the generation of methane gas as organic matter decomposes or the overturn and dispersion of sediments during venting of gases and fluids."@en ] ;
    skos:exactMatch agrovoc:c_b09277cb ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gas turbation"@en .

eusoilvoc:GaseousNitrogen a skos:Concept ;
    skos:broader eusoilvoc:NitrogenTotal ;
    skos:definition [ dcterms:source agrovoc:c_c696e530 ;
            rdf:value "Gaseous nitrogen is the gaseous fraction of the total nitrogen content in soils. Gaseous nitrogen is also used as a protective atmosphere to prevent oxidation of metals, foods and oxygen-sensitive chemicals."@en ] ;
    skos:exactMatch agrovoc:c_c696e530 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gaseous nitrogen"@en .

eusoilvoc:GelisolsUSDA a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationUSDA ;
    skos:definition [ dcterms:source agrovoc:c_44ac37ac ;
            rdf:value "Gelisols, one of the 12 soil orders in the U.S. Soil Taxonomy, are characterized by permafrost conditions."@en ] ;
    skos:exactMatch agrovoc:c_44ac37ac,
        nalt:42526 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Gelisols"@en ;
    skos:scopeNote "USDA Soil Taxonomy order. This concept is separate from any similarly named FAO-UNESCO or WRB group; definitions are not transferred between systems."@en .

eusoilvoc:GeometricMeanDiametre a skos:Concept ;
    skos:broader eusoilvoc:SoilAggregationIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An aggregate-size index calculated as GMD = exp[sum(wi log xi) / sum(wi)], where xi is the mean diameter of a size class and wi is the aggregate mass in that class."@en ] ;
    skos:exactMatch spp:GeometricMeanDiameter ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "geometric mean diametre"@en .

eusoilvoc:GlacialTillSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3269,
        nalt:42999 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "glacial till soils"@en .

eusoilvoc:GleysolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils showing hydromorphic properties within 50 cm of the surface; having no diagnostic horizons other than (unless buried by 50 cm or more new material) an A horizon, an H horizon, a cambic B horizon, a calcic or a gypsic horizon."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Gleysols"@en .

eusoilvoc:GleysolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_3276 ;
            rdf:value "Gleysols comprise soils saturated with groundwater for long enough periods to develop reducing conditions resulting in gleyic properties, including underwater and tidal soils. This pattern is essentially made up of reddish, brownish or yellowish colours at aggregate surfaces and/or in the upper soil layers, in combination with greyish/bluish colours inside the aggregates and/or deeper in the soil. Many underwater soils have only the latter. Gleysols with a thionic horizon or hypersulfidic material (acid sulfate soils) are common. Redox processes may also be caused by upmoving gases, like CO2 or CH4. Common names for many Gleysols are Gley (former Soviet Union), Gleyzems (Russia), Gleye, Marschen, Watten and Unterwasserböden (Germany), Gleissolos (Brazil) and Hydrosols (Australia). In the United States of America many Gleysols belong to Aquic Suborders and Endoaquic Great Groups of various Orders (Aqualfs, Aquents, Aquepts, Aquolls, etc.) or to the Wassents."@en ] ;
    skos:exactMatch agrovoc:c_3276 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Gleysols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:GraniteSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3356,
        nalt:43655 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "granite soils"@en .

eusoilvoc:Grasses a skos:Concept ;
    skos:altLabel "grass"@en ;
    skos:broader eusoilvoc:Vegetation ;
    skos:exactMatch agrovoc:c_3362,
        spp:Grass,
        nalt:28913 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "grasses"@en .

eusoilvoc:GrasslandSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3365,
        nalt:30686 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "grassland soils"@en .

eusoilvoc:Gravel a skos:Concept ;
    skos:broader eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source agrovoc:c_24850 ;
            rdf:value "Gravel is a mineral granular material which does not stick together when wet and remoulded (i.e., noncohesive) and where the combined weight of 50% of the particles is larger than 4.75mm but smaller than 75mm with less than 15% of material smaller than 75µm."@en ] ;
    skos:exactMatch agrovoc:c_24850,
        inrae:c_11262,
        gemet:3738,
        nalt:43764 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gravel"@en .

eusoilvoc:GravelMulches a skos:Concept ;
    skos:broader eusoilvoc:DryMulches ;
    skos:exactMatch agrovoc:c_11342 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gravel mulches"@en .

eusoilvoc:GreenhouseSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_3378,
        nalt:30687 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "greenhouse soils"@en .

eusoilvoc:GreywackeSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3385 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "greywacke soils"@en .

eusoilvoc:GreyzemsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:exactMatch agrovoc:c_3386,
        nalt:216359 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "greyzems"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:GroundCover a skos:Concept ;
    skos:broader eusoilvoc:LandCover ;
    skos:exactMatch spp:GroundCover,
        inrae:c_3684 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ground cover"@en .

eusoilvoc:GroundwaterDepth a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilWaterPhysicalProperties ;
    skos:definition [ dcterms:source glosis_sp:groundwaterDepthProperty ;
            rdf:value "Groundwater Depth indicates the depth from the soil surface to the water table, which affects soil moisture levels, plant growth, and root penetration. Shallow groundwater can influence soil salinity and nutrient availability, while deep groundwater may limit water access for plants. Source: USDA NRCS, 'Groundwater and Soil'"@en ] ;
    skos:exactMatch glosis_sp:groundwaterDepthProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "groundwater depth"@en .

eusoilvoc:GroundwaterReproduction a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctionIndicators ;
    skos:exactMatch she:GroundwaterReproduction ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "groundwater reproduction"@en .

eusoilvoc:GullyControl a skos:Concept ;
    skos:broader eusoilvoc:ErosionControl ;
    skos:definition [ dcterms:source agrovoc:c_2c35fa5f ;
            rdf:value "Measures to control erosion in gulllies. Minimizing runoff volume and peak runoff rate through improved land use system is essential in gully control. "@en ] ;
    skos:exactMatch agrovoc:c_2c35fa5f ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gully control"@en .

eusoilvoc:GullyErosion a skos:Concept ;
    skos:broader eusoilvoc:WaterErosion ;
    skos:definition [ dcterms:source she:GullyErosion ;
            rdf:value "Gully erosion is a special and very intense form of water erosion in areas with concentrated run-off leading to large gullies as the typical landform."@en ] ;
    skos:exactMatch agrovoc:c_25010,
        inrae:c_11418,
        nalt:44106,
        she:GullyErosion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gully erosion"@en .

eusoilvoc:GypsisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_61704b51 ;
            rdf:value "Gypsisols are soils with substantial accumulation of secondary gypsum (CaSO4·2H2O). These soils are found in the driest parts of the arid climate zone, which explains why leading soil classification systems labelled many of them Desert grey-brown soils (former Soviet Union). The Soil Map of the World (FAO–UNESCO, 1971–1981) accommodates them among Yermosols or Xerosols. In the United States of America most of them belong to the Gypsids."@en ] ;
    skos:exactMatch agrovoc:c_61704b51,
        nalt:216350 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Gypsisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:GypsumContents a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "gypsum content"@en ;
    skos:broader eusoilvoc:Gypsum ;
    skos:definition [ dcterms:source glosis_lh:gypsumContentProperty ;
            rdf:value "The Gypsum Content quantifies the amount of gypsum (calcium sulfate dihydrate) present in the soil. Gypsum affects soil structure, water infiltration, and nutrient availability, especially in arid and semi-arid regions. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:gypsumContentProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gypsum contents"@en .

eusoilvoc:GypsumForms a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "gypsum form"@en ;
    skos:broader eusoilvoc:Gypsum ;
    skos:definition [ dcterms:source glosis_lh:gypsumFormsProperty ;
            rdf:value "The Gypsum Forms describes the morphology of gypsum within the soil, such as crystals, veins, or nodules. The form indicates the processes of soil formation and water movement in gypsum-rich soils. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:gypsumFormsProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gypsum forms"@en .

eusoilvoc:GypsumWeight a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Gypsum ;
    skos:definition [ dcterms:source glosis_lh:gypsumWeightProperty ;
            rdf:value "The Gypsum Weight measures the mass of gypsum in the soil profile. This value helps evaluate the potential for soil salinity issues and influences decisions for agricultural or land reclamation practices. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."@en ] ;
    skos:exactMatch glosis_lh:gypsumWeightProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gypsum weight"@en .

eusoilvoc:HabitatProvisionCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctionIndicators ;
    skos:exactMatch she:HabitatProvisionCapacity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "habitat provision capacity"@en .

eusoilvoc:Habitats a skos:Concept ;
    skos:altLabel "habitat"@en ;
    skos:broader eusoilvoc:SoilFunctions ;
    skos:exactMatch agrovoc:c_3456,
        nalt:11506 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "habitats"@en .

eusoilvoc:Hail a skos:Concept ;
    skos:broader eusoilvoc:Precipitation ;
    skos:exactMatch agrovoc:c_3469,
        spp:Hail,
        inrae:c_11412,
        gemet:3812,
        nalt:44297 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hail"@en .

eusoilvoc:Hardpans a skos:Concept ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_c27ddf24 ;
            rdf:value "A hardened soil layer in the lower A or in the B horizon caused by cementation of soil particles with organic matter or with materials such as silica or calcium carbonate. The hardness does not change appreciably with changes in moisture content, and pieces of the hard layer do not disintegrate in water."@en ] ;
    skos:exactMatch agrovoc:c_c27ddf24,
        nalt:213766 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hardpans"@en .

eusoilvoc:Harrowing a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:exactMatch agrovoc:c_3497,
        nalt:44661 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "harrowing"@en .

eusoilvoc:HarshConsistence a skos:Concept ;
    skos:broader eusoilvoc:SoilConsistence ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The hard, highly cohesive consistence of dry soil that feels harsh to the touch."@en ] ;
    skos:exactMatch spp:HarshConsistence ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "harsh consistence"@en .

eusoilvoc:HarvestingErosion a skos:Concept ;
    skos:broader eusoilvoc:AnthropogenicErosion ;
    skos:definition [ dcterms:source she:HarvestingErosion ;
            rdf:value "Harvesting erosion is offsite losses of soil adhering to the crop during harvest, mainly of root and tuber crops."@en ] ;
    skos:exactMatch she:HarvestingErosion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "harvesting erosion"@en .

eusoilvoc:HeathlandSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3523,
        nalt:35692 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "heathland soils"@en .

eusoilvoc:HillSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_3615 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hill soils"@en .

eusoilvoc:HistosolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Soils having an H horizon of 40 cm or more (60 cm or more if the organic material consists mainly of sphagnum or moss or has a bulk density of less than 0.1) either extending down from the surface or taken cumulatively within the upper 80 cm of the soil; the thickness of the H horizon may be less when it rests on rocks or on fragmental material of which the interstices are filled with organic matter."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Histosols"@en .

eusoilvoc:HistosolsUSDA a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationUSDA ;
    skos:closeMatch nalt:40066 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Histosols"@en ;
    skos:scopeNote "USDA Soil Taxonomy order. This concept is separate from any similarly named FAO-UNESCO or WRB group; definitions are not transferred between systems."@en .

eusoilvoc:HistosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_3636 ;
            rdf:value "Histosols comprise soils formed in organic material accumulating as groundwater peat (fen), rainwater peat (raised bog) or mangroves or without water saturation in cool mountain areas. They vary from soils developed in predominantly moss peat in arctic, subarctic and boreal regions, via moss peat (Sphagnum species), reeds/sedge peat (fen) and forest peat in temperate regions to mangrove peat and swamp forest peat in the humid tropics. Histosols are found at all altitudes, but the vast majority occurs in lowlands. Common names are Peat soils, Muck soils, Bog soils and Organic soils. Many Histosols belong to Moore, Felshumusböden and Skeletthumusböden (Germany), Organosols (Australia), Organossolos (Brazil), Peat soils (Russia), Organic order (Canada) and Histosols and Histels (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_3636 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Histosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:HorticulturalSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_3670,
        nalt:30688 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "horticultural soils"@en .

eusoilvoc:HotWaterExtractableNitrogen a skos:Concept ;
    skos:broader eusoilvoc:NitrogenContent ;
    skos:definition [ dcterms:source agrovoc:c_6ed53459 ;
            rdf:value "Hot water soluble part of total nitrogen of a soil sample which can be used to predict mineralizable N and plant available N in soil"@en ] ;
    skos:exactMatch agrovoc:c_6ed53459 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hot water-extractable nitrogen"@en .

eusoilvoc:HumanInfluenceClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_sp:humanInfluenceClassProperty ;
            rdf:value "Human Influence Class classifies the extent of human impact on a landscape or ecosystem, ranging from minimal disturbance to high levels of modification. This classification helps in understanding the effects of urbanization, agriculture, or industrial activity on soil properties and ecosystem functions. Source: FAO, 'Land Degradation Assessment in Drylands'"@en ] ;
    skos:exactMatch glosis_sp:humanInfluenceClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "human influence class"@en .

eusoilvoc:HydromorphicSoils a skos:Concept ;
    skos:broader eusoilvoc:GeneticSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_25315 ;
            rdf:value "Hydromorphic soils are characterised by the reduction or localised segregation of iron, owing to the temporary or permanent waterlogging of the soil pores which causes a lack of oxygen over a long period."@en ] ;
    skos:exactMatch agrovoc:c_25315,
        nalt:42655 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hydromorphic soils"@en .

eusoilvoc:Illites a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:exactMatch agrovoc:c_15841 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "illites"@en .

eusoilvoc:IlliticSoils a skos:Concept ;
    skos:broader eusoilvoc:MineralogicalSoilTypes ;
    skos:exactMatch agrovoc:c_3797,
        nalt:46933 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "illitic soils"@en .

eusoilvoc:Imogolite a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:definition [ dcterms:source agrovoc:c_15840 ;
            rdf:value "Imogolite is an aluminium silicate clay mineral with the chemical formula Al2SiO3(OH)4. It occurs in soils formed from volcanic ash."@en ] ;
    skos:exactMatch agrovoc:c_15840,
        nalt:26746 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "imogolite"@en .

eusoilvoc:InSituSoilConservation a skos:Concept ;
    skos:broader eusoilvoc:SoilConservation ;
    skos:exactMatch agrovoc:c_330803 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "in situ soil conservation"@en .

eusoilvoc:InceptisolsUSDA a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationUSDA ;
    skos:definition [ dcterms:source agrovoc:c_90831e99 ;
            rdf:value "Inceptisols are soils of semiarid to humid environments that generally exhibit only moderate degrees of soil weathering and development."@en ] ;
    skos:exactMatch agrovoc:c_90831e99,
        nalt:10070 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Inceptisols"@en ;
    skos:scopeNote "USDA Soil Taxonomy order. This concept is separate from any similarly named FAO-UNESCO or WRB group; definitions are not transferred between systems."@en .

eusoilvoc:IndexBasedOnTextureAndCementingAgents a skos:Concept ;
    skos:altLabel "index based on texture and cementing agent"@en ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An instability index for tropical soils calculated as I_s = (A + L_F)_max / (A_g/3 − 0.9S_G). The numerator is the maximum dispersed fraction obtained from an air-dried sample and samples immersed in alcohol or benzene; A_g is the aggregate content obtained after shaking and wet sieving the three treated samples, and S_G is the coarse mineral sand content."@en ] ;
    skos:exactMatch spp:IndexBasedOnTextureAndCementingAgents ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index based on texture and cementing agents"@en .

eusoilvoc:IndexOfCrusting a skos:Concept ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index based on soil texture and organic matter, calculated as Ic = (1.5 Sf + 0.75 Sc) / (Cl + 10 SOM), where Sf, Sc, Cl, and SOM are the percentages of fine silt, coarse silt, clay, and soil organic matter, respectively."@en ] ;
    skos:exactMatch spp:IndexOfCrusting ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of crusting"@en .

eusoilvoc:IndexOfErodibility a skos:Concept ;
    skos:broader eusoilvoc:SoilErodibilityIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil erodibility defined as Ie = 1/(Ir × k), where Ir is the index of resistance and k is permeability."@en ] ;
    skos:exactMatch spp:IndexOfErodibility ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of erodibility"@en .

eusoilvoc:IndexOfResistance a skos:Concept ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of resistance to water erosion calculated as soil bulk density multiplied by the range of particle sizes and divided by soil moisture content."@en ] ;
    skos:exactMatch spp:IndexOfResistance ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of resistance"@en .

eusoilvoc:IndexOfStructuralStability a skos:Concept ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil structural stability based on the rate of change in the concentration of stabilizing material, such as humic fractions or organo-mineral complexes."@en ] ;
    skos:exactMatch spp:IndexOfStructuralStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of structural stability"@en .

eusoilvoc:InfiltrationWater a skos:Concept ;
    skos:broader eusoilvoc:SoilWater ;
    skos:exactMatch agrovoc:c_25321 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "infiltration water"@en .

eusoilvoc:Inputs a skos:Concept ;
    skos:altLabel "input"@en ;
    skos:broader eusoilvoc:ExternalFactors ;
    skos:exactMatch agrovoc:c_11788,
        she:Inputs ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "inputs"@en .

eusoilvoc:IntegratedSoilFertilityManagement a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_8fc04948 ;
            rdf:value "The application of soil fertility management practices and the knowledge to adapt these to local conditions, which optimize fertilizer and organic resource use efficiency and crop productivity."@en ] ;
    skos:exactMatch agrovoc:c_8fc04948 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "integrated soil fertility management"@en .

eusoilvoc:InterAggregatePorosity a skos:Concept ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:exactMatch spp:InterAggregatePorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "inter aggregate porosity"@en .

eusoilvoc:InteraggregatePores a skos:Concept ;
    skos:altLabel "interaggregate pore"@en ;
    skos:broader eusoilvoc:SoilPores ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A pore between soil aggregates that results from the arrangement of structural elements and the characteristics of the aggregates; also called a structural pore."@en ] ;
    skos:exactMatch spp:InteraggregatePore ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "interaggregate pores"@en .

eusoilvoc:Interflow a skos:Concept ;
    skos:broader eusoilvoc:WaterInterchange ;
    skos:closeMatch nalt:43957 ;
    skos:exactMatch spp:Interflow ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "interflow"@en .

eusoilvoc:InterlatticeSwelling a skos:Concept ;
    skos:broader eusoilvoc:SoilSwelling ;
    skos:exactMatch spp:InterlatticeSwelling ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "interlattice swelling"@en .

eusoilvoc:InterparticleSwelling a skos:Concept ;
    skos:broader eusoilvoc:SoilSwelling ;
    skos:exactMatch spp:InterparticleSwelling ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "interparticle swelling"@en .

eusoilvoc:InterrillErosion a skos:Concept ;
    skos:broader eusoilvoc:WaterErosion ;
    skos:closeMatch inrae:c_1551 ;
    skos:exactMatch agrovoc:c_dc754417,
        nalt:47543,
        she:InterrillErosion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "interrill erosion"@en .

eusoilvoc:InterstructuralPores a skos:Concept ;
    skos:altLabel "interstructural pore"@en ;
    skos:broader eusoilvoc:SoilPores ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A soil pore delimited by structural units, generally forming a planar crevice between those units."@en ] ;
    skos:exactMatch spp:InterstructuralPore ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "interstructural pores"@en .

eusoilvoc:IntraAggregatePorosity a skos:Concept ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:exactMatch spp:IntraAggregatePorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "intra aggregate porosity"@en .

eusoilvoc:IntraaggregatePores a skos:Concept ;
    skos:altLabel "intraaggregate pore"@en ;
    skos:broader eusoilvoc:SoilPores ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A pore within a soil aggregate whose characteristics are determined by soil texture and the packing of elementary particles; also called a textural pore."@en ] ;
    skos:exactMatch spp:IntraaggregatePore ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "intraaggregate pores"@en .

eusoilvoc:IntrinsicChargeDensity a skos:Concept ;
    skos:broader eusoilvoc:SoilChargeDensity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The total charge on mineral surfaces arising from structural properties, including isomorphic substitution and other alterations; also called permanent charge."@en ] ;
    skos:exactMatch spp:IntrinsicChargeDensity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "intrinsic charge density"@en .

eusoilvoc:IonTransportInSoil a skos:Concept ;
    skos:broader eusoilvoc:SoilTransport ;
    skos:exactMatch agrovoc:c_25019,
        inrae:c_638 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ion transport in soil"@en .

eusoilvoc:IrrigatedSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_3953,
        nalt:30689 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "irrigated soils"@en .

eusoilvoc:Irrigation a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:exactMatch agrovoc:c_3954,
        spp:Irrigation,
        inrae:c_3899,
        gemet:4505,
        nalt:24709 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "irrigation"@en .

eusoilvoc:Kaolinite a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:exactMatch agrovoc:c_16135,
        inrae:c_947,
        nalt:26748 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "kaolinite"@en .

eusoilvoc:KarstSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:closeMatch nalt:48289 ;
    skos:exactMatch agrovoc:c_34036 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "karst soils"@en .

eusoilvoc:KastanozemsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils having a mollic A horizon with a moist chroma of more than 2 to a depth of at least 15 cm. having one or more of the following: a calcic or gypsic horizon, or concentrations of soft powdery lime within 125 cm of the surface when the weighted average textural class is coarse, within 90 cm for medium textures, within 75 cm for fine textures."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Kastanozems"@en .

eusoilvoc:KastanozemsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_4079 ;
            rdf:value "Kastanozems accommodate dry grassland soils, among them the soils of the short-grass steppe belt, south of the Eurasian tall-grass steppe belt with Chernozems. Kastanozems have a similar profile to that of Chernozems but the humus-rich surface horizon is thinner and not as dark as that of the Chernozems, and they show more prominent accumulation of secondary carbonates. The chestnut-brown colour of the surface soil is reflected in the name Kastanozem. Common names for many Kastanozems are (Dark) Chestnut soils (Russia), Kalktschernoseme (Germany), (Dark) Brown soils (Canada), Ustolls and Xerolls (United States of America) and Chernossolos (Brazil)."@en ] ;
    skos:exactMatch agrovoc:c_4079 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Kastanozems"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:KoeppenClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_sp:koeppenClassProperty ;
            rdf:value "Koeppen Class refers to the classification of climate zones based on temperature and precipitation patterns, as defined by the Köppen climate classification system. This classification directly influences soil temperature, moisture content, and vegetation types, which in turn affect soil formation and properties. Source: Köppen, W., 'Geiger's Climate Maps'"@en ] ;
    skos:exactMatch glosis_sp:koeppenClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "koeppen class"@en .

eusoilvoc:LabileSolutes a skos:Concept ;
    skos:altLabel "labile solute"@en ;
    skos:broader eusoilvoc:NonconservativeSolutes ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A solute that can undergo reversible or irreversible physicochemical, biochemical, or microbial reactions and can change its physical or chemical phase over time."@en ] ;
    skos:exactMatch spp:LabileSolute ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "labile solutes"@en .

eusoilvoc:LandRehabilitation a skos:Concept ;
    skos:broader eusoilvoc:SoilImprovement ;
    skos:closeMatch nalt:35688 ;
    skos:definition [ dcterms:source agrovoc:c_33534 ;
            rdf:value "Land rehabilitation is an action to restore land already degraded to such an extent that the original use is no longer possible and the land has become practically unproductive."@en ] ;
    skos:exactMatch agrovoc:c_33534 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land rehabilitation"@en .

eusoilvoc:LandTake a skos:Concept ;
    skos:broader eusoilvoc:SoilAnthropogenicChanges ;
    skos:definition [ dcterms:source agrovoc:c_03e78242 ;
            rdf:value "Land take entails the conversion of land to artificial surfaces, which impairs the valuable ecological functions of lands."@en ] ;
    skos:exactMatch agrovoc:c_03e78242,
        she:LandTake ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land take"@en .

eusoilvoc:LandUseBareCover a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:LandUse ;
    skos:definition [ dcterms:source glosis_sp:bareCoverAbundanceProperty ;
            rdf:value "Bare Cover Abundance refers to the extent of land area without vegetation or artificial cover, such as bare soil or rocky surfaces. High proportions of bare cover increase the risk of soil erosion and desertification, particularly in areas with poor vegetation or human disturbance. Source: FAO, 'Land Use and Land Cover Classification'"@en ] ;
    skos:exactMatch glosis_sp:bareCoverAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land use bare cover"@en .

eusoilvoc:LandUseClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_sp:landUseClassProperty ;
            rdf:value "Land Use Class refers to the classification of land based on its primary use, such as agricultural, industrial, urban, or natural areas. This property helps assess the impact of land management practices on soil quality, including erosion risks, compaction, and fertility, and is critical for sustainable land-use planning. Source: FAO, 'Land Use and Land Cover Classification'"@en ] ;
    skos:exactMatch glosis_sp:landUseClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land use class"@en .

eusoilvoc:LandUseForests a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "land use forest"@en ;
    skos:broader eusoilvoc:LandUse ;
    skos:definition [ dcterms:source glosis_sp:forestAbundanceProperty ;
            rdf:value "Forest Abundance refers to the proportion or extent of land covered by forest vegetation in a given area. It is often quantified as the percentage of land area dominated by tree species, reflecting the ecological importance of forests in influencing soil fertility, moisture retention, and biodiversity. Forested areas typically contribute to soil formation and stabilization through leaf litter and root systems that reduce erosion. Source: FAO, 'Forest Resources Assessment'"@en ] ;
    skos:exactMatch glosis_sp:forestAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land use forests"@en .

eusoilvoc:LandUseGrasses a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "land use grass"@en ;
    skos:broader eusoilvoc:LandUse ;
    skos:definition [ dcterms:source glosis_sp:grassAbundanceProperty ;
            rdf:value "Grass Abundance indicates the extent or percentage of land covered by grasses or herbaceous plants. This property is important for understanding land productivity, grazing capacity, and soil health, as grasses play a key role in preventing soil erosion, enhancing organic matter content, and maintaining soil structure. Source: FAO, 'Grassland Ecosystems and Management'"@en ] ;
    skos:exactMatch glosis_sp:grassAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land use grasses"@en .

eusoilvoc:LandUseShrubs a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "land use shrub"@en ;
    skos:broader eusoilvoc:LandUse ;
    skos:definition [ dcterms:source glosis_sp:shrubsAbundanceProperty ;
            rdf:value "Shrubs Abundance refers to the extent or abundance of shrub vegetation in a given area. Shrubs influence soil structure by reducing erosion, improving soil organic matter through leaf litter, and enhancing nutrient cycling. They are also indicators of ecosystem health in many terrestrial environments. Source: FAO, 'Vegetation and Land Use in Arid Zones'"@en ] ;
    skos:exactMatch glosis_sp:shrubsAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land use shrubs"@en .

eusoilvoc:LandformComplex a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Physiography ;
    skos:definition [ dcterms:source glosis_sp:landformComplexProperty ;
            rdf:value "Landform Complex describes a region with multiple interrelated landforms such as ridges, valleys, and hills. This property is essential for understanding how diverse landforms within a landscape influence soil distribution, water flow, and erosion patterns, ultimately affecting soil management strategies. Source: FAO, 'Soil Formation and Classification'"@en ] ;
    skos:exactMatch glosis_sp:landformComplexProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "landform complex"@en .

