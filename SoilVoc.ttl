eusoilvoc:PlantAvailableWater a skos:Concept ;
    skos:broader eusoilvoc:SoilWater ;
    skos:definition [ dcterms:source agrovoc:c_31e02b4d ;
            rdf:value "The portion of water in a soil that can be absorbed by plant roots, that is, water held at a tension of less than 1500 kPa in the soil."@en ] ;
    skos:exactMatch agrovoc:c_31e02b4d,
        nalt:14083 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plant available water"@en .

