eusoilvoc:BulkDensityWholeSoil a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilBulkDensity ;
    skos:definition [ dcterms:source glosis_cl:physioChemicalPropertyCode-BulDwhole ;
            rdf:value "Bulk density measures the mass of soil per unit volume, including both solids and pore spaces. It is a critical parameter for assessing soil compaction, porosity, and water infiltration capacity. High bulk density often indicates poor aeration and root penetration, while low values are associated with high organic matter content and good structure. Source: USDA NRCS."@en ] ;
    skos:exactMatch glosis_cl:physioChemicalPropertyCode-BulDwhole ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bulk density whole soil"@en ;
