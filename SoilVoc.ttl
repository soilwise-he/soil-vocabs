        she:PollutedSoils ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polluted soils"@en .

eusoilvoc:PolychlorinatedBiphenyls a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_24066 ;
            rdf:value "PCB are toxic and can cause serious health effects in humans and animals, including reproductive impairment and immune system dysfunctions. Once in the environment, PCB enter the food chain. PCBs are toxic to wildlife, including fish, killing them at higher doses and causing spawning failures at lower doses."@en ] ;
    skos:exactMatch agrovoc:c_24066,
        nalt:25342,
        she:PCBs ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polychlorinated biphenyls"@en .

eusoilvoc:PolycyclicAromaticHydrocarbons a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_331394 ;
            rdf:value "A class of chemicals that result from burning coal, oil, gas, wood, garbage, or tobacco. They bind to or form small particles in the air. High heat when cooking meat and other foods will also form PAHs."@en ] ;
    skos:exactMatch agrovoc:c_331394,
        nalt:12311,
        she:PAHs ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polycyclic aromatic hydrocarbons"@en .

eusoilvoc:PolygeneticSoilTypes a skos:Concept ;
    skos:broader eusoilvoc:SoilTypes ;
    skos:exactMatch agrovoc:c_6083 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polygenetic soil types"@en .

eusoilvoc:PoreAbundance a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "pores abundance"@en ;
    skos:broader eusoilvoc:SoilPores ;
    skos:definition [ dcterms:source glosis_lh:poresAbundanceProperty ;
            rdf:value "The Pores Abundance describes the quantity of soil pores, ranging from few to many. It influences water infiltration, root growth, and soil aeration. Pore abundance is crucial for assessing soil health and productivity. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:poresAbundanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "pore abundance"@en .

eusoilvoc:PorosityClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_lh:porosityClassProperty ;
            rdf:value "The Porosity Class classifies soil by the proportion of pore spaces, typically expressed as a percentage. Classes include high, medium, or low porosity, influencing water and air movement in the soil. Source: Soil Science Society of America (SSSA) Glossary."@en ] ;
    skos:exactMatch glosis_lh:porosityClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "porosity class"@en .

