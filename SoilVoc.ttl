eusoilvoc:LivestockTramplingErosion a skos:Concept ;
    skos:broader eusoilvoc:AnthropogenicErosion ;
    skos:definition [ dcterms:source she:LivestockTramplingErosion ;
            rdf:value "Erosion caused by livestock trampling is onsite soil loss occurring after soil compaction, overgrazing and removal or reduction of vegetation cover."@en ] ;
    skos:exactMatch she:LivestockTramplingErosion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "livestock trampling erosion"@en .

eusoilvoc:LixisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_7283bd0a ;
            rdf:value "Lixisols have a higher clay content in the subsoil than in the topsoil, as a result of pedogenetic processes (especially clay migration) leading to an argic subsoil horizon. Lixisols have low-activity clays in the argic horizon and a high base saturation in the 50–100 cm depth. Many Lixisols are included in Red yellow podzolic soils (e.g. Indonesia), Chromosols (Australia), Argissolos (Brazil), Sols ferralitiques faiblement desaturés appauvris (France) and Alfisols with low-activity clays (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_7283bd0a,
        nalt:216355,
        she:Lixisols ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Lixisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:LoamSoils a skos:Concept ;
    skos:broader eusoilvoc:TexturalSoilTypes ;
    skos:exactMatch agrovoc:c_4408,
        nalt:50479 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "loam soils"@en .

