eusoilvoc:MeanWeightDiametre a skos:Concept ;
    skos:broader eusoilvoc:SoilAggregationIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The sum of the mean diameter of each aggregate-size fraction multiplied by that fraction’s proportion of the total sample mass: MWD = sum(xi wi)."@en ] ;
    skos:exactMatch spp:MeanWeightDiameter ;
