    skos:broader eusoilvoc:SoilPhysicalProcesses ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A change in the shape or arrangement of soil under applied stress as its solid particles separate and move relative to one another; the change may be recoverable or permanent."@en ] ;
    skos:exactMatch spp:SoilDeformation,
        she:SoilDeformation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:SoilCollapsing,
