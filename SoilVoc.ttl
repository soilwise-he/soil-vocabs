    skos:exactMatch agrovoc:c_12965 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "organic amendments"@en .

eusoilvoc:OrganicHorizons a skos:Concept ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_a4326722 ;
            rdf:value "This layer generally forms above the mineral soil or occurs in an organic soil profile. The \"O\" stands for organic matter."@en ] ;
    skos:exactMatch agrovoc:c_a4326722,
        nalt:55521,
        she:OrganicHorizons ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "organic horizons"@en .

