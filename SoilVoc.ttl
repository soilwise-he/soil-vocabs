    skos:broader eusoilvoc:SoilPores ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A generally small textural pore formed by the packing of primary soil particles."@en ] ;
    skos:exactMatch spp:MatrixPore ;
