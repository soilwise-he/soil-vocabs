        eusoilvoc:SoilProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The repulsion of water by soil particles."@en ],
        [ dcterms:source agrovoc:c_ad6278b9 ;
            rdf:value "Soil water repellency is a reduction in the rate of wetting and retention of water in soil caused by the presence of hydrophobic coatings on soil particles."@en ] ;
    skos:exactMatch agrovoc:c_ad6278b9,
