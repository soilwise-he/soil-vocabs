eusoilvoc:NitrogenTotal a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Nitrogen,
        eusoilvoc:NitrogenContent ;
    skos:definition [ dcterms:source glosis_cl:physioChemicalPropertyCode-Nittot ;
            rdf:value "Total nitrogen encompasses all nitrogen forms in soil, including organic nitrogen in humus and inorganic nitrogen such as ammonium (NH₄⁺) and nitrate (NO₃⁻). Nitrogen is essential for plant growth, being a vital component of amino acids, proteins, and chlorophyll. Total nitrogen is a key indicator of soil fertility and its capacity to sustain long-term crop productivity. Source: Brady & Weil (2017)."@en ],
        [ dcterms:source agrovoc:c_bdc779f4 ;
            rdf:value "Content or amount of total nitrogen in soil."@en ] ;
    skos:exactMatch agrovoc:c_bdc779f4,
        glosis_cl:physioChemicalPropertyCode-Nittot ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:GaseousNitrogen ;
    skos:prefLabel "nitrogen total"@en ;
    sosa:hasProcedure eusoilvoc:nitrogenTotalProcedure-TotalN_bremner,
