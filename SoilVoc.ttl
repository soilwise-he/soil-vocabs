    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The total volume of a soil quantity, comprising the volumes of its solid, liquid and gaseous components; the solid volume includes inorganic and organic components."@en ] ;
    skos:exactMatch spp:SoilVolume ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil volume"@en .

