    skos:broader eusoilvoc:SoilAbsorption ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Uptake of water by soil colloids, described as hydration at exchange sites and exchangeable cations, followed by growth of water films and capillary condensation as relative vapor pressure rises."@en ] ;
    skos:exactMatch spp:SoilWaterAbsorption ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water absorption"@en .

eusoilvoc:SoilWaterAdsorption a skos:Concept ;
    skos:broader eusoilvoc:SoilAdsorption ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Attachment of water molecules to clay surfaces, where they may be held by hydrogen bonding or electrostatic attraction; the water so held is termed adsorbed water."@en ] ;
    skos:exactMatch spp:SoilWaterAdsorption ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water adsorption"@en .

eusoilvoc:SoilWaterAffinity a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterPhysicalProperties ;
    skos:exactMatch spp:SoilWaterAffinity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water affinity"@en .

eusoilvoc:SoilWaterCondensation a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterPhysicalProcesses ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The conversion of water vapor to liquid water in the soil system."@en ] ;
    skos:exactMatch spp:SoilWaterCondensation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water condensation"@en .

eusoilvoc:SoilWaterConductivity a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterPhysicalProperties ;
    skos:exactMatch spp:SoilWaterConductivity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water conductivity"@en .

eusoilvoc:SoilWaterDiffusivity a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The soil-water transport coefficient tabulated as Dθ = Kθ(dΦm/dθ), with dimensions of area per time."@en ] ;
    skos:exactMatch spp:SoilWaterDiffusivity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water diffusivity"@en .

eusoilvoc:SoilWaterEvapourationRate a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterTransmissionIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The rate at which water is lost from soil by evaporation, expressed as water depth per unit time; in the book’s modeled profile of depth L, it is expressed as e = -L ∂θ/∂t, where θ is soil water content and t is time."@en ] ;
    skos:exactMatch spp:SoilWaterEvaporationRate ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water evapouration rate"@en .

eusoilvoc:SoilWaterFiltration a skos:Concept ;
    skos:broader eusoilvoc:WaterPurification ;
    skos:definition [ dcterms:source agrovoc:c_25b98c3e ;
            rdf:value "Depending on soil properties, infiltrated precipitation water is partitioned into storage and groundwater recharge. Solutes and particles moving through soil have to pass the extensive inner surfaces of soil constituents where they might be sorbed or transformed. Hence, soils are also important to filter harmful substances, originating from industrial and agricultural production, municipal activities, or atmospheric deposits."@en ] ;
    skos:exactMatch agrovoc:c_25b98c3e ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "water filtration (soil)"@en .

eusoilvoc:SoilWaterInfiltrationRateClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_cm:infiltrationRateClassProperty ;
            rdf:value "The Soil Water Infiltration Rate Class classifies the soil’s ability to absorb water based on observed infiltration rates. This classification is typically divided into categories like slow, moderate, or rapid infiltration, based on how quickly water is absorbed into the soil. It is an essential property for understanding drainage, runoff, and irrigation needs. Source: Hillel, D. (2004). Introduction to Soil Physics. Academic Press."@en ] ;
    skos:exactMatch glosis_cm:infiltrationRateClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water infiltration rate class"@en .

eusoilvoc:SoilWaterInfiltrationRateNumeric a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilWaterInfiltrationRate ;
    skos:definition [ dcterms:source glosis_cm:infiltrationRateNumericProperty ;
            rdf:value "The Soil Water Infiltration Rate Numeric provides a quantitative measure of the rate at which water enters the soil, usually expressed in units such as millimeters per hour (mm/h). This numeric value is essential for determining soil permeability, irrigation management, and runoff prediction. Higher infiltration rates indicate well-drained soils, while lower rates suggest compacted or clay-rich soils. Source: Bouwer, H. (2000). Integrated Water Management for the 21st Century. Water Resources Research."@en ] ;
    skos:exactMatch glosis_cm:infiltrationRateNumericProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water infiltration rate numeric"@en .

eusoilvoc:SoilWaterLoss a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterPhysicalProcesses ;
    skos:exactMatch spp:SoilWaterLoss ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water loss"@en .

eusoilvoc:SoilWaterRetentionCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalCapacity ;
    skos:exactMatch spp:SoilWaterRetentionCapacity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water retention capacity"@en .

eusoilvoc:SoilWaterSorptionProperties a skos:Concept ;
    skos:altLabel "soil water sorption property"@en ;
    skos:broader eusoilvoc:SoilWaterPhysicalProperties ;
    skos:exactMatch spp:SoilWaterSorptionProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water sorption properties"@en .

eusoilvoc:SoilWaterStorage a skos:Concept ;
    skos:broader eusoilvoc:SoilRetention ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The quantity of water contained in soil as a reservoir; change in this storage is the balance of precipitation and irrigation inputs against surface runoff, deep drainage and evapotranspiration losses."@en ] ;
    skos:exactMatch spp:SoilWaterStorage,
        nalt:63464 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water storage"@en .

eusoilvoc:SoilWaterTableDepth a skos:Concept ;
    skos:broader eusoilvoc:SoilSpatialProperties ;
    skos:exactMatch spp:SoilWaterTableDepth ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water table depth"@en .

eusoilvoc:SoilWaterTablePosition a skos:Concept ;
    skos:broader eusoilvoc:SoilSpatialProperties ;
    skos:exactMatch spp:SoilWaterTablePosition ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water table position"@en .

eusoilvoc:SoilWaterTransport a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterMovement ;
    skos:closeMatch nalt:47524 ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Movement of water through the porous soil matrix, driven under isothermal conditions by differences in potential energy from a region of greater potential toward one of smaller potential."@en ] ;
    skos:exactMatch spp:SoilWaterTransport ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water transport"@en .

eusoilvoc:SoilWetness a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterPhysicalProperties ;
    skos:exactMatch spp:SoilWetness ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil wetness"@en .

eusoilvoc:SoilZonation a skos:Concept ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:exactMatch agrovoc:c_7213 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil zonation"@en .

eusoilvoc:Solifluction a skos:Concept ;
    skos:broader eusoilvoc:SoilMovement ;
    skos:definition [ dcterms:source agrovoc:c_14420 ;
            rdf:value "Solifluction is a collective name for gradual mass wasting slope processes related to freeze-thaw activity."@en ] ;
    skos:exactMatch agrovoc:c_14420,
        nalt:51610 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "solifluction"@en .

eusoilvoc:SolonchaksFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils having high salinity and having no diagnostic horizons other than (unless buried by 50 cm or more new material) an A horizon, an H horizon, a cambic B horizon, a calcic or a gypsic horizon"@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Solonchaks"@en .

eusoilvoc:SolonetzFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils having a natric B horizon."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Solonetz"@en .

eusoilvoc:SolonetzWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_7232 ;
            rdf:value "Solonetz have a dense, strongly structured, clayey subsurface horizon that has a high proportion of adsorbed Na and in some cases also Mg ions. Solonetz that contain free soda (Na2CO3) are strongly alkaline (field pH > 8.5). Common international names are Alkali soils and Sodic soils. In national soil classification systems many Solonetz correlate with Sodosols (Australia), the Solonetzic Order (Canada) and Solonetz (Russia). In the United States of America, they belong to the Natric Great Groups of several Orders."@en ] ;
    skos:exactMatch agrovoc:c_7232 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Solonetz"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:SolubleAnionTotal a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "soluble anions total"@en ;
    skos:broader eusoilvoc:SoilSolutes ;
    skos:definition [ dcterms:source glosis_lh:solubleAnionsTotalProperty ;
            rdf:value "The Soluble Anions Total measures the concentration of anions (e.g., chloride, sulfate, nitrate) in soil solution. High levels may indicate salinity, nutrient availability, or contamination. Source: Sparks, D.L. (2003). Environmental Soil Chemistry."@en ] ;
    skos:exactMatch glosis_lh:solubleAnionsTotalProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soluble anion total"@en .

eusoilvoc:SolubleCationTotal a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "soluble cations total"@en ;
    skos:broader eusoilvoc:SoilSolutes ;
    skos:definition [ dcterms:source glosis_lh:solubleCationsTotalProperty ;
            rdf:value "The Soluble Cations Total evaluates the sum of cations (e.g., sodium, potassium, calcium, magnesium) in soil solution. It is an indicator of soil salinity, fertility, and chemical balance. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."@en ] ;
    skos:exactMatch glosis_lh:solubleCationsTotalProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soluble cation total"@en .

eusoilvoc:SplashErosion a skos:Concept ;
    skos:broader eusoilvoc:WaterErosion ;
    skos:definition [ dcterms:source nalt:63944 ;
            rdf:value "The spattering of small soil particles caused by the impact of raindrops on wet soils. The loosened and spattered particles may or may not be subsequently removed by surface runoff."@en ] ;
    skos:exactMatch agrovoc:c_95539e7b,
        nalt:63944 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "splash erosion"@en .

eusoilvoc:SpodosolsUSDA a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationUSDA ;
    skos:definition [ dcterms:source nalt:11601 ;
            rdf:value "Acidic forest soil of low fertility"@en ],
        [ dcterms:source agrovoc:c_36874 ;
            rdf:value "Spodosols are acid soils characterized by a subsurface accumulation of humus that is complexed with Al and Fe."@en ] ;
    skos:exactMatch agrovoc:c_36874,
        nalt:11601 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Spodosols"@en ;
    skos:scopeNote "USDA Soil Taxonomy order. This concept is separate from any similarly named FAO-UNESCO or WRB group; definitions are not transferred between systems."@en .

eusoilvoc:StagnosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_d9028da2 ;
            rdf:value "Stagnosols are soils with perched water. They show periodically reducing conditions resulting in stagnic properties. Stagnosols have a mottled layer (with oxides predominantly inside the aggregates) with or without an overlying layer with albic material. Redox processes may also be caused by intruding liquids other than water (e.g. gasoline). A common name in many national soil classification systems for most Stagnosols is Pseudogley. In the United States of America many Stagnosols belong to Aquic Suborders and Epiaquic Great Groups of various Orders (Aqualfs, Aquults, Aquents, Aquepts and Aquolls)."@en ] ;
    skos:exactMatch agrovoc:c_d9028da2,
        nalt:216366,
        she:Stagnosols ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Stagnosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:Stickiness a skos:Concept,
        sosa:ObservableProperty ;
    sio:equivalentTo eusoilvoc:SoilAdhesion ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:definition [ dcterms:source glosis_lh:stickinessProperty ;
            rdf:value "The Stickiness measures the soil’s tendency to adhere to surfaces or objects when wet. It is influenced by clay content and organic matter and affects soil workability and machinery use. Source: Hillel, D. (2004). Introduction to Environmental Soil Physics."@en ] ;
    skos:exactMatch agrovoc:c_7409,
        glosis_lh:stickinessProperty,
        nalt:58070 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "stickiness"@en .

eusoilvoc:StickyConsistence a skos:Concept ;
    skos:broader eusoilvoc:SoilConsistence ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A soil consistence in which the soil adheres to other objects, such as farm implements or shoes."@en ] ;
    skos:exactMatch spp:StickyConsistence ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "sticky consistence"@en .

eusoilvoc:StoneClearing a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:exactMatch agrovoc:c_25433 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "stone clearing"@en .

eusoilvoc:StonySoils a skos:Concept ;
    skos:broader eusoilvoc:TexturalSoilTypes ;
    skos:exactMatch agrovoc:c_7425,
        nalt:64223 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "stony soils"@en .

eusoilvoc:StratigraphicSoilTypes a skos:Concept ;
    skos:broader eusoilvoc:SoilTypes ;
    skos:exactMatch agrovoc:c_7439,
        nalt:45699 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "stratigraphic soil types"@en .

eusoilvoc:StrawMulches a skos:Concept ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_7442 ;
            rdf:value "A mulch where straw is used to cover soil surface."@en ] ;
    skos:exactMatch agrovoc:c_7442,
        nalt:53676 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "straw mulches"@en .

eusoilvoc:StripTillage a skos:Concept ;
    skos:broader eusoilvoc:ConservationTillage ;
    skos:definition [ dcterms:source agrovoc:c_1516cbf3 ;
            rdf:value "Strip-till is a conservation system that uses a minimum tillage. It combines the soil drying and warming benefits of conventional tillage with the soil-protecting advantages of no-till by disturbing only the portion of the soil that is to contain the seed row."@en ] ;
    skos:exactMatch agrovoc:c_1516cbf3,
        nalt:28633 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "strip tillage"@en .

eusoilvoc:StructuralPores a skos:Concept ;
    skos:altLabel "structural pore"@en ;
    skos:broader eusoilvoc:SoilPores ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Pores between aggregates that result from the arrangement of structural elements and aggregate characteristics; also called interaggregate pores."@en ] ;
    skos:exactMatch spp:StructuralPore ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "structural pores"@en .

eusoilvoc:StructuralPorosity a skos:Concept ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The pore space between soil aggregates, defined by their spatial arrangement; also called interaggregate porosity."@en ] ;
    skos:exactMatch spp:StructuralPorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "structural porosity"@en .

eusoilvoc:StructureGrade a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilStructure ;
    skos:definition [ dcterms:source glosis_lh:structureGradeProperty ;
            rdf:value "The Structure Grade assesses the development and stability of soil aggregates, classified as weak, moderate, or strong. It reflects soil tilth, aeration, and resistance to erosion. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."@en ] ;
    skos:exactMatch glosis_lh:structureGradeProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "structure grade"@en .

eusoilvoc:StructureSize a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilStructure ;
    skos:definition [ dcterms:source glosis_lh:structureSizeProperty ;
            rdf:value "The Structure Size describes the dimensions of soil aggregates or structural units, such as granular, blocky, or platy. Structure size affects root penetration, water infiltration, and soil stability. Source: FAO (2006). Guidelines for Soil Description."@en ] ;
    skos:exactMatch glosis_lh:structureSizeProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "structure size"@en .

eusoilvoc:StubbleTillage a skos:Concept ;
    skos:broader eusoilvoc:ConservationTillage ;
    skos:definition [ dcterms:source agrovoc:c_b219433a ;
            rdf:value "A tillage system which retains a high percentage of crop residue on the soil surface, thereby reducing wind erosion."@en ] ;
    skos:exactMatch agrovoc:c_b219433a,
        nalt:146604 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "stubble tillage"@en .

eusoilvoc:SubtropicalSoils a skos:Concept ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_14657,
        nalt:26889 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "subtropical soils"@en .

eusoilvoc:SupportingServices a skos:Concept ;
    skos:altLabel "supporting service"@en ;
    skos:broader eusoilvoc:EcosystemServices ;
    skos:exactMatch agrovoc:c_0f955994,
        she:SupportingServices ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "supporting services"@en .

eusoilvoc:SurfaceAggregationRatio a skos:Concept ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The total surface area of soil particles larger than 0.05 mm in diameter divided by the quantity of aggregated silt and clay."@en ] ;
    skos:exactMatch spp:SurfaceAggregationRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "surface aggregation ratio"@en .

eusoilvoc:SurfaceCultivation a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:exactMatch agrovoc:c_25725 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "surface cultivation"@en .

eusoilvoc:SurfaceDrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:definition [ dcterms:source agrovoc:c_25594 ;
            rdf:value "The diversion or orderly removal of excess water from the surface of the land by means of improved natural or constructed channels, supplemented when necessary by the shaping and grading of land surfaces to such channels."@en ] ;
    skos:exactMatch agrovoc:c_25594,
        nalt:34484 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "surface drainage"@en .

eusoilvoc:SurfaceRunoff a skos:Concept ;
    skos:broader eusoilvoc:Runoff ;
    skos:closeMatch agrovoc:c_35388,
        inrae:c_4876 ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Water moving downslope over the soil surface as overland flow when water application exceeds infiltration into the soil."@en ] ;
    skos:exactMatch spp:SurfaceRunoff,
        gemet:8225 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "surface runoff"@en .

eusoilvoc:SwampSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_7543,
        nalt:35702 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "swamp soils"@en .

eusoilvoc:TechnosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_3a0750ba ;
            rdf:value "Technosols combine soils whose properties and pedogenesis are dominated by their technical origin. They contain a significant amount of artefacts (something in the soil recognizably made or strongly altered by humans or extracted from greater depths) or are sealed by technic hard material (hard material created by humans, having properties unlike natural rock) or contain a geomembrane. They include soils from wastes (landfills, sludge, cinders, mine spoils and ashes), pavements with their underlying unconsolidated materials, soils with geomembranes and constructed soils. Technosols are often referred to as Urban or Mine soils. They are recognized in the Russian soil classification system as Technogenic superficial formations and in the Australian soil classification, they are included in Anthroposols."@en ] ;
    skos:exactMatch agrovoc:c_3a0750ba,
        nalt:216367 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Technosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:Termites a skos:Concept ;
    skos:altLabel "termite"@en ;
    skos:broader eusoilvoc:SoilMacrofauna ;
    skos:closeMatch nalt:45666 ;
    skos:exactMatch agrovoc:c_b8039965,
        spp:Termite ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "termites"@en .

eusoilvoc:TexturalPores a skos:Concept ;
    skos:altLabel "textural pore"@en ;
    skos:broader eusoilvoc:SoilPores ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Pores within an aggregate, determined by textural characteristics and the packing state of elementary particles; also called intraaggregate pores."@en ] ;
    skos:exactMatch spp:TexturalPore ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "textural pores"@en .

eusoilvoc:TexturalPorosity a skos:Concept ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The porosity defined by the spatial distribution of soil separates or primary particles."@en ] ;
    skos:exactMatch spp:TexturalPorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "textural porosity"@en .

eusoilvoc:TextureFieldClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_lh:textureFieldClassProperty ;
            rdf:value "The Texture Field Class categorizes soil texture based on the relative proportions of sand, silt, and clay, as assessed by field methods like the ribbon test. Field classes include sandy loam, clay loam, etc. Source: Soil Survey Manual (USDA, 2017)."@en ] ;
    skos:exactMatch glosis_lh:textureFieldClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "texture field class"@en .

eusoilvoc:TextureLabClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_lh:textureLabClassProperty ;
            rdf:value "The Texture Lab Class defines soil texture using laboratory-determined particle size distributions. This property provides a precise classification of soil as sand, silt, or clay using standard methods. Source: Brady, N.C., & Weil, R.R. (2008). The Nature and Properties of Soils."@en ] ;
    skos:exactMatch glosis_lh:textureLabClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "texture lab class"@en .

eusoilvoc:TotalSoilMoisturePotential a skos:Concept ;
    skos:broader eusoilvoc:SoilMoisturePotential ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The sum of the pressure, matric, gravitational or positional, osmotic, and overburden components of soil-moisture potential: Φt = Φp + Φm + Φz + Φπ + Φo, respectively."@en ] ;
    skos:exactMatch spp:TotalSoilMoisturePotential ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "total soil moisture potential"@en .

eusoilvoc:Transpiration a skos:Concept ;
    skos:broader eusoilvoc:WaterInterchange ;
    skos:exactMatch agrovoc:c_7871,
        spp:Transpiration,
        gemet:8630,
        nalt:44123 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "transpiration"@en .

eusoilvoc:TransverseDispersion a skos:Concept ;
    skos:broader eusoilvoc:SoilSoluteDispersiveTransport ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Dispersion of solutes in the direction perpendicular to the direction of flow."@en ] ;
    skos:exactMatch spp:TransverseDispersion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "transverse dispersion"@en .

eusoilvoc:TreeDensity a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Trees ;
    skos:definition [ dcterms:source glosis_sp:treeDensityProperty ;
            rdf:value "Tree Density refers to the number of trees per unit area, usually expressed as trees per hectare. High tree density is often associated with forested ecosystems that contribute to soil fertility through organic matter inputs, root structures that stabilize the soil, and enhanced moisture retention. Source: FAO, 'Forest Resources Assessment'"@en ] ;
    skos:exactMatch inrae:c_3020,
        glosis_sp:treeDensityProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "tree density"@en .

eusoilvoc:TropicalSoils a skos:Concept ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_7978,
        nalt:26891 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "tropical soils"@en .

eusoilvoc:UltisolsUSDA a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationUSDA ;
    skos:closeMatch agrovoc:c_101 ;
    skos:exactMatch nalt:11621 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Ultisols"@en ;
    skos:scopeNote "USDA Soil Taxonomy order. This concept is separate from any similarly named FAO-UNESCO or WRB group; definitions are not transferred between systems."@en .

eusoilvoc:UmbrisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_9e95a849 ;
            rdf:value "Umbrisols have a significant accumulation of organic matter in the mineral surface soil and a low base saturation somewhere within the first metre (in most cases in the mineral surface soil). Umbrisols are the logical counterpart of soils with a chernic or mollic horizon and a high base saturation throughout (Chernozems, Kastanozems and Phaeozems). Many of these soils are classified in other systems as several Great Groups of Entisols and Inceptisols (United States of America), Sombric Brunisols and Humic Regosols (France), Mountain-meadow soils (former USSR) and Mucky-dark-humus soils (Russia), Brown podzolic soils (e.g. Indonesia) and Umbrisols (Romania). In the Soil Map of the World (FAO–UNESCO, 1971–1981) most of them belong to Humic Cambisols and Umbric Regosols."@en ] ;
    skos:exactMatch agrovoc:c_9e95a849,
        nalt:216368 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Umbrisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:Underdrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:closeMatch inrae:c_2661 ;
    skos:exactMatch agrovoc:c_25600 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "underdrainage"@en .

eusoilvoc:UniversalSoilLossEquation a skos:Concept ;
    skos:broader eusoilvoc:SoilErosionModels ;
    skos:definition [ dcterms:source agrovoc:c_32619 ;
            rdf:value "An empirical erosion model designed to compute long-term average soil losses from sheet and rill erosion under specified conditions."@en ] ;
    skos:exactMatch agrovoc:c_32619,
        nalt:37669 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Universal Soil Loss Equation"@en .

eusoilvoc:UnsaturatedHydraulicConductivity a skos:Concept ;
    skos:broader eusoilvoc:SoilHydraulicConductivity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The coefficient relating water flux through unsaturated soil to the hydraulic potential gradient, expressed by q = K(θ) ∂(Φ_m + Φ_z)/∂z, where q is water flux, K(θ) is unsaturated hydraulic conductivity, Φ_m and Φ_z are matric and gravitational potentials, and z is position. It is a nonlinear function of soil moisture content and matric potential."@en ] ;
    skos:exactMatch spp:UnsaturatedHydraulicConductivity,
        nalt:46279,
        she:UnsaturatedHydraulicConductivity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "unsaturated hydraulic conductivity"@en .

eusoilvoc:UnsaturatedWaterFlow a skos:Concept ;
    skos:broader eusoilvoc:SoilWaterFlow ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Water movement through a soil matrix that contains air-filled pores, following tortuous paths around those pores."@en ] ;
    skos:exactMatch spp:UnsaturatedWaterFlow ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "unsaturated water flow"@en .

eusoilvoc:UplandSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_8077,
        nalt:45552 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "upland soils"@en .

eusoilvoc:Vanadium a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:exactMatch agrovoc:c_8154,
        inrae:c_db013c77,
        gemet:8893,
        nalt:66209 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "vanadium"@en .

eusoilvoc:VariableCharge a skos:Concept ;
    skos:broader eusoilvoc:SoilSurfaceCharge ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A pH-dependent or proton-dependent surface charge caused by an imbalance of complexed proton and hydroxyl charges."@en ] ;
    skos:exactMatch spp:VariableCharge,
        nalt:63359 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "variable charge"@en .

eusoilvoc:VegetationClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_sp:vegetationClassProperty ;
            rdf:value "Vegetation Class refers to the categorization of vegetation types based on species composition and structure, such as forests, grasslands, and wetlands. The class of vegetation affects soil fertility, microbial activity, and water retention, which in turn influences agricultural potential and ecosystem services. Source: FAO, 'Vegetation and Land Use in Arid Zones'"@en ] ;
    skos:exactMatch glosis_sp:vegetationClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "vegetation class"@en .

eusoilvoc:Vermiculites a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:exactMatch agrovoc:c_8194 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "vermiculites"@en .

eusoilvoc:VertisolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils which, after the upper 20 cm are mixed, have 30 percent or more clay in all horizons to at least 50 cm from the surface; at some period in most years have cracks at least 1 cm wide at a depth of 50 cm, unless irrigated, and have one or more of the following characteristics: gilgai microrelief, intersecting slickensides or wedge-shaped or parallelepiped structural aggregates at some depth between 25 and 100 cm from the surface."@en ] ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Vertisols"@en .

eusoilvoc:VertisolsUSDA a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationUSDA ;
    skos:closeMatch nalt:11557 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Vertisols"@en ;
    skos:scopeNote "USDA Soil Taxonomy order. This concept is separate from any similarly named FAO-UNESCO or WRB group; definitions are not transferred between systems."@en .

eusoilvoc:VertisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_8199 ;
            rdf:value "Vertisols are heavy clay soils with a high proportion of swelling clays. These soils form deep wide cracks from the surface downward when they dry out, which happens in most years. Common local names for Vertisols are Black cotton soils and Regur (India), Black turf soils (South Africa) or Margalites (Indonesia). In national soil classification systems they are called Slitozems or Dark vertic soils (Russia), Vertosols (Australia), Vertissolos (Brazil) and Vertisols (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_8199 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Vertisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:VirginSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_35348 ;
            rdf:value "Soil that has not been used for agricultural purposes or disturbed by humans at all."@en ] ;
    skos:exactMatch agrovoc:c_35348,
        nalt:35705 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "virgin soils"@en .

eusoilvoc:VoidClassification a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "voids classification"@en ;
    skos:broader eusoilvoc:SoilVoids ;
    skos:definition [ dcterms:source glosis_lh:voidsClassificationProperty ;
            rdf:value "The Voids Classification categorizes voids or pores in the soil based on size, shape, and arrangement. These voids are critical for water movement, air circulation, and root penetration. They are classified into macropores (large), mesopores (medium), and micropores (small). Source: Hillel, D. (2004). Introduction to Environmental Soil Physics."@en ] ;
    skos:exactMatch glosis_lh:voidsClassificationProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "void classification"@en .

eusoilvoc:VoidDiameter a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "voids diameter"@en ;
    skos:broader eusoilvoc:SoilVoids ;
    skos:definition [ dcterms:source glosis_lh:voidsDiameterProperty ;
            rdf:value "The Voids Diameter refers to the size of void spaces in soil, which can range from macro-voids (larger pores) to micro-voids (tiny pores). Voids diameter impacts soil aeration, water retention, and drainage. Source: Soil Science Society of America (SSSA) Glossary."@en ] ;
    skos:exactMatch glosis_lh:voidsDiameterProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "void diameter"@en .

eusoilvoc:VoidRatio a skos:Concept ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The volume of soil voids divided by the volume of soil solids."@en ] ;
    skos:exactMatch spp:VoidRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "void ratio"@en .

eusoilvoc:VolcanicSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:closeMatch inrae:c_811 ;
    skos:exactMatch agrovoc:c_8287,
        nalt:50389 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "volcanic soils"@en .

eusoilvoc:WaterRegulation a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctions ;
    skos:exactMatch she:WaterRegulation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "water regulation"@en .

eusoilvoc:WaterRepellentSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_8edcdbc5 ;
            rdf:value "Soils which have hydrophobic properties (also called water repellent soils) can resist or retard surface water inﬁltration."@en ] ;
    skos:exactMatch agrovoc:c_8edcdbc5,
        nalt:24695 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "water repellent soils"@en .

eusoilvoc:WaterStorageCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilFunctionIndicators ;
    skos:exactMatch she:WaterStorageCapacity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "water storage capacity"@en .

eusoilvoc:WeatherCurrent a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Weather ;
    skos:definition [ dcterms:source glosis_sp:weatherConditionsCurrentProperty ;
            rdf:value "Weather Conditions Current describes the current atmospheric conditions in a specific location, including factors like temperature, humidity, wind speed, and precipitation. These conditions directly affect soil moisture, temperature, and erosion rates, influencing soil fertility and the ability to support plant growth. Source: USGS, 'Meteorological and Soil Interactions'"@en ] ;
    skos:exactMatch glosis_sp:weatherConditionsCurrentProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "weather current"@en .

eusoilvoc:WeatherPast a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Weather ;
    skos:definition [ dcterms:source glosis_sp:weatherConditionsPastProperty ;
            rdf:value "Weather Conditions Past refers to historical weather data, including past patterns of temperature, precipitation, and extreme weather events. Understanding past weather conditions helps in predicting soil behavior, erosion patterns, and agricultural productivity, as well as preparing for future changes in soil moisture and temperature. Source: USDA NRCS, 'Climate and Soil Interactions'"@en ] ;
    skos:exactMatch glosis_sp:weatherConditionsPastProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "weather past"@en .

eusoilvoc:WeatheringFragments a skos:Concept,
        sosa:ObservableProperty ;
    skos:altLabel "weathering fragment"@en ;
    skos:broader eusoilvoc:Fragments ;
    skos:definition [ dcterms:source glosis_cm:weatheringFragmentsProperty ;
            rdf:value "The Weathering Fragment refers to soil particles or rock fragments that have been broken down through physical, chemical, or biological weathering. These fragments play a role in soil texture, structure, and nutrient availability. The degree of weathering can indicate the age and stability of the soil’s mineral content. Source: Brady, N. C., & Weil, R. R. (2008). The Nature and Properties of Soils (14th ed.). Pearson Prentice Hall."@en ] ;
    skos:exactMatch glosis_cm:weatheringFragmentsProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "weathering fragments"@en .

eusoilvoc:WeatheringRock a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:Rock ;
    skos:definition [ dcterms:source glosis_sp:weatheringRockProperty ;
            rdf:value "Weathering Rock refers to the process of rock decomposition due to environmental factors like temperature changes, water, and chemical reactions. This process is important in soil formation as it contributes to the breakdown of parent material into smaller particles that form soil. Source: AGI, 'Encyclopedia of Geology'"@en ] ;
    skos:exactMatch glosis_sp:weatheringRockProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "weathering rock"@en .

eusoilvoc:WetPlasticity a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilPlasticity ;
    skos:definition [ dcterms:source glosis_lh:wetPlasticityProperty ;
            rdf:value "The Wet Plasticity measures the soil’s ability to deform under pressure when saturated. Wet plasticity is influenced by clay mineralogy and is important for understanding soil behavior under wet conditions. Source: Hillel, D. (2004). Introduction to Environmental Soil Physics."@en ] ;
    skos:exactMatch glosis_lh:wetPlasticityProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wet plasticity"@en .

eusoilvoc:WetSoilBulkDensity a skos:Concept ;
    skos:broader eusoilvoc:SoilBulkDensity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ratio of the combined mass of soil solids and soil water to the total soil volume."@en ] ;
    skos:exactMatch spp:WetSoilBulkDensity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wet soil bulk density"@en .

eusoilvoc:WetlandSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_8370,
        nalt:35706 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wetland soils"@en .

eusoilvoc:WheelTracks a skos:Concept ;
    skos:broader eusoilvoc:SoilMorphologicalFeatures ;
    skos:definition [ dcterms:source agrovoc:c_9093eccc ;
            rdf:value "Depressions in the soil which are caused by the rolling of vehicle wheels over the surface of the soil."@en ] ;
    skos:exactMatch agrovoc:c_9093eccc,
        nalt:1012 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wheel tracks"@en .

