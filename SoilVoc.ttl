    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:exactMatch spp:SoilClayMineralogy ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil clay mineralogy"@en .

eusoilvoc:SoilClods a skos:Concept ;
    skos:broader eusoilvoc:SoilComponents ;
    skos:closeMatch nalt:26938 ;
    skos:exactMatch agrovoc:c_34900 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil clods"@en .

eusoilvoc:SoilCohesion a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:closeMatch agrovoc:c_7199 ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The attraction and bonding between soil particles."@en ] ;
    skos:exactMatch spp:SoilCohesion,
        inrae:c_11318 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil cohesion"@en .

eusoilvoc:SoilCohesiveness a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:closeMatch inrae:c_11318 ;
    skos:exactMatch spp:SoilCohesiveness ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil cohesiveness"@en .

eusoilvoc:SoilCollapsing a skos:Concept ;
    skos:broader eusoilvoc:SoilDeformation ;
    skos:exactMatch spp:SoilCollapsing ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil collapsing"@en .

eusoilvoc:SoilColourDry a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilColour ;
    skos:definition [ dcterms:source glosis_cm:colourDryProperty ;
            rdf:value "The Soil Colour Dry describes the color of soil when it is in a dry state. Soil color in the dry condition is influenced by the soil’s mineral composition and moisture content. For example, soils with high organic matter content typically appear dark brown or black when dry, while sandy or saline soils may appear lighter in color. Dry soil color is used in soil classification and can provide insights into the soil's composition and drainage. Source: Soil Science Society of America. (2008). Soil Science Glossary. Soil Science Society of America."@en ] ;
    skos:exactMatch glosis_cm:colourDryProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil colour dry"@en .

eusoilvoc:SoilColourMoist a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilColour ;
    skos:definition [ dcterms:source glosis_cm:colourMoistProperty ;
            rdf:value "The Soil Colour Moist refers to the soil's color when it is in a wet or moist condition. Moisture enhances the color intensity of the soil, which is often darker compared to its dry state. This is particularly helpful in determining organic matter content, iron oxide presence, and soil moisture retention. For instance, moist soils with abundant organic material tend to appear darker, whereas more mineral-rich soils can appear lighter in color. Source: Soil Science Society of America. (2008). Soil Science Glossary. Soil Science Society of America."@en ] ;
    skos:exactMatch glosis_cm:colourMoistProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil colour moist"@en .

eusoilvoc:SoilCompactability a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The difference between a soil's initial bulk density and the maximum bulk density to which it can be compacted by a given amount of energy at a defined moisture content."@en ] ;
    skos:exactMatch spp:SoilCompactability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil compactability"@en .

eusoilvoc:SoilCompressibility a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The resistance of a soil to a decrease in volume under an external load."@en ],
        [ dcterms:source spp:SoilCompressibility ;
            rdf:value "resistance of a soil against volume decrease by external load."@en ] ;
    skos:exactMatch spp:SoilCompressibility ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil compressibility"@en .

eusoilvoc:SoilConditioners a skos:Concept ;
    skos:broader eusoilvoc:SoilAmendments ;
    skos:definition [ dcterms:source agrovoc:c_7164 ;
            rdf:value "Any substance used for soil conditioning, such as lime or organic fertilizer."@en ] ;
    skos:exactMatch agrovoc:c_7164,
        nalt:47753 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil conditioners"@en .

eusoilvoc:SoilConservationLegislation a skos:Concept ;
    skos:broader eusoilvoc:SoilConservation ;
    skos:definition [ dcterms:source agrovoc:c_0a2f9038 ;
            rdf:value "The entirety of the laws, regulations and directives with legal effect in the area of ​​soil protection applicable to a country or a country community."@en ] ;
    skos:exactMatch agrovoc:c_0a2f9038,
        gemet:7853 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil conservation legislation"@en .

eusoilvoc:SoilConsolidation a skos:Concept ;
    skos:broader eusoilvoc:SoilCompression ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The densification of saturated soil through a reduction in volume caused by the expulsion of water."@en ] ;
    skos:exactMatch spp:SoilConsolidation,
        inrae:c_11244 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil consolidation"@en .

eusoilvoc:SoilCrackDepth a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilCracks ;
    skos:definition [ dcterms:source glosis_cm:cracksDepthProperty ;
            rdf:value "The Soil Crack Depth refers to the measurement of the vertical depth of cracks formed in soil, which is typically observed in dry conditions when the soil shrinks. Cracks are more common in clayey soils that experience significant shrinkage upon drying. The depth of these cracks can indicate soil moisture levels, compaction, and the ability of the soil to expand and contract, which affects water infiltration and root penetration. Source: McSweeney, K. (2009). Soil and Water Conservation Handbook. CRC Press."@en ] ;
    skos:exactMatch glosis_cm:cracksDepthProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crack depth"@en .

eusoilvoc:SoilCrackDistance a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilCracks ;
    skos:definition [ dcterms:source glosis_cm:cracksDistanceProperty ;
            rdf:value "The Soil Crack Distance refers to the horizontal spacing between cracks in the soil surface, which can occur due to the shrinkage of soil as it dries. Cracks form when water content decreases, and their distance is an indicator of the soil's shrink-swell behavior. Larger distances between cracks generally indicate more severe soil shrinkage, which can affect root growth and water infiltration. Source: McSweeney, K. (2009). Soil and Water Conservation Handbook. CRC Press."@en ] ;
    skos:exactMatch glosis_cm:cracksDistanceProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crack distance"@en .

eusoilvoc:SoilCrackWidth a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilCracks ;
    skos:definition [ dcterms:source glosis_cm:cracksWidthProperty ;
            rdf:value "The Soil Crack Width refers to the measurement of the gap or space between the sides of soil cracks. The width of these cracks is typically influenced by soil moisture content and texture. Wider cracks are indicative of drier conditions and are commonly found in soils with high clay content, which tend to shrink and form deep cracks when the moisture content is reduced. Source: McSweeney, K. (2009). Soil and Water Conservation Handbook. CRC Press."@en ] ;
    skos:exactMatch glosis_cm:cracksWidthProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crack width"@en .

eusoilvoc:SoilCrackingIntensity a skos:Concept ;
    skos:broader eusoilvoc:SoilCrackingPhysicalProperties ;
    skos:exactMatch spp:SoilCrackingIntensity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil cracking intensity"@en .

eusoilvoc:SoilCrackingNumber a skos:Concept ;
    skos:broader eusoilvoc:SoilCrackingPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The number of soil cracks per unit area."@en ],
        [ dcterms:source spp:SoilCrackingNumber ;
            rdf:value "number of cracks per unit area formed in a soil"@en ] ;
    skos:exactMatch spp:SoilCrackingNumber ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil cracking number"@en .

eusoilvoc:SoilCrustDensity a skos:Concept ;
    skos:broader eusoilvoc:SoilCrustPhysicalProperties ;
    skos:exactMatch spp:SoilCrustDensity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crust density"@en .

eusoilvoc:SoilCrustStrength a skos:Concept ;
    skos:broader eusoilvoc:SoilCrustPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The breaking strength of a soil crust, operationally assessed by the modulus of rupture: the maximum force per unit area that a soil specimen prepared to simulate crust formation can withstand without breaking. For a rectangular briquette, the modulus of rupture is 3Fl/(2bd²), where F is the failure force, l the briquette length, b its breadth, and d its thickness."@en ] ;
    skos:exactMatch spp:SoilCrustStrength ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crust strength"@en .

eusoilvoc:SoilCrustThickness a skos:Concept ;
    skos:broader eusoilvoc:SoilCrustPhysicalProperties ;
    skos:exactMatch spp:SoilCrustThickness ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crust thickness"@en .

eusoilvoc:SoilDenitrification a skos:Concept ;
    skos:broader eusoilvoc:SoilOxidationReductionReaction ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The anaerobic reduction of nitrate in flooded or saturated soil through nitrite and nitrous oxide toward elemental nitrogen, decreasing soil nitrate content and producing gaseous nitrogen compounds."@en ] ;
    skos:exactMatch spp:SoilDenitrification ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil denitrification"@en .

eusoilvoc:SoilDenudation a skos:Concept ;
    skos:altLabel "soil loss"@en ;
    skos:broader eusoilvoc:SoilProcesses ;
    skos:definition [ dcterms:source agrovoc:c_8dab65bc ;
            rdf:value "Removal of soil surface material, mostly caused by erosion. Loss of total soil material by single soil erosion events."@en ] ;
    skos:exactMatch agrovoc:c_8dab65bc ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil denudation"@en .

eusoilvoc:SoilDepositionalCrusts a skos:Concept ;
    skos:altLabel "soil depositional crust"@en ;
    skos:broader eusoilvoc:SoilPhysicalCrusts ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A soil-surface crust formed by the transport and deposition of fine particles by surface flow."@en ] ;
    skos:exactMatch spp:SoilDepositionalCrust ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil depositional crusts"@en .

eusoilvoc:SoilDepthBedrock a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDepth ;
    skos:definition [ dcterms:source glosis_cm:soilDepthBedrockProperty ;
            rdf:value "The Soil Depth Bedrock refers to the distance from the soil surface to the underlying bedrock layer. This measurement is important for understanding the soil's capacity to support plant growth, as soils with shallow bedrock tend to have limited rooting depth, affecting water retention and nutrient availability. Source: FAO (2006). Guidelines for Soil Description (4th ed.). Food and Agriculture Organization of the United Nations."@en ] ;
    skos:exactMatch glosis_cm:soilDepthBedrockProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil depth bedrock"@en .

eusoilvoc:SoilDepthRootable a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDepth ;
    skos:definition [ dcterms:source glosis_cm:soilDepthRootableProperty ;
            rdf:value "The Soil Depth Rootable refers to the actual vertical depth of soil that can support plant roots, excluding any non-rootable layers such as bedrock or a water-impervious horizon. This depth is crucial for determining the suitability of land for agriculture and vegetation. Source: Soil Science Society of America. (2008). Soil Science Glossary. Soil Science Society of America."@en ] ;
    skos:exactMatch glosis_cm:soilDepthRootableProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil depth rootable"@en .

eusoilvoc:SoilDepthRootableClass a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source glosis_cm:soilDepthRootableClassProperty ;
            rdf:value "The Soil Depth Rootable Class classifies soils based on the depth of the rootable zone, which excludes impenetrable layers such as bedrock or compacted horizons. Soils are typically classified as shallow, moderately deep, or deep, depending on the depth of the root zone, which directly affects plant growth. Source: FAO (2006). Guidelines for Soil Description (4th ed.). Food and Agriculture Organization of the United Nations."@en ] ;
    skos:exactMatch glosis_cm:soilDepthRootableClassProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil depth rootable class"@en .

eusoilvoc:SoilDepthSampled a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilDepth ;
    skos:definition [ dcterms:source glosis_cm:soilDepthSampledProperty ;
            rdf:value "The Soil Depth Sampled indicates the specific depth of the soil profile that has been sampled for analysis. This property is important for understanding the representativeness of the sample, as different soil horizons may vary significantly in properties such as texture, fertility, and moisture content. Source: Soil Science Society of America. (2008). Soil Science Glossary. Soil Science Society of America."@en ] ;
    skos:exactMatch glosis_cm:soilDepthSampledProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil depth sampled"@en .

eusoilvoc:SoilDesiccation a skos:Concept ;
    skos:broader eusoilvoc:SoilDrying ;
    skos:exactMatch spp:SoilDesiccation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil desiccation"@en .

eusoilvoc:SoilDisinfection a skos:Concept ;
    skos:broader eusoilvoc:SoilTreatment ;
    skos:exactMatch agrovoc:c_25830,
        inrae:c_3727 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil disinfection"@en .

eusoilvoc:SoilDispersibility a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:exactMatch spp:SoilDispersibility ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil dispersibility"@en .

eusoilvoc:SoilDispersion a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProcesses ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The breakdown of flocculated soil colloids into particles suspended in water, reversing flocculation; also called deflocculation or peptization."@en ] ;
    skos:exactMatch spp:SoilDispersion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil dispersion"@en .

eusoilvoc:SoilDrySpecificVolume a skos:Concept ;
    skos:broader eusoilvoc:SoilDensity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The reciprocal of dry soil bulk density, expressing soil volume per unit dry mass."@en ] ;
    skos:exactMatch spp:SoilDrySpecificVolume ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil dry specific volume"@en .

eusoilvoc:SoilDynamics a skos:Concept ;
    skos:broader eusoilvoc:SoilMechanics ;
    skos:exactMatch agrovoc:c_25080,
        inrae:c_562 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil dynamics"@en .

eusoilvoc:SoilEcologicalDegradation a skos:Concept ;
    skos:broader eusoilvoc:SoilDegradation ;
    skos:exactMatch she:SoilEcologicalDegradation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil ecological degradation"@en .

eusoilvoc:SoilElasticity a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The behavior by which soil deforms instantaneously under stress, retains the changed form while the stress acts, and returns toward its original form when the stress is released; soil need not be perfectly elastic and may retain residual deformation."@en ] ;
    skos:exactMatch spp:SoilElasticity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil elasticity"@en .

eusoilvoc:SoilElectricalCapacitance a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ratio of electric charge Q acquired by each capacitor plate to potential difference V, C = Q/V, measured in a capacitor whose dielectric includes moist soil."@en ] ;
    skos:exactMatch spp:SoilElectricalCapacitance ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil electrical capacitance"@en .

eusoilvoc:SoilErodibility a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:exactMatch spp:SoilErodibility,
        she:SoilErodibility ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil erodibility"@en .

eusoilvoc:SoilErosionActivityPeriod a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source glosis_sp:erosionActivityPeriodProperty ;
            rdf:value "Soil Erosion Activity Period refers to the time frame during which soil erosion processes, such as wind or water erosion, are most active in a given area. This period is influenced by climatic conditions, seasonal rainfall, and land use, and it helps in assessing the vulnerability of soils to degradation. Source: USDA NRCS, 'Soil Erosion and Conservation'"@en ] ;
    skos:exactMatch glosis_sp:erosionActivityPeriodProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil erosion activity period"@en .

eusoilvoc:SoilErosionAreaAffected a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source glosis_sp:erosionAreaAffectedProperty ;
            rdf:value "Soil Erosion Area Affected refers to the extent of land area that has been impacted by soil erosion processes, such as water or wind erosion. This property is important for evaluating the severity of soil degradation in a given region and helps in identifying areas that require soil conservation measures. Source: USDA NRCS, 'Soil Erosion Research and Technology Transfer'"@en ] ;
    skos:exactMatch glosis_sp:erosionAreaAffectedProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil erosion area affected"@en .

eusoilvoc:SoilErosionCategory a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source glosis_sp:erosionCategoryProperty ;
            rdf:value "Soil Erosion Category classifies the type and severity of erosion in a given area. Categories are often based on the nature of the erosive forces (e.g., water, wind) and the degree of soil loss, ranging from slight to severe. This classification aids in prioritizing conservation efforts and understanding the potential impacts on soil quality. Source: FAO, 'Soil Erosion and Conservation'"@en ] ;
    skos:exactMatch glosis_sp:erosionCategoryProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil erosion category"@en .

eusoilvoc:SoilErosionDegree a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source glosis_sp:erosionDegreeProperty ;
            rdf:value "Soil Erosion Degree refers to the level of intensity or severity of soil erosion in an area, categorized into classes such as slight, moderate, or severe. The degree of erosion helps in assessing the extent of soil degradation and informs decisions on soil conservation and land management. Source: FAO, 'Soil Erosion and Conservation'"@en ] ;
    skos:exactMatch glosis_sp:erosionDegreeProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil erosion degree"@en .

eusoilvoc:SoilErosionTotalAreaAffected a skos:Concept,
        sosa:ObservableProperty ;
    skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source glosis_sp:erosionTotalAreaAffectedProperty ;
            rdf:value "Soil Erosion Total Area Affected quantifies the total land area affected by erosion processes. It is an important measure in understanding the broader impact of erosion on soil health, productivity, and ecosystem services across a landscape. Source: USDA NRCS, 'Soil Erosion and Landscape Analysis'"@en ] ;
    skos:exactMatch glosis_sp:erosionTotalAreaAffectedProperty ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil erosion total area affected"@en .

eusoilvoc:SoilExhaustion a skos:Concept ;
    skos:broader eusoilvoc:SoilDeficiencies ;
    skos:exactMatch agrovoc:c_26857,
        nalt:967 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil exhaustion"@en .

eusoilvoc:SoilExposureTypes a skos:Concept ;
    skos:broader eusoilvoc:SoilInvestigations ;
    skos:definition [ dcterms:source agrovoc:c_378b6841 ;
            rdf:value "Type of soil exposure (e.g. soil pit or soil core), to perform soil surveys in the field"@en ] ;
    skos:exactMatch agrovoc:c_378b6841 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil exposure types"@en .

eusoilvoc:SoilFilteringCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilChemicalCapacity ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ability of soil to remove pollutants from percolating water by denaturing pollutants or mechanically sieving suspended particles."@en ] ;
    skos:exactMatch spp:SoilFilteringCapacity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil filtering capacity"@en .

eusoilvoc:SoilFlocculation a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProcesses ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The sticking together of colloidal soil particles into loose, irregular clusters called floccules, also termed coagulation."@en ] ;
    skos:exactMatch spp:SoilFlocculation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil flocculation"@en .

eusoilvoc:SoilFlow a skos:Concept ;
    skos:broader eusoilvoc:SoilFailure ;
    skos:exactMatch spp:SoilFlow ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil flow"@en .

eusoilvoc:SoilFluid a skos:Concept ;
    skos:broader eusoilvoc:SoilComponents ;
    skos:exactMatch spp:SoilFluid ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil fluid"@en .

