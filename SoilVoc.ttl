    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "In particle-size analysis, the settling of soil particles through a liquid at rates that depend on particle size and the properties of the liquid."@en ] ;
    skos:exactMatch spp:SoilSedimentation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil sedimentation"@en .

