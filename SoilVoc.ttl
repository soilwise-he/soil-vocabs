    skos:exactMatch agrovoc:c_24138 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "neutral soils"@en .

eusoilvoc:Nickel a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:exactMatch agrovoc:c_5172,
        inrae:c_727,
        gemet:5589,
        nalt:54803,
        she:Nickel ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "nickel"@en .

eusoilvoc:NitosolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:definition [ dcterms:source <https://www.fao.org/soils-portal/data-hub/soil-classification/fao-legend/key-to-the-fao-soil-units/en/> ;
            rdf:value "Other soils having an argillic B horizon with a clay distribution where the percentage of clay does not decrease from its maximum amount by as much as 20 percent within 150 cm of the surface; lacking plinthite within 125 cm of the surface; lacking vertic and ferric properties."@en ] ;
    skos:exactMatch agrovoc:c_5185 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Nitosols"@en .

eusoilvoc:NitosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:closeMatch agrovoc:c_5185 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Nitosols"@en ;
    skos:scopeNote "AGROVOC places this source under WRB soil types but mixes the preferred label Nitosols with a Nitisols definition. Retained as a WRB-scoped source concept with closeMatch; the mixed definition is omitted. It is not asserted equivalent to a historical FAO Nitosols group."@en .

