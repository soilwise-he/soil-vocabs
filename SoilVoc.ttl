    skos:exactMatch spp:MulchFarming ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "mulch farming"@en .

eusoilvoc:Mulching a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Covering the soil surface with material, such as a vapor barrier or reflective material, to modify conditions at the surface."@en ] ;
    skos:exactMatch agrovoc:c_4978,
        spp:Mulching,
        inrae:c_1940,
        nalt:28619 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "mulching"@en .

eusoilvoc:Nanoplastics a skos:Concept ;
    skos:broader eusoilvoc:Microplastics ;
    skos:definition [ dcterms:source agrovoc:c_f5ac9b8e ;
            rdf:value "Plastic particles of size ranging from 1 to 100 nanometres (nm) (0.001 µm-0.1 µm)."@en ] ;
    skos:exactMatch agrovoc:c_f5ac9b8e,
        nalt:323563 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "nanoplastics"@en .

