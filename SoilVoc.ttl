            rdf:value "The spontaneous movement of dissolved ions and molecules through soil due to random thermal motion, tending to reduce concentration gradients."@en ] ;
    skos:exactMatch spp:SoilSoluteDiffusiveTransport ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
