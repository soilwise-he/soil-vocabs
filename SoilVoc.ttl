        eusoilvoc:SoilWaterPhysicalProcesses ;
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Holding of water in soil pores and on soil particles by forces of cohesion and adhesion, with surface tension, capillarity and osmotic pressure contributing to that holding."@en ] ;
