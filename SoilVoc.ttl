eusoilvoc:Pedon a skos:Concept ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source agrovoc:c_7f60f575 ;
            rdf:value "A pedon is a three-dimensional body of soil that has sufficient area (roughly 1 to 10 m2) and depth (up to 200 cm) to be used in describing the internal arrangement of horizons and in collecting representative samples for laboratory analysis."@en ] ;
    skos:exactMatch agrovoc:c_7f60f575 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "pedon"@en .

