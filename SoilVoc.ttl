eusoilvoc:Bioturbation a skos:Concept ;
    skos:broader eusoilvoc:Pedoturbation,
        eusoilvoc:SoilBiologicalProcesses ;
    skos:definition [ dcterms:source agrovoc:c_a3354940 ;
            rdf:value "Bioturbation is the biogenic transport of sediment or soil particles and pore water which destroys sediment or soil stratigraphy, changes rates of chemical reactions and sediment/soil-water exchange, and modifies sediment/soil physical properties such as grain size, porosity, and permeability."@en ] ;
    skos:exactMatch agrovoc:c_a3354940,
        nalt:957,
        she:Bioturbation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bioturbation"@en .

