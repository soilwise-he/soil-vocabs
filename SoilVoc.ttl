    skos:broader eusoilvoc:SoilParticles ;
    skos:definition [ dcterms:source glosis_cl:physioChemicalPropertyCode-CoaFra ;
            rdf:value "Coarse fragments are soil particles larger than 2 mm in diameter, such as gravel, cobbles, and stones. They affect soil porosity, water infiltration, and root penetration. Source: Soil Survey Staff (2014). Keys to Soil Taxonomy."@en ] ;
