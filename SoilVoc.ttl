eusoilvoc:SoilCompaction a skos:Concept ;
    skos:broader eusoilvoc:SoilCompression,
        eusoilvoc:SoilDegradation,
        eusoilvoc:SoilPhysicalDegradativeProcesses,
        eusoilvoc:SoilThreats ;
