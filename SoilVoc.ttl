    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A passive mixing process in soil that tends to even out solute concentration gradients, described as hydrodynamic dispersion."@en ] ;
    skos:exactMatch spp:SoilSoluteDispersion ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
