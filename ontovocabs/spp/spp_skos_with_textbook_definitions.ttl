    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:LongitudinalDispersion,
        eusoilvoc:TransverseDispersion ;
    skos:prefLabel "soil solute dispersive transport"@en .

eusoilvoc:SoilSolutes a skos:Concept ;
    # Scope qualification: The chapter uses solutes broadly and lists transported materials including pathogens. The candidate follows that usage rather than silently imposing a narrower chemical-only sense.
    # Index-guided textbook definition: printed page(s) 433, 434; supported_paraphrase.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "In the textbook's soil-water transport context, substances dissolved or carried in soil water, such as salts, fertilizers, and pesticides, that may remain physically and chemically unchanged or undergo reactions and changes of phase within the soil."@en ] ;
    skos:altLabel "soil solute"@en ;
    skos:broader eusoilvoc:SoilComponents ;
