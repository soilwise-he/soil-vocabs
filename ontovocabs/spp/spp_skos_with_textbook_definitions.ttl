    # Textbook definition: audited printed page(s) 600; source term spp:SoilHydrophobicity.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The water-repellent or non-wetting condition of soil in which soil particles repel water and the soil has a reduced affinity for water."@en ] ;
    skos:broader eusoilvoc:SoilPhenomena ;
    skos:exactMatch spp:SoilHydrophobicity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil hydrophobicity"@en .

