eusoilvoc:SoilHeatTransport a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 490, 498; supported_paraphrase.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The transfer of thermal energy through soil by conduction, convection, or radiation, with conduction and convection identified as the principal transport processes within the soil matrix."@en ] ;
    skos:broader eusoilvoc:SoilHeatMovement ;
    skos:exactMatch spp:SoilHeatTransport ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
