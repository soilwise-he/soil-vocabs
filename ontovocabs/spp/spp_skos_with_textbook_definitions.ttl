@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eusoilvoc: <https://w3id.org/eusoilvoc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spp: <http://imash.leeds.ac.uk/ontologies/atu/SoilPhysics.owl#> .

eusoilvoc:Crop a skos:Concept ;
    skos:broader eusoilvoc:PlantCover ;
    skos:exactMatch spp:Crop ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "crop"@en .

eusoilvoc:Earthworms a skos:Concept ;
    skos:altLabel "earthworm"@en ;
    skos:broader eusoilvoc:SoilMacrofauna ;
    skos:definition [ dcterms:source spp:Earthworm ;
            rdf:value "A burrowing annelid worm that lives in the soil, important in aerating and draining the soil and in burying organic matter."@en ] ;
    skos:exactMatch spp:Earthworm ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "earthworms"@en .

eusoilvoc:GroundCover a skos:Concept ;
    skos:broader eusoilvoc:LandCover ;
    skos:exactMatch spp:GroundCover ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ground cover"@en .

eusoilvoc:Microbes a skos:Concept ;
    skos:altLabel "microbe"@en ;
    skos:broader eusoilvoc:SoilOrganisms ;
    skos:exactMatch spp:Microbe ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "microbes"@en .

eusoilvoc:Salts a skos:Concept ;
    skos:altLabel "salt"@en ;
    skos:broader eusoilvoc:SoilChemical ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "salts"@en .

eusoilvoc:SoilFluidRetention a skos:Concept ;
    skos:broader eusoilvoc:SoilRetention,
        eusoilvoc:SoilWaterPhysicalProcesses ;
    skos:exactMatch spp:SoilFluidRetention ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil fluid retention"@en .

eusoilvoc:SoilFluidTransport a skos:Concept ;
    skos:broader eusoilvoc:SoilTransport,
        eusoilvoc:SoilWaterPhysicalProcesses ;
    skos:exactMatch spp:SoilFluidTransport ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil fluid transport"@en .

eusoilvoc:SoilFormation a skos:Concept ;
    skos:broader eusoilvoc:SoilPhysicalProcesses ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil formation"@en .

eusoilvoc:SoilNutrientRetention a skos:Concept ;
    skos:broader eusoilvoc:SoilRetention ;
    skos:exactMatch spp:SoilNutrientRetention ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil nutrient retention"@en .

eusoilvoc:SoilOrganicMatter a skos:Concept ;
    # Textbook definition: audited printed page(s) 72; source term spp:SoilOrganicMatter.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A complex mixture of living and dead substances of plant and animal origin in soil."@en ] ;
    skos:broader eusoilvoc:SoilOrganicComponents ;
    skos:exactMatch spp:SoilOrganicMatter ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil organic matter"@en .

eusoilvoc:SoilParticleMovement a skos:Concept ;
    skos:broader eusoilvoc:SoilMovement ;
    skos:exactMatch spp:SoilParticleMovement ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil particle movement"@en .

eusoilvoc:SoilSolidTransport a skos:Concept ;
    skos:broader eusoilvoc:SoilTransport ;
    skos:exactMatch spp:SoilSolidTransport ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil solid transport"@en .

eusoilvoc:SoilWaterAdsorption a skos:Concept ;
    # Scope qualification: The passage concerns clay surfaces; retain that material scope.
    # Index-guided textbook definition: printed page(s) 65; supported_paraphrase.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Attachment of water molecules to clay surfaces, where they may be held by hydrogen bonding or electrostatic attraction; the water so held is termed adsorbed water."@en ] ;
    skos:broader eusoilvoc:SoilAdsorption ;
    skos:exactMatch spp:SoilWaterAdsorption ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water adsorption"@en .

eusoilvoc:SoilWaterRetention a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 268; supported_paraphrase.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Holding of water in soil pores and on soil particles by forces of cohesion and adhesion, with surface tension, capillarity and osmotic pressure contributing to that holding."@en ] ;
    skos:broader eusoilvoc:SoilRetention,
        eusoilvoc:SoilWaterPhysicalProcesses ;
    skos:exactMatch spp:SoilWaterRetention ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil water retention"@en .

eusoilvoc:Termites a skos:Concept ;
    skos:altLabel "termite"@en ;
    skos:broader eusoilvoc:SoilMacrofauna ;
    skos:exactMatch spp:Termite ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "termites"@en .

eusoilvoc:AerationPorosity a skos:Concept ;
    # Textbook definition: audited printed page(s) 522; source term spp:AerationPorosity.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The pore space filled with air when a soil sample is placed on a porous plate and equilibrated at 50 cm of suction."@en ] ;
    skos:broader eusoilvoc:SoilPorosityIndex ;
    skos:exactMatch spp:AerationPorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "aeration porosity"@en .

eusoilvoc:AggregatedSiltClay a skos:Concept ;
    # Textbook definition: audited printed page(s) 123; source term spp:AggregatedSiltClay.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil aggregation calculated as the actual silt-plus-clay percentage determined with dispersion minus the percentage in suspension determined without dispersion."@en ] ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:AggregatedSiltClay ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "aggregated silt clay"@en .

eusoilvoc:AgriculturalSustainability a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 6; explicit_text.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Non-negative trends in agricultural productivity while preserving the resource base and maintaining environmental quality."@en ] ;
    skos:broader eusoilvoc:SoilAgriculturalFunctions ;
    skos:exactMatch spp:AgriculturalSustainability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agricultural sustainability"@en .

eusoilvoc:AirFilledPorosity a skos:Concept ;
    # Textbook definition: audited printed page(s) 21; source term spp:AirFilledPorosity.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ratio of the volume of air in soil pores to the total soil volume; it is also equal to total porosity minus volumetric soil moisture content."@en ] ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:exactMatch spp:AirFilledPorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "air filled porosity"@en .

eusoilvoc:AirPorosity a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 20, 21; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The volume of air-filled pores divided by the total soil volume; equivalently, total porosity minus volumetric water content."@en ] ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:exactMatch spp:AirPorosity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "air porosity"@en .

eusoilvoc:AirQuality a skos:Concept ;
    skos:broader eusoilvoc:SoilEnvironmentalFunctions ;
    skos:exactMatch spp:AirQuality ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "air quality"@en .

eusoilvoc:AirRatio a skos:Concept ;
    # Textbook definition: audited printed page(s) 21; source term spp:AirRatio.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The ratio of the volume of air in a soil to the volume of its solids."@en ] ;
    skos:broader eusoilvoc:SoilPorosity ;
    skos:exactMatch spp:AirRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "air ratio"@en .

eusoilvoc:AntecedentSoilMoistureContents a skos:Concept ;
    # Textbook definition: audited printed page(s) 158; source term spp:AntecedentSoilMoistureContent.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The wetness of a soil at the beginning of a rainfall event."@en ] ;
    skos:altLabel "antecedent soil moisture content"@en ;
    skos:broader eusoilvoc:SoilMoistureContents ;
    skos:definition [ dcterms:source spp:AntecedentSoilMoistureContent ;
            rdf:value "the moisture content of soil profile before rainfall or irrigation begins"@en ] ;
    skos:exactMatch spp:AntecedentSoilMoistureContent ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "antecedent soil moisture contents"@en .

eusoilvoc:Biochannel a skos:Concept ;
    skos:broader eusoilvoc:SoilPores ;
    skos:exactMatch spp:Biochannel ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biochannel"@en .

eusoilvoc:BiologicalNitrogenFixation a skos:Concept ;
    # Textbook definition: audited printed page(s) 516; source term spp:BiologicalNitrogenFixation.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The process by which bacteria absorb nitrogen gas from the air and convert it to ammonium that plants can use."@en ] ;
    skos:broader eusoilvoc:SoilBiologicalProcesses ;
    skos:exactMatch spp:BiologicalNitrogenFixation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biological nitrogen fixation"@en .

eusoilvoc:Building a skos:Concept ;
    skos:broader eusoilvoc:LandCover ;
    skos:exactMatch spp:Building ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "building"@en .

eusoilvoc:BuildingStability a skos:Concept ;
    skos:broader eusoilvoc:SoilEngineeringFunctions ;
    skos:exactMatch spp:BuildingStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "building stability"@en .

eusoilvoc:CationExchange a skos:Concept ;
    skos:broader eusoilvoc:IonExchange ;
    skos:exactMatch spp:CationExchange ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cation exchange"@en .

eusoilvoc:CationExchangeCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilChemicalCapacity ;
    skos:exactMatch spp:CationExchangeCapacity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cation exchange capacity"@en .

eusoilvoc:Clay a skos:Concept ;
    # Textbook definition: audited printed page(s) 31; source term spp:Clay.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The fine, reactive soil-particle fraction consisting of particles less than 0.002 mm in diameter."@en ] ;
    skos:broader eusoilvoc:SoilPrimaryParticles ;
    skos:exactMatch spp:Clay ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "clay"@en .

eusoilvoc:ClayRatio a skos:Concept ;
    # Textbook definition: audited printed page(s) 123; source term spp:ClayRatio.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index, also called the mechanical ratio, equal to the sand content divided by the combined silt and clay content."@en ] ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:ClayRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "clay ratio"@en .

eusoilvoc:Climate a skos:Concept ;
    skos:broader eusoilvoc:PlanetaryPhenomena ;
    skos:exactMatch spp:Climate ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "climate"@en .

eusoilvoc:CoarseSand a skos:Concept ;
    skos:broader eusoilvoc:Sand ;
    skos:exactMatch spp:CoarseSand ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coarse sand"@en .

eusoilvoc:ColloidContentMoistureEquivalentRatio a skos:Concept ;
    # Textbook definition: audited printed page(s) 123; source term spp:ColloidContentMoistureEquivalentRatio.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil erodibility given by the ratio of soil colloid content to moisture equivalent. Colloid content is the combined percentage of clay and organic matter, and moisture equivalent is the soil moisture content retained under a centrifugal force of 1000 times gravity."@en ] ;
    skos:broader eusoilvoc:SoilErodibilityIndex ;
    skos:exactMatch spp:ColloidContentMoistureEquivalentRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "colloid content moisture equivalent ratio"@en .

eusoilvoc:ConservationTillage a skos:Concept ;
    # Textbook definition: audited printed page(s) 427; source term spp:ConservationTillage.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Tillage that leaves a high percentage of residues from previous crops on the soil surface."@en ] ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:exactMatch spp:ConservationTillage ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "conservation tillage"@en .

eusoilvoc:ConservativeSolutes a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 433; explicit_text.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Solutes that remain physically and chemically unchanged and do not undergo irreversible reactions."@en ] ;
    skos:altLabel "conservative solute"@en ;
    skos:broader eusoilvoc:SoilSolutes ;
    skos:exactMatch spp:ConservativeSolute ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "conservative solutes"@en .

eusoilvoc:ControlledDrainage a skos:Concept ;
    # Textbook definition: audited printed page(s) 545; source term spp:ControlledDrainage.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "A drainage system in which a control device intercepts water outflow to maintain the water table at a specified level below the soil surface."@en ] ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:exactMatch spp:ControlledDrainage ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "controlled drainage"@en .

eusoilvoc:ConventionalDrainage a skos:Concept ;
    # Textbook definition: audited printed page(s) 544; source term spp:ConventionalDrainage.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Removal of excess water from the soil profile through perforated subsurface drainage pipes or tiles that discharge by gravity into a ditch or stream."@en ] ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:exactMatch spp:ConventionalDrainage ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "conventional drainage"@en .

eusoilvoc:CriticalSoilOrganicMatterContents a skos:Concept ;
    skos:altLabel "critical soil organic matter content"@en ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:CriticalSoilOrganicMatterContent ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "critical soil organic matter contents"@en .

eusoilvoc:CropResidueMulch a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 115, 421; supported_paraphrase.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Crop residues placed on the soil surface as a covering to reduce evaporation, control weeds, and improve the soil environment."@en ] ;
    skos:broader eusoilvoc:Mulch ;
    skos:exactMatch spp:CropResidueMulch ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "crop residue mulch"@en .

eusoilvoc:CropYield a skos:Concept ;
    skos:broader eusoilvoc:SoilAgriculturalFunctions ;
    skos:exactMatch spp:CropYield ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "crop yield"@en .

eusoilvoc:DegreeOfSaturation a skos:Concept ;
    # Textbook definition: audited printed page(s) 21; source term spp:DegreeOfSaturation.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The volume of soil pore space containing water or another liquid divided by the total pore volume, expressed as a fraction or percentage."@en ] ;
    skos:broader eusoilvoc:SoilMoistureContents ;
    skos:exactMatch spp:DegreeOfSaturation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "degree of saturation"@en .

eusoilvoc:DispersionRatio a skos:Concept ;
    # Textbook definition: audited printed page(s) 121; source term spp:DispersionRatio.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index measuring the clay fraction present in a dispersed rather than an aggregated condition."@en ] ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:DispersionRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dispersion ratio"@en .

eusoilvoc:DrainageToGroundwater a skos:Concept ;
    # Textbook definition: audited printed page(s) 395; source term spp:DrainageToGroundwater.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Continued downward movement of water through the soil profile after infiltration has ceased, where a shallow water table is present."@en ] ;
    skos:broader eusoilvoc:SoilPhenomena ;
    skos:exactMatch spp:DrainageToGroundwater ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "drainage to groundwater"@en .

eusoilvoc:DrySoilBulkDensity a skos:Concept ;
    # Textbook definition: audited printed page(s) 18; source term spp:DrySoilBulkDensity.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The mass of soil solids, excluding water, divided by the total volume of the soil."@en ] ;
    skos:broader eusoilvoc:SoilBulkDensity ;
    skos:exactMatch spp:DrySoilBulkDensity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dry soil bulk density"@en .

eusoilvoc:ErosionRatio a skos:Concept ;
    # Textbook definition: audited printed page(s) 124; source term spp:ErosionRatio.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil erodibility calculated as the dispersion ratio divided by the ratio of colloid content to moisture equivalent."@en ] ;
    skos:broader eusoilvoc:SoilErodibilityIndex ;
    skos:exactMatch spp:ErosionRatio ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "erosion ratio"@en .

eusoilvoc:Evapotranspiration a skos:Concept ;
    skos:broader eusoilvoc:WaterInterchange ;
    skos:exactMatch spp:Evapotranspiration ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "evapotranspiration"@en .

eusoilvoc:ExchangeableCations a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 50, 221; supported_paraphrase.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Cations associated with charged soil-mineral surfaces that can be exchanged with cations in the soil solution."@en ] ;
    skos:altLabel "exchangeable cation"@en ;
    skos:broader eusoilvoc:Ions ;
    skos:exactMatch spp:ExchangeableCation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "exchangeable cations"@en .

eusoilvoc:FertiliserUse a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:exactMatch spp:FertilizerUse ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fertiliser use"@en .

eusoilvoc:FineSand a skos:Concept ;
    skos:broader eusoilvoc:Sand ;
    skos:exactMatch spp:FineSand ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fine sand"@en .

eusoilvoc:Floods a skos:Concept ;
    skos:altLabel "flood"@en ;
    skos:broader eusoilvoc:Inundation ;
    skos:exactMatch spp:Flood ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "floods"@en .

eusoilvoc:FluxControlledWaterInfiltration a skos:Concept ;
    # Textbook definition: audited printed page(s) 378; source term spp:FluxControlledWaterInfiltration.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Water infiltration in which the water-supply rate determines the infiltration rate because water is applied more slowly than the soil's instantaneous infiltration rate."@en ] ;
    skos:broader eusoilvoc:SoilWaterInfiltration ;
    skos:exactMatch spp:FluxControlledWaterInfiltration ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "flux controlled water infiltration"@en .

eusoilvoc:Fog a skos:Concept ;
    skos:broader eusoilvoc:Precipitation ;
    skos:exactMatch spp:Fog ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fog"@en .

eusoilvoc:FoundationStability a skos:Concept ;
    skos:broader eusoilvoc:SoilEngineeringFunctions ;
    skos:exactMatch spp:FoundationStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "foundation stability"@en .

eusoilvoc:FoundationStrength a skos:Concept ;
    skos:broader eusoilvoc:SoilEngineeringFunctions ;
    skos:exactMatch spp:FoundationStrength ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "foundation strength"@en .

eusoilvoc:FriableConsistence a skos:Concept ;
    # Textbook definition: audited printed page(s) 215; source term spp:FriableConsistence.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The condition of a soil that easily crumbles into granules or crumbs."@en ] ;
    skos:broader eusoilvoc:SoilConsistence ;
    skos:exactMatch spp:FriableConsistence ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "friable consistence"@en .

eusoilvoc:GeometricMeanDiametre a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 122; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An aggregate-size index calculated as GMD = exp[sum(wi log xi) / sum(wi)], where xi is the mean diameter of a size class and wi is the aggregate mass in that class."@en ] ;
    skos:broader eusoilvoc:SoilAggregationIndex ;
    skos:exactMatch spp:GeometricMeanDiameter ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "geometric mean diametre"@en .

eusoilvoc:Grasses a skos:Concept ;
    skos:altLabel "grass"@en ;
    skos:broader eusoilvoc:Vegetation ;
    skos:exactMatch spp:Grass ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "grasses"@en .

eusoilvoc:Hail a skos:Concept ;
    skos:broader eusoilvoc:Precipitation ;
    skos:exactMatch spp:Hail ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hail"@en .

eusoilvoc:HarshConsistence a skos:Concept ;
    # Textbook definition: audited printed page(s) 215; source term spp:HarshConsistence.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The hard, highly cohesive consistence of dry soil that feels harsh to the touch."@en ] ;
    skos:broader eusoilvoc:SoilConsistence ;
    skos:exactMatch spp:HarshConsistence ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "harsh consistence"@en .

eusoilvoc:IndexBasedOnTextureAndCementingAgents a skos:Concept ;
    # Textbook definition: audited printed page(s) 125; source term spp:IndexBasedOnTextureAndCementingAgents.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An instability index for tropical soils calculated as I_s = (A + L_F)_max / (A_g/3 − 0.9S_G). The numerator is the maximum dispersed fraction obtained from an air-dried sample and samples immersed in alcohol or benzene; A_g is the aggregate content obtained after shaking and wet sieving the three treated samples, and S_G is the coarse mineral sand content."@en ] ;
    skos:altLabel "index based on texture and cementing agent"@en ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:IndexBasedOnTextureAndCementingAgents ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index based on texture and cementing agents"@en .

eusoilvoc:IndexOfCrusting a skos:Concept ;
    # Textbook definition: audited printed page(s) 125; source term spp:IndexOfCrusting.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index based on soil texture and organic matter, calculated as Ic = (1.5 Sf + 0.75 Sc) / (Cl + 10 SOM), where Sf, Sc, Cl, and SOM are the percentages of fine silt, coarse silt, clay, and soil organic matter, respectively."@en ] ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:IndexOfCrusting ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of crusting"@en .

eusoilvoc:IndexOfErodibility a skos:Concept ;
    # Textbook definition: audited printed page(s) 124; source term spp:IndexOfErodibility.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil erodibility defined as Ie = 1/(Ir × k), where Ir is the index of resistance and k is permeability."@en ] ;
    skos:broader eusoilvoc:SoilErodibilityIndex ;
    skos:exactMatch spp:IndexOfErodibility ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of erodibility"@en .

eusoilvoc:IndexOfResistance a skos:Concept ;
    # Textbook definition: audited printed page(s) 124; source term spp:IndexOfResistance.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of resistance to water erosion calculated as soil bulk density multiplied by the range of particle sizes and divided by soil moisture content."@en ] ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:IndexOfResistance ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of resistance"@en .

eusoilvoc:IndexOfStructuralStability a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 124, 125; supported_paraphrase.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "An index of soil structural stability based on the rate of change in the concentration of stabilizing material, such as humic fractions or organo-mineral complexes."@en ] ;
    skos:broader eusoilvoc:SoilStructureIndirectIndex ;
    skos:exactMatch spp:IndexOfStructuralStability ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "index of structural stability"@en .

