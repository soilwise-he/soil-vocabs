eusoilvoc:SoilHydraulicDiffusivity a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 360, 361; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The soil-water flow coefficient D(θ) = K(θ)dΦm/dθ used in the diffusivity form of Richards’ equation, where K(θ) is hydraulic conductivity, θ is soil moisture content, and Φm is matric potential or suction; the formulation requires a unique moisture-potential relation without hysteresis."@en ] ;
    skos:broader eusoilvoc:SoilPhysicalProperties ;
    skos:exactMatch spp:SoilHydraulicDiffusivity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil hydraulic diffusivity"@en .

eusoilvoc:SoilHydraulicGradient a skos:Concept ;
    # Index-guided textbook definition: printed page(s) 333, 355; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The difference in hydraulic head between two positions in a soil divided by the distance along the flow path between them; for a soil column it is (Hi − Ho)/L, where Hi and Ho are inlet and outlet heads and L is column length."@en ] ;
    skos:broader eusoilvoc:SoilWaterTransmissionIndex ;
    skos:exactMatch spp:SoilHydraulicGradient ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil hydraulic gradient"@en .

