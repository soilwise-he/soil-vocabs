eusoilvoc:SoilSorption a skos:Concept ;
    # Scope qualification: Operational breakthrough-curve characterization, not a general chemical definition or an unconditional synonym for adsorption.
    # Index-guided textbook definition: printed page(s) 444; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
