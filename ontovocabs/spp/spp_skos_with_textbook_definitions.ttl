eusoilvoc:SoilRelativeDensity a skos:Concept ;
    # Scope qualification: Two incompatible senses are explicitly defined. No single candidate is selected; the two alternatives must remain distinct.
    # Index-guided textbook definition: printed page(s) 19; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "In the specific gravity sense, the dimensionless ratio of soil particle density to water density, Gs = ρs/ρw."@en ] ;
    # Index-guided textbook definition: printed page(s) 194; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "In the packing-relative density sense, Rd = (emax - e)/(emax - emin), where e is the in-situ soil void ratio, emax the void ratio of the loose state attainable in the laboratory, and emin the void ratio of the densest state."@en ] ;
    skos:broader eusoilvoc:SoilDensity,
        eusoilvoc:SoilStrengthIndex ;
    skos:exactMatch spp:SoilRelativeDensity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil relative density"@en .

