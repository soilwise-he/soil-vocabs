eusoilvoc:SoilCompaction a skos:Concept ;
    # Textbook definition: audited printed page(s) 188, 191; source term spp:SoilCompaction.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Compression and deformation of an unsaturated soil mass into a smaller volume, decreasing total porosity and macroporosity; the volume decrease occurs primarily through expulsion or compression of soil air."@en ] ;
    skos:broader eusoilvoc:SoilCompression,
        eusoilvoc:SoilPhysicalDegradativeProcesses ;
    skos:exactMatch spp:SoilCompaction ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil compaction"@en .

eusoilvoc:SoilCracking a skos:Concept ;
    # Textbook definition: audited printed page(s) 172; source term spp:SoilCracking.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "Soil failure through crack formation, occurring when the energy released by a crack exceeds the increase in surface energy associated with the new surfaces."@en ] ;
    skos:broader eusoilvoc:SoilFailure,
        eusoilvoc:SoilPhysicalProcesses ;
    skos:exactMatch spp:SoilCracking ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil cracking"@en .

eusoilvoc:SoilCrustFormation a skos:Concept ;
    # Textbook definition: audited printed page(s) 159; source term spp:SoilCrustFormation.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The process in which soil aggregates disperse, followed by particle orientation and hardening through desiccation to form a crust."@en ] ;
    skos:broader eusoilvoc:SoilChemicalDegradativeProcesses,
        eusoilvoc:SoilPhysicalDegradativeProcesses ;
    skos:exactMatch spp:SoilCrustFormation ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crust formation"@en .

eusoilvoc:SoilCrusting a skos:Concept ;
    # Textbook definition: audited printed page(s) 153; source term spp:SoilCrusting.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The formation of a thin soil-surface crust through disruption of aggregates at the soil-air interface, followed by dispersion, particle reorientation, and drying or desiccation."@en ] ;
    skos:broader eusoilvoc:SoilChemicalDegradativeProcesses,
        eusoilvoc:SoilPhysicalDegradativeProcesses ;
    skos:exactMatch spp:SoilCrusting ;
