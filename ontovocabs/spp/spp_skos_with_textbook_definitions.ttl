eusoilvoc:SoilCrustStrength a skos:Concept ;
    # Scope qualification: The candidate is tied to the modulus-of-rupture measurement; the book also discusses other crust-strength measurement methods.
    # Index-guided textbook definition: printed page(s) 164, 186; operational_or_formula.
    skos:definition [ dcterms:source <https://doi.org/10.4324/9780203021231> ;
            rdf:value "The breaking strength of a soil crust, operationally assessed by the modulus of rupture: the maximum force per unit area that a soil specimen prepared to simulate crust formation can withstand without breaking. For a rectangular briquette, the modulus of rupture is 3Fl/(2bd²), where F is the failure force, l the briquette length, b its breadth, and d its thickness."@en ] ;
    skos:broader eusoilvoc:SoilCrustPhysicalProperties ;
    skos:exactMatch spp:SoilCrustStrength ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil crust strength"@en .

