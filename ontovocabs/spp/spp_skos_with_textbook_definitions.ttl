    skos:exactMatch spp:SoilElasticity ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "soil elasticity"@en .

eusoilvoc:SoilElectricalCapacitance a skos:Concept ;
    # Scope qualification: The ratio describes a capacitor measurement with moist soil in its dielectric; it is not presented as a geometry-independent soil constant.
