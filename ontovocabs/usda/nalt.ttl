eusoilvoc:AcceleratedErosion a skos:Concept ;
    skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source nalt:225015 ;
            rdf:value "Erosion much more rapid than normal erosion, natural erosion, or geologic erosion, and occurring primarily as a result of the influence of the activities of man or, in some cases, of other animals or natural catastrophes that expose bare surfaces (for example, fires)."@en ] ;
    skos:exactMatch nalt:225015 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "accelerated erosion"@en .

eusoilvoc:GullyErosion skos:broader eusoilvoc:WaterErosion ;
    skos:exactMatch nalt:44106 .

eusoilvoc:InterrillErosion skos:broader eusoilvoc:WaterErosion ;
    skos:exactMatch nalt:47543 .

eusoilvoc:RillErosion skos:broader eusoilvoc:WaterErosion ;
    skos:definition [ dcterms:source nalt:61575 ;
            rdf:value "The process by which numerous small channels, at the most only several inches deep, are formed on recently cultivated or exposed soils."@en ] ;
    skos:exactMatch nalt:61575 .

eusoilvoc:SheetErosion a skos:Concept ;
    skos:broader eusoilvoc:WaterErosion ;
    skos:definition [ dcterms:source nalt:62999 ;
            rdf:value "Soil erosion occurring from a thin, relatively uniform layer of soil particles on the soil surface."@en ] ;
    skos:exactMatch nalt:62999 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "sheet erosion"@en .

eusoilvoc:SoilErosion skos:closeMatch nalt:501 ;
    skos:narrower eusoilvoc:AcceleratedErosion,
        eusoilvoc:TillageErosion,
        eusoilvoc:WaterErosion,
        eusoilvoc:WindErosion .

eusoilvoc:SplashErosion a skos:Concept ;
    skos:broader eusoilvoc:WaterErosion ;
    skos:definition [ dcterms:source nalt:63944 ;
            rdf:value "The spattering of small soil particles caused by the impact of raindrops on wet soils. The loosened and spattered particles may or may not be subsequently removed by surface runoff."@en ] ;
    skos:exactMatch nalt:63944 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "splash erosion"@en .

eusoilvoc:TillageErosion skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source nalt:266421 ;
            rdf:value "The downslope movement of soil by tillage operations."@en ] ;
    skos:exactMatch nalt:266421 .

eusoilvoc:WaterErosion skos:broader eusoilvoc:SoilErosion ;
    skos:closeMatch nalt:15764 ;
    skos:narrower eusoilvoc:GullyErosion,
        eusoilvoc:InterrillErosion,
        eusoilvoc:RillErosion,
        eusoilvoc:SheetErosion,
        eusoilvoc:SplashErosion .

eusoilvoc:WindErosion skos:broader eusoilvoc:SoilErosion ;
    skos:definition [ dcterms:source nalt:63376 ;
            rdf:value "The process of detachment, transport, and deposition of soil by wind."@en ] ;
    skos:exactMatch nalt:63376 .
