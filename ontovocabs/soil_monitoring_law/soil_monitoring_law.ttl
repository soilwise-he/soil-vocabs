    bao:BAO_0002586 eusoilvoc:SoilSealing ;
    skos:broader eusoilvoc:SoilIndicators ;
    skos:prefLabel "mean annual net sealing area"@en .

eusoilvoc:MeanAnnualNetSealingShareOfMemberStateArea a skos:Concept,
