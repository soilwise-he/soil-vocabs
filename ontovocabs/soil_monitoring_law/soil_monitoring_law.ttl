    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:SoilDescriptor ;
    skos:prefLabel "DNA metabarcoding of soil archaea"@en .

eusoilvoc:DNAMetabarcodingOfSoilBacteria a skos:Concept ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:SoilDescriptor ;
    skos:prefLabel "DNA metabarcoding of soil bacteria"@en .

eusoilvoc:DNAMetabarcodingOfSoilFungi a skos:Concept ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:SoilDescriptor ;
    skos:prefLabel "DNA metabarcoding of soil fungi"@en .

eusoilvoc:DNAMetabarcodingOfSoilProtists a skos:Concept ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:SoilDescriptor ;
    skos:prefLabel "DNA metabarcoding of soil protists"@en .

eusoilvoc:EarthwormAbundanceInSoil a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:BiologicalAbundance,
        eusoilvoc:SoilDescriptor ;
    skos:prefLabel "earthworm abundance in soil"@en .

eusoilvoc:EarthwormDiversityInSoil a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:SoilBiologicalProperties,
        eusoilvoc:SoilDescriptor ;
    skos:prefLabel "earthworm diversity in soil"@en .

eusoilvoc:Ecosystem a skos:Concept ;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2025/2360/oj> ;
    skos:definition [ dcterms:source <https://eur-lex.europa.eu/eli/dir/2025/2360/oj> ;
            rdf:value "A dynamic complex of plant, animal and micro-organism communities and their non-living environment, interacting as a functional unit;"@en ] ;
    skos:narrower eusoilvoc:EcosystemServices ;
    skos:prefLabel "ecosystem"@en .

eusoilvoc:EcosystemServices a skos:Concept ;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2025/2360/oj> ;
    skos:altLabel "ecosystem service"@en ;
    skos:broader eusoilvoc:Ecosystem ;
    skos:closeMatch <http://opendata.inrae.fr/thesaurusINRAE/c_1611> ;
    skos:definition [ dcterms:source <https://eur-lex.europa.eu/eli/dir/2025/2360/oj> ;
            rdf:value "The direct or indirect contributions of ecosystems to the environmental, economic, social, cultural and other benefits that people derive from those ecosystems"@en ] ;
    skos:prefLabel "ecosystem services"@en .

eusoilvoc:InvasiveAlienSpeciesPresenceInSoil a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:SoilBiologicalProperties,
        eusoilvoc:SoilDescriptor ;
    skos:prefLabel "invasive alien species presence in soil"@en .

