    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    qudt:hasUnit unit:PERCENT-PER-YR ;
    bao:BAO_0002586 eusoilvoc:SoilSealing ;
    skos:broader eusoilvoc:SoilIndicators ;
    skos:prefLabel "mean annual net sealing share of Member State area"@en .

eusoilvoc:MeanAnnualSoilRemovalArea a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    qudt:hasUnit eusoilvoc:SquareKilometrePerYear ;
    bao:BAO_0002586 eusoilvoc:SoilRemoval ;
    skos:broader eusoilvoc:SoilIndicators ;
    skos:prefLabel "mean annual soil removal area"@en .

eusoilvoc:MeanAnnualSoilRemovalShareOfMemberStateArea a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    qudt:hasUnit unit:PERCENT-PER-YR ;
    bao:BAO_0002586 eusoilvoc:SoilRemoval ;
    skos:broader eusoilvoc:SoilIndicators ;
    skos:prefLabel "mean annual soil removal share of Member State area"@en .

eusoilvoc:MeanAnnualSoilSealingArea a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    qudt:hasUnit eusoilvoc:SquareKilometrePerYear ;
    bao:BAO_0002586 eusoilvoc:SoilSealing ;
    skos:broader eusoilvoc:SoilIndicators ;
    skos:prefLabel "mean annual soil sealing area"@en .

eusoilvoc:MeanAnnualSoilSealingShareOfMemberStateArea a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    qudt:hasUnit unit:PERCENT-PER-YR ;
    bao:BAO_0002586 eusoilvoc:SoilSealing ;
    skos:broader eusoilvoc:SoilIndicators ;
    skos:prefLabel "mean annual soil sealing share of Member State area"@en .

eusoilvoc:NativeAntAbundanceInSoil a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:BiologicalAbundance,
        eusoilvoc:SoilDescriptor ;
    skos:prefLabel "native ant abundance in soil"@en .

eusoilvoc:NativeAntDiversityInSoil a skos:Concept,
        sosa:ObservableProperty ;
    dcterms:source <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202502360#anx_I> ;
    bao:BAO_0002586 eusoilvoc:SoilBiodiversityLoss ;
    skos:broader eusoilvoc:SoilBiologicalProperties,
        eusoilvoc:SoilDescriptor ;
    skos:prefLabel "native ant diversity in soil"@en .

