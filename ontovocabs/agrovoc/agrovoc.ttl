    skos:definition [ dcterms:source agrovoc:c_f5fd1a6c ;
            rdf:value "Chemical analysis is the study of the chemical composition and characterization of substances."@en ] ;
    skos:exactMatch agrovoc:c_f5fd1a6c ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
