    skos:definition [ dcterms:source agrovoc:c_25068 ;
            rdf:value "Rhizobacteria are root-associated bacteria that can have a detrimental (parasitic varieties), neutral or beneficial effect on plant growth."@en ] ;
    skos:exactMatch agrovoc:c_25068 ;
