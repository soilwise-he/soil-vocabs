eusoilvoc:SoilInformation a skos:Concept ;
    skos:broader eusoilvoc:SoilDescription ;
    skos:definition [ dcterms:source agrovoc:c_109db1c5 ;
            rdf:value "Soil information is data about the physical, chemical, and biological properties of soil. This information can be used to assess soil health, fertility, and suitability for different uses."@en ] ;
    skos:exactMatch agrovoc:c_109db1c5 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:SoilMaps ;
    skos:prefLabel "soil information"@en .

