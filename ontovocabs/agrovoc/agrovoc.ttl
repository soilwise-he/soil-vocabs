    skos:broader eusoilvoc:SoilSurveys ;
    skos:definition [ dcterms:source agrovoc:c_8595c402 ;
            rdf:value "Comprise all soil studies and activities which are made in the field, such as soil sampling, description of soil horizons or soil penetration resistance measurements"@en ] ;
    skos:exactMatch agrovoc:c_8595c402 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:SoilExposureTypes ;
    skos:prefLabel "soil investigations"@en ;
    skos:scopeNote "Field studies of soil, following AGROVOC scope."@en .

