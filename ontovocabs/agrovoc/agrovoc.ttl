eusoilvoc:RegosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_6492 ;
            rdf:value "Regosols are very weakly developed mineral soils in unconsolidated materials that do not have a mollic or umbric horizon, are not very thin or very rich in coarse fragments (Leptosols), not sandy (Arenosols), and not with fluvic materials (Fluvisols). Regosols are extensive in eroding lands and accumulation zones, particularly in arid and semiarid areas and in mountainous terrain. Many Regosols correlate with soil taxa that are marked by incipient soil formation such as Entisols (United States of America), Rudosols (Australia), Regosole (Germany), Sols peu évolués régosoliques d’érosion or even Sols minéraux bruts d’apport éolien ou volcanique (France), Pelozems (Russia) and Neossolos (Brazil)."@en ] ;
    skos:exactMatch agrovoc:c_6492 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Regosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:RendzinasFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:closeMatch agrovoc:c_6501 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rendzinas"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:RepresentativeSampling a skos:Concept ;
    skos:broader eusoilvoc:SoilSampling ;
    skos:definition [ dcterms:source agrovoc:c_798574b0 ;
            rdf:value "“Representative sampling” is a type of statistical sampling that allows us to use data from a sample to make conclusions that are representative for the population from which the sample is taken."@en ] ;
    skos:exactMatch agrovoc:c_798574b0 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "representative sampling"@en .

eusoilvoc:RetisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_ff831af0 ;
            rdf:value "Retisols have a clay illuviation horizon with an interfingering of bleached coarsertextured soil material into the illuviation horizon forming a net-like pattern. The interfingering bleached coarser-textured material is characterized by a partial removal of clay and free iron oxides. There may be also bleached coarser-textured material falling from the overlying horizon into cracks in the illuvial horizon. Many Retisols correlate with the Podzoluvisols of the Soil Map of the World (FAO–UNESCO, 1971–1981). In other systems they are called Soddy-podzolic or Sodzolic soils (Russia), Fahlerden (Germany), and Glossaqualfs, Glossocryalfs and Glossudalfs (United States of America). Albeluvisols of the former editions of WRB are included in the concept of Retisols."@en ] ;
    skos:exactMatch agrovoc:c_ff831af0 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Retisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:RevisedUniversalSoilLossEquation a skos:Concept ;
    skos:broader eusoilvoc:SoilErosionModels ;
    skos:definition [ dcterms:source agrovoc:c_9021e8ed ;
            rdf:value "The potential for erosion can be calculated using the Revised Universal Soil Loss Equation (RUSLE). The equation is written as A = R x K x LS x C x P where: A = predicted soil loss R = rainfall and runoff K = soil erodibility LS = slope length and steepness C = crop management P = support practices (farming direction, strip cropping, etc.)"@en ] ;
    skos:exactMatch agrovoc:c_9021e8ed ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Revised Universal Soil Loss Equation"@en .

eusoilvoc:Rhizosphere a skos:Concept ;
    skos:broader eusoilvoc:Soil ;
    skos:definition [ dcterms:source agrovoc:c_6569 ;
            rdf:value "Rhizosphere: region of soil near the roots of growing plants."@en ] ;
    skos:exactMatch agrovoc:c_6569 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rhizosphere"@en .

eusoilvoc:RhizospherePH a skos:Concept ;
    skos:broader eusoilvoc:SoilpH ;
    skos:exactMatch agrovoc:c_36313 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rhizosphere pH"@en .

eusoilvoc:RidgeTillage a skos:Concept ;
    skos:broader eusoilvoc:ConservationTillage ;
    skos:definition [ dcterms:source agrovoc:c_25818 ;
            rdf:value "Ridge  tillage or ridge-till describes  the practice  of  forming ridges from tilled soil into which widely spaced row crops are drilled. Such ridges may remain in place for several seasons while successive crops are no-tilled into the ridges,or they might be re-formed annually."@en ] ;
    skos:exactMatch agrovoc:c_25818 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ridge tillage"@en .

eusoilvoc:RippingTillage a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_36248 ;
            rdf:value "Ripping in tillage refers to the deep mechanical loosening of soil using specialized equipment, such as rippers or subsoilers."@en ] ;
    skos:exactMatch agrovoc:c_36248 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ripping (tillage)"@en .

eusoilvoc:RiverTerraceSoils a skos:Concept ;
