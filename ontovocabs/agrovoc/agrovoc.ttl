eusoilvoc:Colluvium a skos:Concept ;
    skos:broader eusoilvoc:AnthropogenicSoils,
        eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source agrovoc:c_ce89717c ;
            rdf:value "Layered and heterogeneous sediment in local sinks or foodslopes based on relocated upslope soil material. Occurs often in agricultural landscapes.It is deposited by water and/or tillage erosion and often show higher contents in soil organic carbon."@en ] ;
    skos:exactMatch agrovoc:c_ce89717c ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "colluvium"@en .

eusoilvoc:Colorimetry a skos:Concept ;
    skos:broader eusoilvoc:SoilAnalysis ;
    skos:definition [ dcterms:source agrovoc:c_16368 ;
            rdf:value "Colorimetry is the science and technology used to quantify and describe physically the human color perception."@en ] ;
    skos:exactMatch agrovoc:c_16368 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "colorimetry"@en .

eusoilvoc:CompostMulches a skos:Concept ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_d2c183d0 ;
            rdf:value "A mulch where compost is used to cover soil surface."@en ] ;
    skos:exactMatch agrovoc:c_d2c183d0 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "compost mulches"@en .

eusoilvoc:Conductimetry a skos:Concept ;
    skos:broader eusoilvoc:SoilAnalysis ;
    skos:exactMatch agrovoc:c_28313 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "conductimetry"@en .

eusoilvoc:ConservationAgriculture a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_264f7edd ;
            rdf:value "An approach to managing agroecosystems for improved and sustained productivity, increased profits and food security, while preserving and enhancing the resource base and the environment. Conservation agriculture is characterized by three principles: continuous minimum mechanical soil disturbance, permanent organic soil cover and diversification of crop species grown in sequences or associations."@en ] ;
    skos:exactMatch agrovoc:c_264f7edd ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "conservation agriculture"@en .

eusoilvoc:ContourBunding a skos:Concept ;
    skos:broader eusoilvoc:SoilConservation ;
    skos:definition [ dcterms:source agrovoc:c_330709 ;
            rdf:value "Countour bunding is practice of building earthen  walls  or barriers built  across  a  slope  (along the  contours) to act  as a barrier  to  runoff."@en ] ;
    skos:exactMatch agrovoc:c_330709 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "contour bunding"@en .

eusoilvoc:ContourCultivation a skos:Concept ;
    skos:broader eusoilvoc:SoilConservation ;
    skos:exactMatch agrovoc:c_1837 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "contour cultivation"@en .

eusoilvoc:ControlledTrafficFarming a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_9821f1a5 ;
            rdf:value "Controlled-traffic farming (CTF) is a crop production system in which the crop zone and traffic lanes are distinctly and permanently separated. In practice, it requires: a. use of the same wheel tracks for all field operations; b. all machines to have the same wheel-track setting; c. all implements to have a particular span or multiple of it."@en ] ;
    skos:exactMatch agrovoc:c_9821f1a5 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "controlled traffic farming"@en .

eusoilvoc:ConventionalTillage a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:exactMatch agrovoc:c_34250 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "conventional tillage"@en .

eusoilvoc:CoreSampling a skos:Concept ;
    skos:broader eusoilvoc:SoilSampling ;
    skos:exactMatch agrovoc:c_57f84e25 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "core sampling"@en .

eusoilvoc:CoverPlants a skos:Concept ;
    skos:broader eusoilvoc:SoilConservation ;
    skos:definition [ dcterms:source agrovoc:c_1936 ;
            rdf:value "Crop grown during fallow periods to protect soil, recycle nutrients and control weeds."@en ] ;
    skos:exactMatch agrovoc:c_1936 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cover plants"@en .

eusoilvoc:CropResidueManagement a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_0da62559 ;
            rdf:value "The operation and management of crop land to remove stubble, stalks, and other crop residue or maintain them on the surface to prevent wind and water erosion, to conserve water, and to decrease evaporation."@en ] ;
    skos:exactMatch agrovoc:c_0da62559 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "crop residue management"@en .

eusoilvoc:CropRotation a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_6662 ;
            rdf:value "Technique of growing alternating species or families of crops in a specific field in a planned pattern or sequence."@en ] ;
    skos:exactMatch agrovoc:c_6662 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "crop rotation"@en .

eusoilvoc:CryosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_829043c3 ;
            rdf:value "Cryosols comprise mineral soils formed in a permafrost environment. The subsurface layers (cryic horizon) are permanently frozen, and if present, water occurs in the form of ice. Cryogenic processes are the dominant soil-forming processes in most Cryosols. Cryosols are widely known as Permafrost soils, Cryomorphic soils or Polar desert soils. Other common names for many Cryosols are Gelisols (United States of America) and Cryozems (Russia)."@en ] ;
    skos:exactMatch agrovoc:c_829043c3 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Cryosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:DeepPloughing a skos:Concept ;
    skos:broader eusoilvoc:Ploughing ;
    skos:definition [ dcterms:source agrovoc:c_330745 ;
            rdf:value "Mixing of loose surface material by ploughing deeper than frequently done during annual soil cultivation."@en ] ;
    skos:exactMatch agrovoc:c_330745 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "deep ploughing"@en .

eusoilvoc:DeltaSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_2169 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "delta soils"@en .

eusoilvoc:DesertSoils a skos:Concept ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_2203 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "desert soils"@en .

eusoilvoc:DifferentialThermalAnalysis a skos:Concept ;
    skos:broader eusoilvoc:ThermalAnalysis ;
    skos:definition [ dcterms:source agrovoc:c_28242 ;
            rdf:value "Differential thermal analysis (DTA) is a thermoanalytic technique that is similar to differential scanning calorimetry. In DTA, the material under study and an inert reference are made to undergo identical thermal cycles, (i.e., same cooling or heating programme) while recording any temperature difference between sample and reference."@en ] ;
    skos:exactMatch agrovoc:c_28242 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "differential thermal analysis"@en .

eusoilvoc:DigitalSoilMapping a skos:Concept ;
    skos:broader eusoilvoc:SoilSurveys ;
    skos:definition [ dcterms:source agrovoc:c_e4975629 ;
            rdf:value "Digital Soil Mapping (DSM) refers to techniques of mapping soils with mostly digital techniques, of course incorporating field (and traditional legacy soil information). DSM makes use of pedometrics which refers to the application of numerical techniques to describe and map soils. The idea is to make soil survey, classification, and land evaluation as objective as possible."@en ] ;
    skos:exactMatch agrovoc:c_e4975629 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "digital soil mapping"@en .

eusoilvoc:DioriteSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_2286 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "diorite soils"@en .

eusoilvoc:Disking a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_24454 ;
            rdf:value "Disking: Agricultural term to describe the process of using a disk, or harrow, to disturb the soil, setting back natural succession by cutting up grassy vegetation, thus preventing an area from maturing into briars, shrubs, and trees."@en ] ;
    skos:exactMatch agrovoc:c_24454 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "disking"@en .

eusoilvoc:DispersiveSoils a skos:Concept ;
    skos:broader eusoilvoc:StructuralSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_2334 ;
            rdf:value "A structurally unstable soil that disintegrates into grains of sand, silt, and clay upon contact with water and is easily eroded."@en ] ;
    skos:exactMatch agrovoc:c_2334 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dispersive soils"@en .

eusoilvoc:DissolvedOrganicCarbon a skos:Concept ;
    skos:broader eusoilvoc:SoilOrganicCarbon ;
    skos:definition [ dcterms:source agrovoc:c_02b11638 ;
            rdf:value "DOC is the in water dissolved fraction of total organic carbon of a soil or a water body. It is predominantely composed of a diverse array humic substances."@en ] ;
    skos:exactMatch agrovoc:c_02b11638 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dissolved organic carbon"@en .

