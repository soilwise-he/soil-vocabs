@prefix agrovoc: <http://aims.fao.org/aos/agrovoc/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eusoilvoc: <https://w3id.org/eusoilvoc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eusoilvoc:AridisolsUSDA skos:definition [ dcterms:source agrovoc:c_490e91f0 ;
            rdf:value "Aridisols are soils that are too dry for the growth of mesophytic plants. They are common in the deserts of the world."@en ] ;
    skos:exactMatch agrovoc:c_490e91f0 .

eusoilvoc:EntisolsUSDA skos:definition [ dcterms:source agrovoc:c_b10d627e ;
            rdf:value "Entisols are soils that show little or no evidence of pedogenic horizon development."@en ] ;
    skos:exactMatch agrovoc:c_b10d627e .

eusoilvoc:GelisolsUSDA skos:definition [ dcterms:source agrovoc:c_44ac37ac ;
            rdf:value "Gelisols, one of the 12 soil orders in the U.S. Soil Taxonomy, are characterized by permafrost conditions."@en ] ;
    skos:exactMatch agrovoc:c_44ac37ac .

eusoilvoc:InceptisolsUSDA skos:definition [ dcterms:source agrovoc:c_90831e99 ;
            rdf:value "Inceptisols are soils of semiarid to humid environments that generally exhibit only moderate degrees of soil weathering and development."@en ] ;
    skos:exactMatch agrovoc:c_90831e99 .

eusoilvoc:MollisolsUSDA skos:definition [ dcterms:source agrovoc:c_ca2631da ;
            rdf:value "Mollisols are soils that have a dark colored surface horizon relatively high in content of organic matter. The soils are base rich throughout and therefore quite fertile."@en ] ;
    skos:exactMatch agrovoc:c_ca2631da .

eusoilvoc:SoilAcidification skos:definition [ dcterms:source agrovoc:c_a97faca7 ;
            rdf:value "The lowering of the soil pH of the build-up of hydrogen and aluminium ions in the soil and the leaching of base cations such as calcium, magnesium, potassium and sodium. Soil acidification negatively affects soil fertility and compromises the production capacity of most agricultural soils."@en ] ;
    skos:exactMatch agrovoc:c_a97faca7 .

eusoilvoc:SoilGravimetricMoistureContents skos:closeMatch agrovoc:c_76b9bd59 .

eusoilvoc:SoilMacropore skos:closeMatch agrovoc:c_35318 .

eusoilvoc:SoilMicropore skos:closeMatch agrovoc:c_35319 .

eusoilvoc:SoilVolumetricMoistureContents skos:definition [ dcterms:source agrovoc:c_4b440f7a ;
            rdf:value "The volumetric water content is the volume of water per unit volume of soil, expressed as a percentage of the volume."@en ] ;
    skos:exactMatch agrovoc:c_4b440f7a .

eusoilvoc:SpodosolsUSDA skos:definition [ dcterms:source agrovoc:c_36874 ;
            rdf:value "Spodosols are acid soils characterized by a subsurface accumulation of humus that is complexed with Al and Fe."@en ] ;
    skos:exactMatch agrovoc:c_36874 .

eusoilvoc:AHorizons a skos:Concept ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:exactMatch agrovoc:c_47a98f68 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "A horizons"@en .

eusoilvoc:AcidPhosphatase a skos:Concept ;
    skos:broader eusoilvoc:Enzymes ;
    skos:definition [ dcterms:source agrovoc:c_88 ;
            rdf:value "Acid phosphatase (AP) is an enzyme that catalyzes the hydrolysis of phosphate esters in an acidic environment. This chemical reaction is essential to different metabolic processes. Therefore, AP exists in several biological kingdoms, including plants, animals, fungi, and bacteria."@en ] ;
    skos:exactMatch agrovoc:c_88 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "acid phosphatase"@en .

eusoilvoc:AcidSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_89 ;
            rdf:value "A soil with a pH value of less than 7.0; for practical purposes, soils with pH below 6.6."@en ] ;
    skos:exactMatch agrovoc:c_89 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "acid soils"@en .

eusoilvoc:AcidSulphateSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:exactMatch agrovoc:c_36929 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "acid sulphate soils"@en .

eusoilvoc:AcrisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_101 ;
            rdf:value "Acrisols have a higher clay content in the subsoil than in the topsoil, as a result of pedogenetic processes (especially clay migration) leading to an argic subsoil horizon. Acrisols have low-activity clays in the argic horizon and a low base saturation in the 50–100 cm depth. Many Acrisols correlate with Red yellow podzolic soils (e.g. Indonesia), Argissolos (Brazil), Kurosols (Australia), Sols ferralitiques fortement ou moyennement désaturés (France) and Ultisols with low-activity clays (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_101 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Acrisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:AgriculturalLime a skos:Concept ;
    skos:broader eusoilvoc:LimingMaterials ;
    skos:definition [ dcterms:source agrovoc:c_12182 ;
            rdf:value "A soil amendment consisting principally of calcium carbonate but including magnesium carbonate and perhaps other materials. This is used to furnish calcium and magnesium as elements for the growth of plants and to neutralize soil acidity."@en ] ;
    skos:exactMatch agrovoc:c_12182 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agricultural lime"@en .

eusoilvoc:AgriculturalSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_33934 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agricultural soils"@en .

eusoilvoc:Agroforestry a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_207 ;
            rdf:value "Agroforestry: the collective term for land-use   systems   and   technologies   in   which   woody perennials (e.g. trees, shrubs, palms or   bamboos)   and   agricultural   crops   or   animals are used deliberately on the same parcel of land in some form of spatial and temporal arrangement."@en ] ;
    skos:exactMatch agrovoc:c_207 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agroforestry"@en .

eusoilvoc:Agrology a skos:Concept ;
    skos:broader eusoilvoc:SoilSciences ;
    skos:definition [ dcterms:source agrovoc:c_8688 ;
            rdf:value "Branch of agriculture that deals with the origin, structure, analysis and classification of soils, especially in their relation to crop production."@en ] ;
    skos:exactMatch agrovoc:c_8688 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agrology"@en .

eusoilvoc:AlisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_479c499a ;
            rdf:value "Alisols have a higher clay content in the subsoil than in the topsoil, as a result of pedogenetic processes (especially clay migration) leading to an argic subsoil horizon. Alisols have high-activity clays throughout the argic horizon and a low base saturation in the 50–100 cm depth. They occur predominantly in humid tropical, humid subtropical and humid temperate regions. Many Alisols correlate with Parabraunerden (Germany), Argissolos (Brazil), Ultisols with high-activity clays (United States of America), Kurosols (Australia), and Fersialsols and Sols fersiallitiques très lessivés (France)."@en ] ;
    skos:exactMatch agrovoc:c_479c499a ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Alisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:AlkalinePhosphatase a skos:Concept ;
    skos:broader eusoilvoc:Enzymes ;
    skos:exactMatch agrovoc:c_267 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "alkaline phosphatase"@en .

eusoilvoc:AlkalineSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:exactMatch agrovoc:c_268 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "alkaline soils"@en .

eusoilvoc:Allophane a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:exactMatch agrovoc:c_15839 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "allophane"@en .

eusoilvoc:AlluvialSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_296 ;
            rdf:value "Soil that has been deposited by any form of running water."@en ] ;
    skos:exactMatch agrovoc:c_296 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "alluvial soils"@en .

eusoilvoc:AluminiumMulches a skos:Concept ;
    skos:broader eusoilvoc:DryMulches ;
    skos:definition [ dcterms:source agrovoc:c_207ace25 ;
            rdf:value "A mulch where foil is used to cover soil surface."@en ] ;
    skos:exactMatch agrovoc:c_207ace25 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "aluminium mulches"@en .

eusoilvoc:Ammonification a skos:Concept ;
    skos:broader eusoilvoc:NitrogenMineralization ;
    skos:definition [ dcterms:source agrovoc:c_37196 ;
            rdf:value "Transformation by micro-organisms of organic nitrogenous matter in soil or sediment into ammonia compounds."@en ] ;
    skos:exactMatch agrovoc:c_37196 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ammonification"@en .

eusoilvoc:AmmoniumFixation a skos:Concept ;
    skos:broader eusoilvoc:SoilNutrientAvailability ;
    skos:exactMatch agrovoc:c_32373 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ammonium fixation"@en .

eusoilvoc:AndosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_404 ;
            rdf:value "Andosols accommodate soils that develop in glass-rich volcanic ejecta under almost any climate (except under hyperarid climate conditions). However, Andosols may also develop in other silicate-rich materials under acid weathering in humid and perhumid climates. Many Andosols belong to Kuroboku (Japan), Andisols (United States of America), Andosols and Vitrisols (France), and Volcanic ash soils (Russia)."@en ] ;
    skos:exactMatch agrovoc:c_404 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Andosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:AnionExchangeCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilChemicalCapacity ;
    skos:definition [ dcterms:source agrovoc:c_24966 ;
            rdf:value "Anion exchange capacity (AEC) represents the positive charge available to attract anions in solution."@en ] ;
    skos:exactMatch agrovoc:c_24966 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "anion exchange capacity"@en .

eusoilvoc:AnthrosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_4515b13e ;
            rdf:value "Anthrosols comprise soils that have been modified profoundly through human activities, such as addition of organic or mineral material, charcoal or household wastes, or irrigation and cultivation. The group includes soils otherwise known as Plaggen soils, Paddy soils, Oasis soils, or Terra Preta de Indio. Many of them correspond to Highly cultivated soils and Anciently irrigated soils (Russia), Terrestrische anthropogene Böden (Germany), Anthroposols (Australia) and Anthrosols (China)."@en ] ;
    skos:exactMatch agrovoc:c_4515b13e ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Anthrosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:Antimony a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_510 ;
            rdf:value "Antimony is a chemical element with symbol Sb and atomic number 51. Classified as a metalloid, Antimony is a solid at room temperature."@en ] ;
    skos:exactMatch agrovoc:c_510 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "antimony"@en .

eusoilvoc:ArableSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_568 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "arable soils"@en .

eusoilvoc:ArbuscularMycorrhiza a skos:Concept ;
    skos:broader eusoilvoc:Mycorrhizae ;
    skos:definition [ dcterms:source agrovoc:c_1415699873241 ;
            rdf:value "A mycorrhiza produced by species of Glomeromycota, in which highly branched haustorial structures (arbuscule) are formed within a host cell."@en ] ;
    skos:exactMatch agrovoc:c_1415699873241 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "arbuscular mycorrhiza"@en .

eusoilvoc:ArenosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_601 ;
            rdf:value "Arenosols comprise deep sandy soils. This includes soils in residual sands after in situ weathering of usually quartz-rich sediments or rock, and soils in recently deposited sands such as dunes in deserts and beach lands. Corresponding soils in other classification systems include Psamments (United States of America), Sols minéraux bruts and Sols peu évolués (France), Arenic Rudosols/Tenosols (Australia), Psammozems (Russia) and Neossolos (Brazil)."@en ] ;
    skos:exactMatch agrovoc:c_601 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Arenosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:AridSoils a skos:Concept ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_612 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "arid soils"@en .

eusoilvoc:Arsenic a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_629 ;
            rdf:value "Arsenic is a chemical element with symbol As and atomic number 33. Classified as a metalloid, arsenic is a solid at room temperature."@en ] ;
    skos:exactMatch agrovoc:c_629 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "arsenic"@en .

eusoilvoc:AtomicAbsorptionSpectrometry a skos:Concept ;
    skos:broader eusoilvoc:Spectrometry ;
    skos:definition [ dcterms:source agrovoc:c_28567 ;
            rdf:value "Atomic absorption spectrometry (AAS) is an important sensitive atomic spectrometric method that is suitable for the determination of selected elements at the trace and partly at the ultra-trace level."@en ] ;
    skos:exactMatch agrovoc:c_28567 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "atomic absorption spectrometry"@en .

eusoilvoc:BHorizons a skos:Concept ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_6381571a ;
            rdf:value "B horizons form below an O, A, or E horizon and they have undergone sufficient changes during soil genesis, such that the properties of their original parent material are no longer discernible."@en ] ;
    skos:exactMatch agrovoc:c_6381571a ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "B horizons"@en .

eusoilvoc:BarkMulches a skos:Concept ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_bc5f6400 ;
            rdf:value "A mulch where the outer corky bark layer of timber trees, shredded or not, are used to cover soil surface."@en ] ;
    skos:exactMatch agrovoc:c_bc5f6400 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bark mulches"@en .

