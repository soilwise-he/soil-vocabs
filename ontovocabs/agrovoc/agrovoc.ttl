    skos:exactMatch agrovoc:c_34324 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polluted soils"@en .

eusoilvoc:PolychlorinatedBiphenyls a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_24066 ;
            rdf:value "PCB are toxic and can cause serious health effects in humans and animals, including reproductive impairment and immune system dysfunctions. Once in the environment, PCB enter the food chain. PCBs are toxic to wildlife, including fish, killing them at higher doses and causing spawning failures at lower doses."@en ] ;
    skos:exactMatch agrovoc:c_24066 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polychlorinated biphenyls"@en .

eusoilvoc:PolycyclicAromaticHydrocarbons a skos:Concept ;
    skos:broader eusoilvoc:Hydrocarbons ;
    skos:definition [ dcterms:source agrovoc:c_331394 ;
            rdf:value "A class of chemicals that result from burning coal, oil, gas, wood, garbage, or tobacco. They bind to or form small particles in the air. High heat when cooking meat and other foods will also form PAHs."@en ] ;
    skos:exactMatch agrovoc:c_331394 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polycyclic aromatic hydrocarbons"@en .

