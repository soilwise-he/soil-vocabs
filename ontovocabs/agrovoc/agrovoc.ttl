eusoilvoc:AmmoniumNitrogen a skos:Concept ;
    skos:broader eusoilvoc:InorganicNitrogen,
        eusoilvoc:Nitrogen ;
    skos:definition [ dcterms:source agrovoc:c_37457 ;
            rdf:value "Amount of nitrogen as component of ammonium"@en ] ;
    skos:exactMatch agrovoc:c_37457 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ammonium nitrogen"@en .

eusoilvoc:Archaea a skos:Concept ;
    skos:broader eusoilvoc:Microorganisms ;
    skos:definition [ dcterms:source agrovoc:c_95fbe471 ;
            rdf:value "Archaea, a diverse group of prokaryotes constituting a distinct domain of life, are differentiated from bacteria and eukaryotes in numerous aspects, In 1990, Woese et al. proposed the classification of archaea into a novel domain of life, the archaeal domain, alongside the bacterial and eukaryotic domains, based on nucleic acid-based comparative and phylogenetic analysis,"@en ] ;
    skos:exactMatch agrovoc:c_95fbe471 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:Methanogens ;
    skos:prefLabel "Archaea"@en .

eusoilvoc:Bioremediation a skos:Concept ;
    skos:broader eusoilvoc:SoilTreatment ;
    skos:definition [ dcterms:source agrovoc:c_35028 ;
            rdf:value "Bioremediation is any process that uses microorganisms, fungi or plants to return the natural environment altered by contaminants to its original condition. This process allows for reconditioning of flow-back frac fluid for reuse. Bioremediation of many synthetic or organic compounds is carried out by indigenous microorganisms, principally heterotrophic bacteria, which transform contaminants to intermediate products, innocuous end products or immobilized substances."@en ] ;
    skos:exactMatch agrovoc:c_35028 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:Phytoremediation ;
    skos:prefLabel "bioremediation"@en .

eusoilvoc:Bioturbation a skos:Concept ;
    skos:broader eusoilvoc:Pedoturbation,
        eusoilvoc:SoilBiologicalProcesses ;
    skos:definition [ dcterms:source agrovoc:c_a3354940 ;
            rdf:value "Bioturbation is the biogenic transport of sediment or soil particles and pore water which destroys sediment or soil stratigraphy, changes rates of chemical reactions and sediment/soil-water exchange, and modifies sediment/soil physical properties such as grain size, porosity, and permeability."@en ] ;
    skos:exactMatch agrovoc:c_a3354940 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bioturbation"@en .

eusoilvoc:CalcareousSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes,
        eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_1194 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "calcareous soils"@en .

eusoilvoc:CarbonSequestration a skos:Concept ;
    skos:broader eusoilvoc:SoilProcesses ;
    skos:definition [ dcterms:source agrovoc:c_331583 ;
            rdf:value "The process of removing carbon from the atmosphere and depositing it in reservoirs such as oceans, forests or soils through physical or biological processes."@en ] ;
    skos:exactMatch agrovoc:c_331583 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "carbon sequestration"@en .

eusoilvoc:Chromatography a skos:Concept ;
    skos:broader eusoilvoc:SoilAnalysis ;
    skos:definition [ dcterms:source agrovoc:c_1594 ;
            rdf:value "A physical method of separation in which the components to be separated are distributed between two phases, one of which is stationary (stationary phase) while the other (the mobile phase) moves in a definite direction."@en ] ;
    skos:exactMatch agrovoc:c_1594 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:GasChromatography ;
    skos:prefLabel "chromatography"@en .

