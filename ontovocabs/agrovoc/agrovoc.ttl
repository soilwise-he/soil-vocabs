    skos:definition [ dcterms:source agrovoc:c_7206 ;
            rdf:value "Soil water balance considers water inputs such as rainfall, irrigation, and capillary rise of water, as well as water losses including evapotranspiration, deep percolation, and surface runoff."@en ] ;
    skos:exactMatch agrovoc:c_7206 ;
