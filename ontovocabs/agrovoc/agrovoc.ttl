eusoilvoc:VertisolsWRB a skos:Concept ;
    skos:altLabel "Vertisol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_8199 ;
            rdf:value "Vertisols are heavy clay soils with a high proportion of swelling clays. These soils form deep wide cracks from the surface downward when they dry out, which happens in most years. Common local names for Vertisols are Black cotton soils and Regur (India), Black turf soils (South Africa) or Margalites (Indonesia). In national soil classification systems they are called Slitozems or Dark vertic soils (Russia), Vertosols (Australia), Vertissolos (Brazil) and Vertisols (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_8199 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Vertisols"@en .

eusoilvoc:VirginSoils a skos:Concept ;
    skos:altLabel "virgin soil"@en ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_35348 ;
            rdf:value "Soil that has not been used for agricultural purposes or disturbed by humans at all."@en ] ;
    skos:exactMatch agrovoc:c_35348 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "virgin soils"@en .

