eusoilvoc:DuneSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_2409 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dune soils"@en .

eusoilvoc:DurisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_51ec138f ;
            rdf:value "Durisols are associated mainly with old surfaces in arid and semi-arid environments and accommodate shallow to moderately deep, moderately well- to well-drained soils that contain cemented secondary silica (SiO2) within 100 cm of the soil surface. Many Durisols are known as Hardpan soils or Duric Kandosols (Australia), Dorbank (South Africa), or Durids (United States of America). In the Soil Map of the World (FAO–UNESCO, 1971–1981) they are the Duripan phases of other soils, e.g. of Calcisols."@en ] ;
    skos:exactMatch agrovoc:c_51ec138f ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Durisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:EHorizons a skos:Concept ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_f4fd14d8 ;
            rdf:value "E (short for eluviated), is most commonly used to label a horizon that has been significantly leached of clay, iron, and aluminum oxides, which leaves a concentration of resistant minerals, such as quartz, in the sand and silt sizes. "@en ] ;
    skos:exactMatch agrovoc:c_f4fd14d8 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "E horizons"@en .

eusoilvoc:Earthworms skos:broader eusoilvoc:SoilOrganisms .

eusoilvoc:Ectomycorrhizae a skos:Concept ;
    skos:broader eusoilvoc:Mycorrhizae ;
    skos:definition [ dcterms:source agrovoc:c_35482 ;
            rdf:value "It is a type of mycorrhiza where the fungal hyphae surround the host externally like a mantle and feed by sending their mycelia into the intercellular spaces towards the center of the host."@en ] ;
    skos:exactMatch agrovoc:c_35482 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Ectomycorrhizae"@en .

eusoilvoc:EdaphicFactors a skos:Concept ;
    skos:altLabel "soil factors"@en ;
    skos:broader eusoilvoc:SoilProperties ;
    skos:definition [ dcterms:source agrovoc:c_15617 ;
            rdf:value "Any characteristic or condition of soil - generally physical or chemical, that influences organisms."@en ] ;
    skos:exactMatch agrovoc:c_15617 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "edaphic factors"@en .

eusoilvoc:ElectronMicroscopy a skos:Concept ;
    skos:broader eusoilvoc:Microscopy ;
    skos:definition [ dcterms:source agrovoc:c_10573 ;
            rdf:value "Electron microscopy (EM) is a technique for obtaining high resolution images of biological and non-biological specimens. It is used in biomedical research to investigate the detailed structure of tissues, cells, organelles and macromolecular complexes. "@en ] ;
    skos:exactMatch agrovoc:c_10573 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "electron microscopy"@en .

eusoilvoc:ElementalAnalysis a skos:Concept ;
    skos:broader eusoilvoc:SoilAnalysis ;
    skos:definition [ dcterms:source agrovoc:c_90cf3530 ;
            rdf:value "Elemental analysis (EA) is an analytical technique applied in chemistry to determine the elemental composition of chemical compounds and their composites."@en ] ;
    skos:exactMatch agrovoc:c_90cf3530 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "elemental analysis"@en .

