    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_6748 ;
            rdf:value "The distinguishing characteristic of saline soils from the agricultural standpoint, is that they contain sufficient neutral soluble salts to adversely affect the growth of most crop plants."@en ] ;
