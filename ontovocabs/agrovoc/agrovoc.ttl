    skos:exactMatch agrovoc:c_1033 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bottomland soils"@en .

eusoilvoc:BoulderClaySoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_1036 ;
            rdf:value "The boulder clay soils typically comprise very slightly stony (<5% stones), non-calcareous or very slightly calcareous (<1% CaCO-), heavy clay loam or clay topsoil overlying a clay or heavy clay loam upper subsoil passing to a clay lower subsoil within 45-60 cm."@en ] ;
    skos:exactMatch agrovoc:c_1036 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "boulder clay soils"@en .

eusoilvoc:BuriedSoils a skos:Concept ;
    skos:broader eusoilvoc:PalaeosolicSoilTypes ;
    skos:exactMatch agrovoc:c_1154 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "buried soils"@en .

