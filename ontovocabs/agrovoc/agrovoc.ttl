eusoilvoc:AnthropogenicSoils a skos:Concept ;
    skos:broader eusoilvoc:SoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_486 ;
            rdf:value "Anthropogenic soils (anthrosoils) are soils that have been influenced, modified or created by human activity, in contrast to soils formed by natural processes. They are found worldwide in urban and other human-impacted landscapes. Anthrosoils are formed by: (1) sealing a natural soil beneath pavement or other artificially manufactured impervious material, (2) transformation of a natural soil by human action, or (3) development of a new soil profile in parent materials created and deposited by human action."@en ] ;
    skos:exactMatch agrovoc:c_486 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:Colluvium,
        eusoilvoc:ErodedSoils,
        eusoilvoc:PaddySoils,
        eusoilvoc:PolderSoils,
        eusoilvoc:PollutedSoils,
        eusoilvoc:ReclaimedSoils,
        eusoilvoc:RoadsideSoils ;
    skos:prefLabel "anthropogenic soils"@en .

