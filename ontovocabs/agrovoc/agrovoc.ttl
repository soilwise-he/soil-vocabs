    skos:broader eusoilvoc:SoilMorphologicalFeatures ;
    skos:definition [ dcterms:source agrovoc:c_32749 ;
            rdf:value "In soil science: relatively uniform materials that extend laterally, continuously or discontinuously, throughout the pedounit; it runs approximately parallel to the surface of the ground and differs from the related horizons in many chemical, physical and biological properties."@en ] ;
