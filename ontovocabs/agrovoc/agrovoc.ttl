eusoilvoc:MudFlows a skos:Concept ;
    skos:altLabel "mud flow"@en ;
    skos:broader eusoilvoc:SoilMovement ;
    skos:definition [ dcterms:source agrovoc:c_f3c459ea ;
            rdf:value "A mudflow or mud flow is a form of mass wasting involving \"very rapid to extremely rapid surging flow\" of debris that has become partially or fully liquified by the addition of significant amounts of water to the source material"@en ] ;
    skos:exactMatch agrovoc:c_f3c459ea ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "mud flows"@en .

