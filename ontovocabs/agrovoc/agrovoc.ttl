# Adaptations: local URIs, reviewed hierarchy, explicit definition omissions.
# Existing concept declarations remain in their original modules; mappings and hierarchy cross-references are supplementary.

@prefix agrovoc: <http://aims.fao.org/aos/agrovoc/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eusoilvoc: <https://w3id.org/eusoilvoc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eusoilvoc:AridisolsUSDA skos:definition [ dcterms:source agrovoc:c_490e91f0 ;
            rdf:value "Aridisols are soils that are too dry for the growth of mesophytic plants. They are common in the deserts of the world."@en ] ;
    skos:exactMatch agrovoc:c_490e91f0 .

eusoilvoc:EntisolsUSDA skos:definition [ dcterms:source agrovoc:c_b10d627e ;
            rdf:value "Entisols are soils that show little or no evidence of pedogenic horizon development."@en ] ;
    skos:exactMatch agrovoc:c_b10d627e .

eusoilvoc:GelisolsUSDA skos:definition [ dcterms:source agrovoc:c_44ac37ac ;
            rdf:value "Gelisols, one of the 12 soil orders in the U.S. Soil Taxonomy, are characterized by permafrost conditions."@en ] ;
    skos:exactMatch agrovoc:c_44ac37ac .

eusoilvoc:InceptisolsUSDA skos:definition [ dcterms:source agrovoc:c_90831e99 ;
            rdf:value "Inceptisols are soils of semiarid to humid environments that generally exhibit only moderate degrees of soil weathering and development."@en ] ;
    skos:exactMatch agrovoc:c_90831e99 .

eusoilvoc:MollisolsUSDA skos:definition [ dcterms:source agrovoc:c_ca2631da ;
            rdf:value "Mollisols are soils that have a dark colored surface horizon relatively high in content of organic matter. The soils are base rich throughout and therefore quite fertile."@en ] ;
    skos:exactMatch agrovoc:c_ca2631da .

eusoilvoc:SoilAcidification skos:definition [ dcterms:source agrovoc:c_a97faca7 ;
            rdf:value "The lowering of the soil pH of the build-up of hydrogen and aluminium ions in the soil and the leaching of base cations such as calcium, magnesium, potassium and sodium. Soil acidification negatively affects soil fertility and compromises the production capacity of most agricultural soils."@en ] ;
    skos:exactMatch agrovoc:c_a97faca7 .

eusoilvoc:SoilGravimetricMoistureContents skos:closeMatch agrovoc:c_76b9bd59 .

eusoilvoc:SoilMacropore skos:closeMatch agrovoc:c_35318 .

eusoilvoc:SoilMicropore skos:closeMatch agrovoc:c_35319 .

eusoilvoc:SoilVolumetricMoistureContents skos:definition [ dcterms:source agrovoc:c_4b440f7a ;
            rdf:value "The volumetric water content is the volume of water per unit volume of soil, expressed as a percentage of the volume."@en ] ;
    skos:exactMatch agrovoc:c_4b440f7a .

eusoilvoc:SpodosolsUSDA skos:definition [ dcterms:source agrovoc:c_36874 ;
            rdf:value "Spodosols are acid soils characterized by a subsurface accumulation of humus that is complexed with Al and Fe."@en ] ;
    skos:exactMatch agrovoc:c_36874 .

eusoilvoc:AHorizons a skos:Concept ;
    skos:altLabel "A horizon"@en ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:exactMatch agrovoc:c_47a98f68 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "A horizons"@en .

eusoilvoc:AcidSoils a skos:Concept ;
    skos:altLabel "acid soil"@en ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_89 ;
            rdf:value "A soil with a pH value of less than 7.0; for practical purposes, soils with pH below 6.6."@en ] ;
    skos:exactMatch agrovoc:c_89 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "acid soils"@en .

eusoilvoc:AcidSulphateSoils a skos:Concept ;
    skos:altLabel "acid sulphate soil"@en ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:exactMatch agrovoc:c_36929 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "acid sulphate soils"@en .

eusoilvoc:AcrisolsWRB a skos:Concept ;
    skos:altLabel "Acrisol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_101 ;
            rdf:value "Acrisols have a higher clay content in the subsoil than in the topsoil, as a result of pedogenetic processes (especially clay migration) leading to an argic subsoil horizon. Acrisols have low-activity clays in the argic horizon and a low base saturation in the 50–100 cm depth. Many Acrisols correlate with Red yellow podzolic soils (e.g. Indonesia), Argissolos (Brazil), Kurosols (Australia), Sols ferralitiques fortement ou moyennement désaturés (France) and Ultisols with low-activity clays (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_101 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Acrisols"@en .

eusoilvoc:AgriculturalLime a skos:Concept ;
    skos:broader eusoilvoc:LimingMaterials ;
    skos:definition [ dcterms:source agrovoc:c_12182 ;
            rdf:value "A soil amendment consisting principally of calcium carbonate but including magnesium carbonate and perhaps other materials. This is used to furnish calcium and magnesium as elements for the growth of plants and to neutralize soil acidity."@en ] ;
    skos:exactMatch agrovoc:c_12182 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agricultural lime"@en .

eusoilvoc:AgriculturalSoils a skos:Concept ;
    skos:altLabel "agricultural soil"@en ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_33934 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agricultural soils"@en .

eusoilvoc:Agrology a skos:Concept ;
    skos:broader eusoilvoc:SoilSciences ;
    skos:definition [ dcterms:source agrovoc:c_8688 ;
            rdf:value "Branch of agriculture that deals with the origin, structure, analysis and classification of soils, especially in their relation to crop production."@en ] ;
    skos:exactMatch agrovoc:c_8688 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "agrology"@en .

eusoilvoc:AlisolsWRB a skos:Concept ;
    skos:altLabel "Alisol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_479c499a ;
            rdf:value "Alisols have a higher clay content in the subsoil than in the topsoil, as a result of pedogenetic processes (especially clay migration) leading to an argic subsoil horizon. Alisols have high-activity clays throughout the argic horizon and a low base saturation in the 50–100 cm depth. They occur predominantly in humid tropical, humid subtropical and humid temperate regions. Many Alisols correlate with Parabraunerden (Germany), Argissolos (Brazil), Ultisols with high-activity clays (United States of America), Kurosols (Australia), and Fersialsols and Sols fersiallitiques très lessivés (France)."@en ] ;
    skos:exactMatch agrovoc:c_479c499a ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Alisols"@en .

eusoilvoc:AlkalineSoils a skos:Concept ;
    skos:altLabel "alkaline soil"@en ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:exactMatch agrovoc:c_268 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "alkaline soils"@en .

eusoilvoc:Allophane a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:exactMatch agrovoc:c_15839 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "allophane"@en .

eusoilvoc:AlluvialSoils a skos:Concept ;
    skos:altLabel "alluvial soil"@en ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_296 ;
            rdf:value "Soil that has been deposited by any form of running water."@en ] ;
    skos:exactMatch agrovoc:c_296 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "alluvial soils"@en .

eusoilvoc:Alluvium a skos:Concept ;
    skos:altLabel "alluvial deposits"@en ;
    skos:broader eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source agrovoc:c_25347 ;
            rdf:value "Deposit made by a river or running water, often very productive agricultural soil."@en ] ;
    skos:exactMatch agrovoc:c_25347 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "alluvium"@en .

eusoilvoc:AluminiumMulches a skos:Concept ;
    skos:altLabel "aluminium mulch"@en ;
    skos:broader eusoilvoc:DryMulches ;
    skos:definition [ dcterms:source agrovoc:c_207ace25 ;
            rdf:value "A mulch where foil is used to cover soil surface."@en ] ;
    skos:exactMatch agrovoc:c_207ace25 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "aluminium mulches"@en .

eusoilvoc:AmmoniumFixation a skos:Concept ;
    skos:broader eusoilvoc:SoilNutrientAvailability ;
    skos:exactMatch agrovoc:c_32373 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ammonium fixation"@en .

eusoilvoc:AndosolsWRB a skos:Concept ;
    skos:altLabel "Andosol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_404 ;
            rdf:value "Andosols accommodate soils that develop in glass-rich volcanic ejecta under almost any climate (except under hyperarid climate conditions). However, Andosols may also develop in other silicate-rich materials under acid weathering in humid and perhumid climates. Many Andosols belong to Kuroboku (Japan), Andisols (United States of America), Andosols and Vitrisols (France), and Volcanic ash soils (Russia)."@en ] ;
    skos:exactMatch agrovoc:c_404 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Andosols"@en .

eusoilvoc:AnionExchangeCapacity a skos:Concept ;
    skos:broader eusoilvoc:SoilChemicalCapacity ;
    skos:definition [ dcterms:source agrovoc:c_24966 ;
            rdf:value "Anion exchange capacity (AEC) represents the positive charge available to attract anions in solution."@en ] ;
    skos:exactMatch agrovoc:c_24966 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "anion exchange capacity"@en .

eusoilvoc:AnthrosolsWRB a skos:Concept ;
    skos:altLabel "Anthrosol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_4515b13e ;
            rdf:value "Anthrosols comprise soils that have been modified profoundly through human activities, such as addition of organic or mineral material, charcoal or household wastes, or irrigation and cultivation. The group includes soils otherwise known as Plaggen soils, Paddy soils, Oasis soils, or Terra Preta de Indio. Many of them correspond to Highly cultivated soils and Anciently irrigated soils (Russia), Terrestrische anthropogene Böden (Germany), Anthroposols (Australia) and Anthrosols (China)."@en ] ;
    skos:exactMatch agrovoc:c_4515b13e ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Anthrosols"@en .

eusoilvoc:Antimony a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_510 ;
            rdf:value "Antimony is a chemical element with symbol Sb and atomic number 51. Classified as a metalloid, Antimony is a solid at room temperature."@en ] ;
    skos:exactMatch agrovoc:c_510 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "antimony"@en .

eusoilvoc:ArableSoils a skos:Concept ;
    skos:altLabel "arable soil"@en ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_568 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "arable soils"@en .

eusoilvoc:ArenosolsWRB a skos:Concept ;
    skos:altLabel "Arenosol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_601 ;
            rdf:value "Arenosols comprise deep sandy soils. This includes soils in residual sands after in situ weathering of usually quartz-rich sediments or rock, and soils in recently deposited sands such as dunes in deserts and beach lands. Corresponding soils in other classification systems include Psamments (United States of America), Sols minéraux bruts and Sols peu évolués (France), Arenic Rudosols/Tenosols (Australia), Psammozems (Russia) and Neossolos (Brazil)."@en ] ;
    skos:exactMatch agrovoc:c_601 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Arenosols"@en .

eusoilvoc:AridSoils a skos:Concept ;
    skos:altLabel "arid soil"@en ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_612 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "arid soils"@en .

eusoilvoc:Arsenic a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_629 ;
            rdf:value "Arsenic is a chemical element with symbol As and atomic number 33. Classified as a metalloid, arsenic is a solid at room temperature."@en ] ;
    skos:exactMatch agrovoc:c_629 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "arsenic"@en .

eusoilvoc:BHorizons a skos:Concept ;
    skos:altLabel "B horizon"@en ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_6381571a ;
            rdf:value "B horizons form below an O, A, or E horizon and they have undergone sufficient changes during soil genesis, such that the properties of their original parent material are no longer discernible."@en ] ;
    skos:exactMatch agrovoc:c_6381571a ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "B horizons"@en .

eusoilvoc:BarkMulches a skos:Concept ;
    skos:altLabel "bark mulch"@en ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_bc5f6400 ;
            rdf:value "A mulch where the outer corky bark layer of timber trees, shredded or not, are used to cover soil surface."@en ] ;
    skos:exactMatch agrovoc:c_bc5f6400 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bark mulches"@en .

eusoilvoc:BasalticSoils a skos:Concept ;
    skos:altLabel "basaltic soil"@en ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_832 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "basaltic soils"@en .

eusoilvoc:Bentonite a skos:Concept ;
    skos:broader eusoilvoc:Clay ;
    skos:definition [ dcterms:source agrovoc:c_15620 ;
            rdf:value "A colloidal, hydrated aluminum silicate that swells 12 times its dry size when added to water."@en ] ;
    skos:exactMatch agrovoc:c_15620 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bentonite"@en .

eusoilvoc:Biodrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:definition [ dcterms:source agrovoc:c_ac7696b9 ;
            rdf:value "Biodrainage is defined as the process of removing the excess soil water through transpiration using bio-energy of the plant and radiation energy of the sun."@en ] ;
    skos:exactMatch agrovoc:c_ac7696b9 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biodrainage"@en .

eusoilvoc:BogSoils a skos:Concept ;
    skos:altLabel "bog soil"@en ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_986 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bog soils"@en .

eusoilvoc:BottomlandSoils a skos:Concept ;
    skos:altLabel "bottomland soil"@en ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_1033 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bottomland soils"@en .

eusoilvoc:BoulderClaySoils a skos:Concept ;
    skos:altLabel "boulder clay soil"@en ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_1036 ;
            rdf:value "The boulder clay soils typically comprise very slightly stony (<5% stones), non-calcareous or very slightly calcareous (<1% CaCO-), heavy clay loam or clay topsoil overlying a clay or heavy clay loam upper subsoil passing to a clay lower subsoil within 45-60 cm."@en ] ;
    skos:exactMatch agrovoc:c_1036 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "boulder clay soils"@en .

eusoilvoc:BuriedSoils a skos:Concept ;
    skos:altLabel "buried soil"@en ;
    skos:broader eusoilvoc:PalaeosolicSoilTypes ;
    skos:exactMatch agrovoc:c_1154 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "buried soils"@en .

eusoilvoc:CHorizons a skos:Concept ;
    skos:altLabel "C horizon"@en ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:exactMatch agrovoc:c_016fddeb ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "C horizons"@en .

eusoilvoc:CalamineSoils a skos:Concept ;
    skos:altLabel "calamine soil"@en ;
    skos:broader eusoilvoc:MineralogicalSoilTypes ;
    skos:exactMatch agrovoc:c_1189 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "calamine soils"@en .

eusoilvoc:CalcisolsWRB a skos:Concept ;
    skos:altLabel "Calcisol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_ea60e31f ;
            rdf:value "Calcisols accommodate soils with substantial accumulation of secondary carbonates. Calcisols are widespread in arid and semi-arid environments, often associated with highly calcareous parent materials. Many Calcisols have formerly been called Desert soils. In the United States of America most of them belong to the Calcids, and in Australia to the Calcarosols. In the Soil Map of the World (FAO–UNESCO, 1971–1981) most of them belong to the Xerosols and to a lesser extent to the Yermosols."@en ] ;
    skos:exactMatch agrovoc:c_ea60e31f ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Calcisols"@en .

eusoilvoc:CalciticLimeAmendment a skos:Concept ;
    skos:broader eusoilvoc:LimingMaterials ;
    skos:definition [ dcterms:source agrovoc:c_36453 ;
            rdf:value "Liming material. Calcitic lime is derived from deposits of primarily calcium carbonate. "@en ] ;
    skos:exactMatch agrovoc:c_36453 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "calcitic lime (amendment)"@en .

eusoilvoc:CambisolsWRB a skos:Concept ;
    skos:altLabel "Cambisol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_1224 ;
            rdf:value "Cambisols combine soils with at least an incipient subsurface soil formation. Transformation of parent material is evident from structure formation and mostly brownish discoloration, increasing clay percentage, and/or carbonate removal. Other soil classification systems refer to many Cambisols as Braunerden and Terrae fuscae (Germany), Sols bruns (France), burozems (Russia) and Tenosols (Australia). The name Cambisols was coined for the Soil Map of the World (FAO–UNESCO, 1971–1981) and later adopted by Brazil (Cambissolos). In the United States of America they were formerly called Brown soils/Brown forest soils and are now named Inceptisols."@en ] ;
    skos:exactMatch agrovoc:c_1224 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Cambisols"@en .

eusoilvoc:ChalkSoils a skos:Concept ;
    skos:altLabel "chalk soil"@en ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_1493 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "chalk soils"@en .

eusoilvoc:ChernozemsWRB a skos:Concept ;
    skos:altLabel "Chernozem"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_1533 ;
            rdf:value "Chernozems accommodate soils with a thick blackish mineral surface layer that is rich in organic matter. The Russian soil scientist V.V. Dokuchaev coined the name Chernozem in 1883 to denote the typical soils of the tall-grass steppes in continental Russia. Many Chernozems correspond to Kalktschernoseme (Germany), Chernosols (France), Eluviated black soils (Canada) and Chernossolos (Brazil). In the United States of America they were formerly called Calcareous black soils and belong now to several Suborders (especially Udolls) of the Mollisols."@en ] ;
    skos:exactMatch agrovoc:c_1533 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Chernozems"@en .

eusoilvoc:Chromium a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:exactMatch agrovoc:c_1595 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "chromium"@en .

eusoilvoc:ClaypanSoils a skos:Concept ;
    skos:altLabel "claypan soil"@en ;
    skos:broader eusoilvoc:StructuralSoilTypes ;
    skos:exactMatch agrovoc:c_1660 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "claypan soils"@en .

eusoilvoc:CoarseSand skos:broader eusoilvoc:SandyTexture .

eusoilvoc:CoarseSilt a skos:Concept ;
    skos:broader eusoilvoc:SoilTexture ;
    skos:definition [ dcterms:source agrovoc:c_c1b90f01 ;
            rdf:value "Content of mineral particles with sizes between 20-63µm in soil. Note: According to different national and international particle-size classification systems, size classes may differ slightly. "@en ] ;
    skos:exactMatch agrovoc:c_c1b90f01 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coarse silt"@en .

eusoilvoc:CoastalSoils a skos:Concept ;
    skos:altLabel "coastal soil"@en ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_1699 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "coastal soils"@en .

eusoilvoc:Cobalt a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:exactMatch agrovoc:c_1702 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "cobalt"@en .

eusoilvoc:Collembola a skos:Concept ;
    skos:broader eusoilvoc:SoilMesofauna ;
    skos:exactMatch agrovoc:c_1759 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Collembola"@en .

eusoilvoc:Colluvium a skos:Concept ;
    skos:broader eusoilvoc:AnthropogenicSoils,
        eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source agrovoc:c_ce89717c ;
            rdf:value "Layered and heterogeneous sediment in local sinks or foodslopes based on relocated upslope soil material. Occurs often in agricultural landscapes.It is deposited by water and/or tillage erosion and often show higher contents in soil organic carbon."@en ] ;
    skos:exactMatch agrovoc:c_ce89717c ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "colluvium"@en .

eusoilvoc:CompostMulches a skos:Concept ;
    skos:altLabel "compost mulch"@en ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_d2c183d0 ;
            rdf:value "A mulch where compost is used to cover soil surface."@en ] ;
    skos:exactMatch agrovoc:c_d2c183d0 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "compost mulches"@en .

eusoilvoc:ConventionalTillage a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:exactMatch agrovoc:c_34250 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "conventional tillage"@en .

eusoilvoc:CryosolsWRB a skos:Concept ;
    skos:altLabel "Cryosol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_829043c3 ;
            rdf:value "Cryosols comprise mineral soils formed in a permafrost environment. The subsurface layers (cryic horizon) are permanently frozen, and if present, water occurs in the form of ice. Cryogenic processes are the dominant soil-forming processes in most Cryosols. Cryosols are widely known as Permafrost soils, Cryomorphic soils or Polar desert soils. Other common names for many Cryosols are Gelisols (United States of America) and Cryozems (Russia)."@en ] ;
    skos:exactMatch agrovoc:c_829043c3 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Cryosols"@en .

eusoilvoc:DeepPloughing a skos:Concept ;
    skos:broader eusoilvoc:Ploughing ;
    skos:definition [ dcterms:source agrovoc:c_330745 ;
            rdf:value "Mixing of loose surface material by ploughing deeper than frequently done during annual soil cultivation."@en ] ;
    skos:exactMatch agrovoc:c_330745 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "deep ploughing"@en .

eusoilvoc:DeltaSoils a skos:Concept ;
    skos:altLabel "delta soil"@en ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_2169 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "delta soils"@en .

eusoilvoc:DesertSoils a skos:Concept ;
    skos:altLabel "desert soil"@en ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_2203 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "desert soils"@en .

eusoilvoc:DigitalSoilMapping a skos:Concept ;
    skos:broader eusoilvoc:SoilSurveys ;
    skos:definition [ dcterms:source agrovoc:c_e4975629 ;
            rdf:value "Digital Soil Mapping (DSM) refers to techniques of mapping soils with mostly digital techniques, of course incorporating field (and traditional legacy soil information). DSM makes use of pedometrics which refers to the application of numerical techniques to describe and map soils. The idea is to make soil survey, classification, and land evaluation as objective as possible."@en ] ;
    skos:exactMatch agrovoc:c_e4975629 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "digital soil mapping"@en .

eusoilvoc:DioriteSoils a skos:Concept ;
    skos:altLabel "diorite soil"@en ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_2286 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "diorite soils"@en .

eusoilvoc:Disking a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_24454 ;
            rdf:value "Disking: Agricultural term to describe the process of using a disk, or harrow, to disturb the soil, setting back natural succession by cutting up grassy vegetation, thus preventing an area from maturing into briars, shrubs, and trees."@en ] ;
    skos:exactMatch agrovoc:c_24454 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "disking"@en .

eusoilvoc:DispersiveSoils a skos:Concept ;
    skos:altLabel "dispersive soil"@en ;
    skos:broader eusoilvoc:StructuralSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_2334 ;
            rdf:value "A structurally unstable soil that disintegrates into grains of sand, silt, and clay upon contact with water and is easily eroded."@en ] ;
    skos:exactMatch agrovoc:c_2334 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dispersive soils"@en .

eusoilvoc:DolomiticLimeAmendment a skos:Concept ;
    skos:broader eusoilvoc:LimingMaterials ;
    skos:exactMatch agrovoc:c_36452 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dolomitic lime (amendment)"@en .

eusoilvoc:DrainageEquipment a skos:Concept ;
    skos:broader eusoilvoc:SoilManagementEquipment ;
    skos:exactMatch agrovoc:c_2373 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "drainage equipment"@en .

eusoilvoc:DrumlinSoils a skos:Concept ;
    skos:altLabel "drumlin soil"@en ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_2396 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "drumlin soils"@en .

eusoilvoc:DuneFixation a skos:Concept ;
    skos:broader eusoilvoc:SoilStabilization ;
    skos:exactMatch agrovoc:c_10483 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dune fixation"@en .

eusoilvoc:DuneSoils a skos:Concept ;
    skos:altLabel "dune soil"@en ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_2409 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "dune soils"@en .

eusoilvoc:DurisolsWRB a skos:Concept ;
    skos:altLabel "Durisol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_51ec138f ;
            rdf:value "Durisols are associated mainly with old surfaces in arid and semi-arid environments and accommodate shallow to moderately deep, moderately well- to well-drained soils that contain cemented secondary silica (SiO2) within 100 cm of the soil surface. Many Durisols are known as Hardpan soils or Duric Kandosols (Australia), Dorbank (South Africa), or Durids (United States of America). In the Soil Map of the World (FAO–UNESCO, 1971–1981) they are the Duripan phases of other soils, e.g. of Calcisols."@en ] ;
    skos:exactMatch agrovoc:c_51ec138f ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Durisols"@en .

eusoilvoc:EHorizons a skos:Concept ;
    skos:altLabel "E horizon"@en ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_f4fd14d8 ;
            rdf:value "E (short for eluviated), is most commonly used to label a horizon that has been significantly leached of clay, iron, and aluminum oxides, which leaves a concentration of resistant minerals, such as quartz, in the sand and silt sizes. "@en ] ;
    skos:exactMatch agrovoc:c_f4fd14d8 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "E horizons"@en .

eusoilvoc:Earthworms skos:broader eusoilvoc:SoilOrganisms .

eusoilvoc:EdaphicFactors a skos:Concept ;
    skos:altLabel "edaphic factor"@en,
        "soil factors"@en ;
    skos:broader eusoilvoc:SoilProperties ;
    skos:definition [ dcterms:source agrovoc:c_15617 ;
            rdf:value "Any characteristic or condition of soil - generally physical or chemical, that influences organisms."@en ] ;
    skos:exactMatch agrovoc:c_15617 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "edaphic factors"@en .

eusoilvoc:Enchytraeidae a skos:Concept ;
    skos:broader eusoilvoc:SoilMesofauna ;
    skos:exactMatch agrovoc:c_24996 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Enchytraeidae"@en .

