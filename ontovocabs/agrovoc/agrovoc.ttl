    skos:definition [ dcterms:source agrovoc:c_8343 ;
            rdf:value "A material transformation process during which the properties of a material are changed as a result of in situ exposure to atmospheric processes."@en ] ;
    skos:exactMatch agrovoc:c_8343 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "weathering"@en .

