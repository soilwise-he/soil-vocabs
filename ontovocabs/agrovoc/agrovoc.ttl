    skos:broader eusoilvoc:SoilThreats,
        eusoilvoc:SoilWaterRegimes ;
    skos:definition [ dcterms:source agrovoc:c_8333 ;
            rdf:value "The state of land in which the water table is located at or near the soil surface, affecting crop yields."@en ] ;
    skos:exactMatch agrovoc:c_8333 ;
