    skos:exactMatch agrovoc:c_832 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "basaltic soils"@en .

eusoilvoc:Bentonite a skos:Concept ;
    skos:broader eusoilvoc:Clay ;
    skos:definition [ dcterms:source agrovoc:c_15620 ;
            rdf:value "A colloidal, hydrated aluminum silicate that swells 12 times its dry size when added to water."@en ] ;
    skos:exactMatch agrovoc:c_15620 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "bentonite"@en .

