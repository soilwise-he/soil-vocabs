            rdf:value "The catalytic action of enzymes on biochemical reactions"@en ] ;
    skos:exactMatch agrovoc:c_2604 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "enzyme activity"@en .

