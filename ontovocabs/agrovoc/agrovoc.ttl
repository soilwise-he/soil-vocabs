eusoilvoc:Feldspar a skos:Concept ;
    skos:broader eusoilvoc:SilicateMinerals ;
    skos:definition [ dcterms:source agrovoc:c_35108 ;
            rdf:value "Feldspars are a group of rock-forming aluminium tectosilicate minerals, containing sodium, calcium, potassium or barium."@en ] ;
    skos:exactMatch agrovoc:c_35108 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "feldspar"@en .

eusoilvoc:FenlandSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_2854 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fenland soils"@en .

eusoilvoc:FerralsolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_2858 ;
            rdf:value "Ferralsols represent the classical, deeply weathered, red or yellow soils of the humid tropics. These soils have diffuse horizon boundaries, a clay assemblage dominated by low-activity clays (mainly kaolinite) and a high content of sesquioxides. Local names usually refer to the colour of the soil. Many Ferralsols are known as Oxisols (United States of America), Latossolos (Brazil), Alítico, Ferrítico and Ferralítico (Cuba), Kandosols (Australia), Sols ferralitiques (France) and Ferralitic soils (Russia)."@en ] ;
    skos:exactMatch agrovoc:c_2858 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Ferralsols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:FineSand skos:broader eusoilvoc:SandyTexture .

eusoilvoc:FineSilt a skos:Concept ;
    skos:broader eusoilvoc:SoilTexture ;
    skos:definition [ dcterms:source agrovoc:c_0f15e6e6 ;
            rdf:value "Content of mineral particles with sizes between 2-6.3µm in soil. Note: According to different national and international particle-size classification systems, size classes may differ slightly. "@en ] ;
    skos:exactMatch agrovoc:c_0f15e6e6 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fine silt"@en .

eusoilvoc:FineSoil a skos:Concept ;
    skos:broader eusoilvoc:Soil ;
    skos:definition [ dcterms:source agrovoc:c_5749f32e ;
            rdf:value "Fine soil comprises all soilid compartments smaller than 2 mm."@en ] ;
    skos:exactMatch agrovoc:c_5749f32e ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fine soil"@en .

eusoilvoc:FluvisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:exactMatch agrovoc:c_3000 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Fluvisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:ForestSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_3051 ;
            rdf:value "Forest soils, where soil formation has been influenced by forest vegetation, are generally characterized by deeply rooted trees, significant ‘litter layers’ or O horizons, recycling of organic matter and nutrients, including wood, and wide varieties of soil-dwelling organisms."@en ] ;
    skos:exactMatch agrovoc:c_3051 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "forest soils"@en .

eusoilvoc:FrigidSoils a skos:Concept ;
    skos:broader eusoilvoc:ClimaticSoilTypes ;
    skos:exactMatch agrovoc:c_3108 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "frigid soils"@en .

eusoilvoc:FrostHeave a skos:Concept ;
    skos:broader eusoilvoc:SoilMovement ;
    skos:definition [ dcterms:source agrovoc:c_8cbca199 ;
            rdf:value "Frost heaving (or a frost heave) is an upwards swelling of soil during freezing conditions caused by an increasing presence of ice as it grows towards the surface, upwards from the depth in the soil where freezing temperatures have penetrated into the soil (the freezing front or freezing boundary)."@en ] ;
    skos:exactMatch agrovoc:c_8cbca199 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "frost heave"@en .

eusoilvoc:FulvicAcids a skos:Concept ;
    skos:broader eusoilvoc:SoilOrganicMatter ;
    skos:exactMatch agrovoc:c_15972 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "fulvic acids"@en .

eusoilvoc:FunctionalDiversity a skos:Concept ;
    skos:broader eusoilvoc:Biodiversity ;
    skos:definition [ dcterms:source agrovoc:c_7ee18365 ;
            rdf:value "The number of functionally different organisms in an ecosystem (also referred to as functional types and functional groups)."@en ] ;
    skos:exactMatch agrovoc:c_7ee18365 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "functional diversity"@en .

eusoilvoc:GasChromatography a skos:Concept ;
    skos:broader eusoilvoc:Chromatography ;
    skos:definition [ dcterms:source agrovoc:c_11097 ;
            rdf:value "Fractionation of a vaporized sample as a consequence of partition between a mobile gaseous phase and a stationary phase held in a column. Two types are gas-solid chromatography, where the fixed phase is a solid, and gas-liquid, in which the stationary phase is a nonvolatile liquid supported on an inert solid matrix."@en ] ;
    skos:exactMatch agrovoc:c_11097 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gas chromatography"@en .

eusoilvoc:GasTurbation a skos:Concept ;
    skos:broader eusoilvoc:Pedoturbation ;
    skos:definition [ dcterms:source agrovoc:c_b09277cb ;
            rdf:value "The mixing of soil or sediment from the generation of methane gas as organic matter decomposes or the overturn and dispersion of sediments during venting of gases and fluids."@en ] ;
    skos:exactMatch agrovoc:c_b09277cb ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gas turbation"@en .

eusoilvoc:GaseousNitrogen a skos:Concept ;
    skos:broader eusoilvoc:NitrogenTotal ;
    skos:definition [ dcterms:source agrovoc:c_c696e530 ;
            rdf:value "Gaseous nitrogen is the gaseous fraction of the total nitrogen content in soils. Gaseous nitrogen is also used as a protective atmosphere to prevent oxidation of metals, foods and oxygen-sensitive chemicals."@en ] ;
    skos:exactMatch agrovoc:c_c696e530 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gaseous nitrogen"@en .

eusoilvoc:GlacialTillSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3269 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "glacial till soils"@en .

eusoilvoc:GleysolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_3276 ;
            rdf:value "Gleysols comprise soils saturated with groundwater for long enough periods to develop reducing conditions resulting in gleyic properties, including underwater and tidal soils. This pattern is essentially made up of reddish, brownish or yellowish colours at aggregate surfaces and/or in the upper soil layers, in combination with greyish/bluish colours inside the aggregates and/or deeper in the soil. Many underwater soils have only the latter. Gleysols with a thionic horizon or hypersulfidic material (acid sulfate soils) are common. Redox processes may also be caused by upmoving gases, like CO2 or CH4. Common names for many Gleysols are Gley (former Soviet Union), Gleyzems (Russia), Gleye, Marschen, Watten and Unterwasserböden (Germany), Gleissolos (Brazil) and Hydrosols (Australia). In the United States of America many Gleysols belong to Aquic Suborders and Endoaquic Great Groups of various Orders (Aqualfs, Aquents, Aquepts, Aquolls, etc.) or to the Wassents."@en ] ;
    skos:exactMatch agrovoc:c_3276 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Gleysols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:GoodLaboratoryPractices a skos:Concept ;
    skos:broader eusoilvoc:SoilAnalysis ;
    skos:definition [ dcterms:source agrovoc:c_d79597fb ;
            rdf:value "Written codes of practice designed to reduce to a minimum the chance of procedural or instrument problems which could adversely affect a research project or other laboratory work."@en ] ;
    skos:exactMatch agrovoc:c_d79597fb ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "good laboratory practices"@en .

eusoilvoc:GraniteSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3356 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "granite soils"@en .

eusoilvoc:GrasslandSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3365 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "grassland soils"@en .

eusoilvoc:Gravel a skos:Concept ;
    skos:broader eusoilvoc:ParentMaterial ;
    skos:definition [ dcterms:source agrovoc:c_24850 ;
            rdf:value "Gravel is a mineral granular material which does not stick together when wet and remoulded (i.e., noncohesive) and where the combined weight of 50% of the particles is larger than 4.75mm but smaller than 75mm with less than 15% of material smaller than 75µm."@en ] ;
    skos:exactMatch agrovoc:c_24850 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gravel"@en .

eusoilvoc:GravelMulches a skos:Concept ;
    skos:broader eusoilvoc:DryMulches ;
    skos:exactMatch agrovoc:c_11342 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gravel mulches"@en .

eusoilvoc:GreenManures a skos:Concept ;
    skos:broader eusoilvoc:OrganicAmendments ;
    skos:exactMatch agrovoc:c_3375 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "green manures"@en .

eusoilvoc:GreenhouseSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_3378 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "greenhouse soils"@en .

eusoilvoc:GreywackeSoils a skos:Concept ;
    skos:broader eusoilvoc:LithologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3385 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "greywacke soils"@en .

eusoilvoc:GreyzemsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:exactMatch agrovoc:c_3386 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "greyzems"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:GullyControl a skos:Concept ;
    skos:broader eusoilvoc:ErosionControl ;
    skos:definition [ dcterms:source agrovoc:c_2c35fa5f ;
            rdf:value "Measures to control erosion in gulllies. Minimizing runoff volume and peak runoff rate through improved land use system is essential in gully control. "@en ] ;
    skos:exactMatch agrovoc:c_2c35fa5f ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "gully control"@en .

eusoilvoc:GypsisolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_61704b51 ;
            rdf:value "Gypsisols are soils with substantial accumulation of secondary gypsum (CaSO4·2H2O). These soils are found in the driest parts of the arid climate zone, which explains why leading soil classification systems labelled many of them Desert grey-brown soils (former Soviet Union). The Soil Map of the World (FAO–UNESCO, 1971–1981) accommodates them among Yermosols or Xerosols. In the United States of America most of them belong to the Gypsids."@en ] ;
    skos:exactMatch agrovoc:c_61704b51 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Gypsisols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:Hardpans a skos:Concept ;
    skos:broader eusoilvoc:SoilHorizons ;
    skos:definition [ dcterms:source agrovoc:c_c27ddf24 ;
            rdf:value "A hardened soil layer in the lower A or in the B horizon caused by cementation of soil particles with organic matter or with materials such as silica or calcium carbonate. The hardness does not change appreciably with changes in moisture content, and pieces of the hard layer do not disintegrate in water."@en ] ;
    skos:exactMatch agrovoc:c_c27ddf24 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hardpans"@en .

eusoilvoc:Harrowing a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:exactMatch agrovoc:c_3497 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "harrowing"@en .

eusoilvoc:HeathlandSoils a skos:Concept ;
    skos:broader eusoilvoc:EcologicalSoilTypes ;
    skos:exactMatch agrovoc:c_3523 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "heathland soils"@en .

eusoilvoc:HillSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_3615 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hill soils"@en .

eusoilvoc:HistosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_3636 ;
            rdf:value "Histosols comprise soils formed in organic material accumulating as groundwater peat (fen), rainwater peat (raised bog) or mangroves or without water saturation in cool mountain areas. They vary from soils developed in predominantly moss peat in arctic, subarctic and boreal regions, via moss peat (Sphagnum species), reeds/sedge peat (fen) and forest peat in temperate regions to mangrove peat and swamp forest peat in the humid tropics. Histosols are found at all altitudes, but the vast majority occurs in lowlands. Common names are Peat soils, Muck soils, Bog soils and Organic soils. Many Histosols belong to Moore, Felshumusböden and Skeletthumusböden (Germany), Organosols (Australia), Organossolos (Brazil), Peat soils (Russia), Organic order (Canada) and Histosols and Histels (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_3636 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Histosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:HorticulturalSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_3670 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "horticultural soils"@en .

eusoilvoc:HotWaterExtractableNitrogen a skos:Concept ;
    skos:broader eusoilvoc:NitrogenContent ;
    skos:definition [ dcterms:source agrovoc:c_6ed53459 ;
            rdf:value "Hot water soluble part of total nitrogen of a soil sample which can be used to predict mineralizable N and plant available N in soil"@en ] ;
    skos:exactMatch agrovoc:c_6ed53459 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hot water-extractable nitrogen"@en .

eusoilvoc:HumicAcids a skos:Concept ;
    skos:broader eusoilvoc:SoilOrganicMatter ;
    skos:exactMatch agrovoc:c_3685 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "humic acids"@en .

eusoilvoc:HydromorphicSoils a skos:Concept ;
    skos:broader eusoilvoc:GeneticSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_25315 ;
            rdf:value "Hydromorphic soils are characterised by the reduction or localised segregation of iron, owing to the temporary or permanent waterlogging of the soil pores which causes a lack of oxygen over a long period."@en ] ;
    skos:exactMatch agrovoc:c_25315 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "hydromorphic soils"@en .

eusoilvoc:Illites a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:exactMatch agrovoc:c_15841 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "illites"@en .

eusoilvoc:IlliticSoils a skos:Concept ;
    skos:broader eusoilvoc:MineralogicalSoilTypes ;
    skos:exactMatch agrovoc:c_3797 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "illitic soils"@en .

eusoilvoc:Imogolite a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:definition [ dcterms:source agrovoc:c_15840 ;
            rdf:value "Imogolite is an aluminium silicate clay mineral with the chemical formula Al2SiO3(OH)4. It occurs in soils formed from volcanic ash."@en ] ;
    skos:exactMatch agrovoc:c_15840 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "imogolite"@en .

eusoilvoc:InSituSoilConservation a skos:Concept ;
    skos:broader eusoilvoc:SoilConservation ;
    skos:exactMatch agrovoc:c_330803 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "in situ soil conservation"@en .

eusoilvoc:InfiltrationWater a skos:Concept ;
    skos:broader eusoilvoc:SoilWater ;
    skos:exactMatch agrovoc:c_25321 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "infiltration water"@en .

eusoilvoc:IntegratedPlantNutrientManagement a skos:Concept ;
    skos:broader eusoilvoc:NutrientManagement ;
    skos:exactMatch agrovoc:c_330787 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "integrated plant nutrient management"@en .

eusoilvoc:IntegratedSoilFertilityManagement a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_8fc04948 ;
            rdf:value "The application of soil fertility management practices and the knowledge to adapt these to local conditions, which optimize fertilizer and organic resource use efficiency and crop productivity."@en ] ;
    skos:exactMatch agrovoc:c_8fc04948 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "integrated soil fertility management"@en .

eusoilvoc:IonTransportInSoil a skos:Concept ;
    skos:broader eusoilvoc:SoilTransport ;
    skos:exactMatch agrovoc:c_25019 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "ion transport in soil"@en .

eusoilvoc:IrrigatedSoils a skos:Concept ;
    skos:broader eusoilvoc:CulturalSoilTypes ;
    skos:exactMatch agrovoc:c_3953 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "irrigated soils"@en .

eusoilvoc:Kaolinite a skos:Concept ;
    skos:broader eusoilvoc:SoilClayMineral ;
    skos:exactMatch agrovoc:c_16135 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "kaolinite"@en .

eusoilvoc:KarstSoils a skos:Concept ;
    skos:broader eusoilvoc:PhysiographicSoilTypes ;
    skos:exactMatch agrovoc:c_34036 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "karst soils"@en .

eusoilvoc:KastanozemsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_4079 ;
            rdf:value "Kastanozems accommodate dry grassland soils, among them the soils of the short-grass steppe belt, south of the Eurasian tall-grass steppe belt with Chernozems. Kastanozems have a similar profile to that of Chernozems but the humus-rich surface horizon is thinner and not as dark as that of the Chernozems, and they show more prominent accumulation of secondary carbonates. The chestnut-brown colour of the surface soil is reflected in the name Kastanozem. Common names for many Kastanozems are (Dark) Chestnut soils (Russia), Kalktschernoseme (Germany), (Dark) Brown soils (Canada), Ustolls and Xerolls (United States of America) and Chernossolos (Brazil)."@en ] ;
    skos:exactMatch agrovoc:c_4079 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Kastanozems"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:SoilReclamation a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:closeMatch agrovoc:c_6474 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:SoilReclamationPlants ;
    skos:prefLabel "soil reclamation"@en .

eusoilvoc:LandRehabilitation a skos:Concept ;
    skos:broader eusoilvoc:SoilImprovement ;
    skos:definition [ dcterms:source agrovoc:c_33534 ;
            rdf:value "Land rehabilitation is an action to restore land already degraded to such an extent that the original use is no longer possible and the land has become practically unproductive."@en ] ;
    skos:exactMatch agrovoc:c_33534 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land rehabilitation"@en .

eusoilvoc:LandRestoration a skos:Concept ;
    skos:broader eusoilvoc:SoilImprovement ;
    skos:definition [ dcterms:source agrovoc:c_d50d4695 ;
            rdf:value "An intentional activity aimed at recovering degraded land."@en ] ;
    skos:exactMatch agrovoc:c_d50d4695 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land restoration"@en .

eusoilvoc:LandTake a skos:Concept ;
    skos:broader eusoilvoc:SoilAnthropogenicChanges ;
    skos:definition [ dcterms:source agrovoc:c_03e78242 ;
            rdf:value "Land take entails the conversion of land to artificial surfaces, which impairs the valuable ecological functions of lands."@en ] ;
    skos:exactMatch agrovoc:c_03e78242 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "land take"@en .

eusoilvoc:LayeredSoils a skos:Concept ;
    skos:broader eusoilvoc:SoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_4232 ;
            rdf:value "Soil composed of layers of different texture"@en ] ;
    skos:exactMatch agrovoc:c_4232 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "layered soils"@en .

eusoilvoc:Lead a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_4235 ;
            rdf:value "Lead is a chemical element with symbol Pb and atomic number 82. Classified as a post-transition metal, lead is a solid at room temperature."@en ] ;
    skos:exactMatch agrovoc:c_4235 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "lead"@en .

eusoilvoc:LeafMould a skos:Concept ;
    skos:broader eusoilvoc:Humus ;
    skos:definition [ dcterms:source agrovoc:c_4238 ;
            rdf:value "Leaf mould is formed from decaying leaves and produces an invaluable soil conditioner."@en ] ;
    skos:exactMatch agrovoc:c_4238 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "leaf mould"@en .

eusoilvoc:LeafMulches a skos:Concept ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_20c16f0f ;
            rdf:value "A mulch where leaves from tree or shrubs are used to cover soil surface. Leaves that have been mowed or shredded will decompose faster and are more likely to remain in place than unshredded leaves."@en ] ;
    skos:exactMatch agrovoc:c_20c16f0f ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "leaf mulches"@en .

eusoilvoc:LeptosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_da0af025 ;
            rdf:value "Leptosols comprise very thin soils over continuous rock and soils that are extremely rich in coarse fragments. Leptosols are particularly common in mountainous regions. Leptosols include Lithosols of the Soil Map of the World (FAO–UNESCO, 1971–1981), Lithic subgroups of the Entisol Order (United States of America), Leptic Rudosols or Tenosols (Australia), and Petrozems and Litozems (Russia). In many national systems and in the Soil Map of the World, Leptosols on calcareous rocks belong to Rendzinas and those on other rocks to Rankers. Continuous rock at the surface is considered nonsoil in many soil classification systems."@en ] ;
    skos:exactMatch agrovoc:c_da0af025 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Leptosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:LightMicroscopy a skos:Concept ;
    skos:broader eusoilvoc:Microscopy ;
    skos:definition [ dcterms:source agrovoc:c_01f95724 ;
            rdf:value "Microscopy using visible light and a system of lenses to magnify images."@en ] ;
    skos:exactMatch agrovoc:c_01f95724 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "light microscopy"@en .

eusoilvoc:LimeAmendment a skos:Concept ;
    skos:broader eusoilvoc:LimingMaterials ;
    skos:exactMatch agrovoc:c_36454 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "lime (amendment)"@en .

eusoilvoc:Liming a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_25206 ;
            rdf:value "The application of lime and other calcium fertilizers to the soil to eliminate excess acidity."@en ] ;
    skos:exactMatch agrovoc:c_25206 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "liming"@en .

eusoilvoc:LithosolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:exactMatch agrovoc:c_4389 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "lithosols"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:LiveMulches a skos:Concept ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:exactMatch agrovoc:c_4394 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
