    skos:broader eusoilvoc:SoilOrganisms ;
    skos:definition [ dcterms:source agrovoc:c_36167 ;
            rdf:value "Microorganisms in soil are important because they affect soil structure and fertility. Soil microorganisms can be classified as bacteria, actinomycetes, fungi, algae and protozoa. Each of these groups has characteristics that define them and their functions in soil"@en ] ;
