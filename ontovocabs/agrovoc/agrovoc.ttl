eusoilvoc:PlantGrowthPromotingRhizobacteria a skos:Concept ;
    skos:broader eusoilvoc:Rhizobacteria,
        eusoilvoc:SoilBacteria ;
    skos:definition [ dcterms:source agrovoc:c_cd313ffc ;
            rdf:value "Plant growth-promoting rhizobacteria (PGPR) are the rhizosphere bacteria that can enhance plant growth by a wide variety of mechanisms like phosphate solubilization, siderophore production, biological nitrogen fixation, rhizosphere engineering, production of 1-Aminocyclopropane-1-carboxylate deaminase (ACC), quorum sensing (QS) signal interference and inhibition of biofilm formation, phytohormone production, exhibiting antifungal activity, production of volatile organic compounds (VOCs), induction of systemic resistance, promoting beneficial plant-microbe symbioses, interference with pathogen toxin production etc"@en ] ;
    skos:exactMatch agrovoc:c_cd313ffc ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plant growth-promoting rhizobacteria"@en .

eusoilvoc:Ploughing a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_6021 ;
            rdf:value "Ploughing (tillage): mechanical cultivation of agricultural soils by the plough to different depths (20 – 30cm) deep, creating arable land."@en ] ;
    skos:exactMatch agrovoc:c_6021 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:DeepPloughing ;
    skos:prefLabel "ploughing"@en .

eusoilvoc:Rhizobacteria a skos:Concept ;
    skos:broader eusoilvoc:SoilBacteria ;
    skos:definition [ dcterms:source agrovoc:c_25068 ;
            rdf:value "Rhizobacteria are root-associated bacteria that can have a detrimental (parasitic varieties), neutral or beneficial effect on plant growth."@en ] ;
    skos:exactMatch agrovoc:c_25068 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:PlantGrowthPromotingRhizobacteria ;
    skos:prefLabel "Rhizobacteria"@en .

eusoilvoc:SalineSoils a skos:Concept ;
    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_6748 ;
            rdf:value "The distinguishing characteristic of saline soils from the agricultural standpoint, is that they contain sufficient neutral soluble salts to adversely affect the growth of most crop plants."@en ] ;
    skos:exactMatch agrovoc:c_6748 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:SolonchaksWRB ;
    skos:prefLabel "saline soils"@en .

