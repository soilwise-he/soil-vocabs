eusoilvoc:SoilAmendments a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_7159 ;
            rdf:value "Any material added to the soil to improve its physical and chemical properties. The application of amendments depends on the characteristics of the soils, and may include compost, livestock manure, magnesium sulphate, vinasse, zeolite (minerals or adsorbents that hydrate and dehydrate reversibly), charcoal or biochar, calcium sulphate, lime, cane by-product (bagasse), zinc sulphate, dolomite (calcium magnesium carbonate), vermicompost, sugar cane, palm kernel cake, phosphate rock, and other organic matter."@en ] ;
    skos:exactMatch agrovoc:c_7159 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:Biochar,
        eusoilvoc:EvaporationSuppressants,
        eusoilvoc:InorganicAmendments,
        eusoilvoc:LimingMaterials,
        eusoilvoc:Mulch,
        eusoilvoc:OrganicAmendments,
        eusoilvoc:SoilConditioners ;
    skos:prefLabel "soil amendments"@en .

eusoilvoc:SoilConservation a skos:Concept ;
    skos:broader eusoilvoc:SoilManagement ;
    skos:definition [ dcterms:source agrovoc:c_7165 ;
            rdf:value "Soil conservation is a combination of all methods of management and land use that safeguard the soil against depletion or deterioration by natural or human-induced factors. It most often attempts to ensure that soil does not erode and wash into streams and lakes or blow away in the wind, but it also involves the protection of the soil from damage by machinery (e.g., compaction) or by harmful changes to its chemistry (e.g., acidification or salinization)."@en ] ;
    skos:exactMatch agrovoc:c_7165 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:ContourBunding,
        eusoilvoc:ContourCultivation,
        eusoilvoc:CoverPlants,
        eusoilvoc:ErosionControl,
        eusoilvoc:InSituSoilConservation,
        eusoilvoc:SoilConservationLegislation,
        eusoilvoc:SoilStabilization ;
    skos:prefLabel "soil conservation"@en .

