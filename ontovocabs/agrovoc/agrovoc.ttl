eusoilvoc:MinimumTillage a skos:Concept ;
    skos:broader eusoilvoc:ConservationTillage ;
    skos:definition [ dcterms:source agrovoc:c_32734 ;
            rdf:value "Minimum tillage has been defined as the minimum soil disturbance needed for  crop production."@en ] ;
    skos:exactMatch agrovoc:c_32734 ;
