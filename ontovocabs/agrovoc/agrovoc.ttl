eusoilvoc:PhaeozemsWRB a skos:Concept ;
    skos:altLabel "Phaeozem"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_5755 ;
            rdf:value "Phaeozems accommodate soils of relatively wet grassland and forest regions in moderately continental climates. Phaeozems are much like Chernozems and Kastanozems but are leached more intensively. Consequently, they have dark, humusrich surface horizons that, in comparison with Chernozems and Kastanozems, are less rich in bases. Phaeozems are either free of secondary carbonates or have them only at greater depths. They all have a high base saturation in the upper metre of the soil. Commonly used names for many Phaeozems are Brunizems (Argentina and France), Dark grey forest soils and Leached and Podzolized chernozems (former Soviet Union), Tschernoseme (Germany) and Chernossolos (Brazil). In the Soil Map of the World (FAO–UNESCO, 1971–1981) they belong to the Phaeozems and partly to the Greyzems. Dusky-red prairie soils was their name in older systems of the United States of America, where most of them now belong to Udolls and Albolls."@en ] ;
    skos:exactMatch agrovoc:c_5755 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Phaeozems"@en .

eusoilvoc:PhosphorusTotalElements skos:broader eusoilvoc:PhosphorusContent ;
    skos:closeMatch agrovoc:c_ac4b3c22 .

eusoilvoc:PipeDrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:definition [ dcterms:source agrovoc:c_25597 ;
            rdf:value "Drainage using a buried pipe - regardless of material, size, or shape - which collects and conveys drainage water from a piece of land to a collector or to a main drain."@en ] ;
    skos:exactMatch agrovoc:c_25597 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "pipe drainage"@en .

eusoilvoc:Planking a skos:Concept ;
    skos:broader eusoilvoc:SoilTillage ;
    skos:definition [ dcterms:source agrovoc:c_330851 ;
            rdf:value " Planking is done to crush the hard clods and to smoothen surface soil and to compact the soil lightly. "@en ] ;
    skos:exactMatch agrovoc:c_330851 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "planking"@en .

eusoilvoc:PlanosolsWRB a skos:Concept ;
    skos:altLabel "Planosol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_5953 ;
            rdf:value "Planosols are soils with a mostly light-coloured horizon that shows signs of periodic water stagnation and that abruptly overlies a dense, slowly permeable subsoil with significantly more clay. The name Planosols was coined in 1938 in the United States of America, where now most of them are included in the Great Groups of the Albaqualfs, Albaquults and Argialbolls. The name has been adopted in Brazil (Planossolos)."@en ] ;
    skos:exactMatch agrovoc:c_5953 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Planosols"@en .

eusoilvoc:PlantAvailableBoron a skos:Concept ;
    skos:broader eusoilvoc:BoronContent ;
    skos:exactMatch agrovoc:c_531214d1 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plant available boron"@en .

eusoilvoc:PlantAvailablePhosphorus a skos:Concept ;
    skos:broader eusoilvoc:PhosphorusContent ;
    skos:definition [ dcterms:source agrovoc:c_eb7b4957 ;
            rdf:value "content of plant available phosphorus in soil"@en ] ;
    skos:exactMatch agrovoc:c_eb7b4957 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plant available phosphorus"@en .

eusoilvoc:PlantAvailableWater a skos:Concept ;
    skos:broader eusoilvoc:SoilWater ;
    skos:definition [ dcterms:source agrovoc:c_31e02b4d ;
            rdf:value "The portion of water in a soil that can be absorbed by plant roots, that is, water held at a tension of less than 1500 kPa in the soil."@en ] ;
    skos:exactMatch agrovoc:c_31e02b4d ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plant available water"@en .

eusoilvoc:PlasticMulches a skos:Concept ;
    skos:altLabel "plastic mulch"@en ;
    skos:broader eusoilvoc:DryMulches ;
    skos:definition [ dcterms:source agrovoc:c_13452 ;
            rdf:value "A mulch where plastic sheet is used to cover soil surface. Plants grow through slits or holes in thin plastic sheeting."@en ] ;
    skos:exactMatch agrovoc:c_13452 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plastic mulches"@en .

eusoilvoc:PlinthosolsWRB a skos:Concept ;
    skos:altLabel "Plinthosol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_309e7c25 ;
            rdf:value "Plinthosols are soils with plinthite, petroplinthite or pisoliths. Plinthite is a Fe-rich (in some cases also Mn-rich), humus-poor mixture of kaolinitic clay (and other products of strong weathering such as gibbsite) with quartz and other constituents. It usually changes irreversibly to a layer with hard concretions or nodules or to a hardpan on exposure to repeated wetting and drying. Petroplinthite is a continuous or fractured sheet of connected, strongly cemented to indurated concretions or nodules or concentrations in platy, polygonal or reticulate patterns. Pisoliths are discrete, strongly cemented to indurated concretions or nodules. Both petroplinthite and pisoliths develop from plinthite by hardening. Traditional names are Groundwater Laterite Soils and Perched Water Laterite Soils. Many of these soils are known as Plintossolos (Brazil), Sols gris latéritiques (France), Petroferric Kandosols (Australia) and Plinthaquox, Plinthaqualfs, Plinthoxeralfs, Plinthustalfs, Plinthaquults, Plinthohumults, Plinthudults and Plinthustults (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_309e7c25 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Plinthosols"@en .

eusoilvoc:PodzolsWRB a skos:Concept ;
    skos:altLabel "Podzol"@en ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_6044 ;
            rdf:value "Podzols have an illuvial horizon with accumulation of black organic matter and/or reddish Fe oxides. This illuvial horizon is typically overlain by an ash-grey eluvial horizon. Podzols occur in humid areas in the boreal and temperate zones and locally also in the tropics. The name Podzol is used in most national soil classification systems; other names for many of these soils are Spodosols (China and United States of America), Espodossolos (Brazil) and Podosols (Australia)."@en ] ;
    skos:exactMatch agrovoc:c_6044 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Podzols"@en .

eusoilvoc:PodzoluvisolsFAO a skos:Concept ;
    skos:altLabel "podzoluvisol"@en ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:exactMatch agrovoc:c_6045 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "podzoluvisols"@en .

eusoilvoc:PolderSoils a skos:Concept ;
    skos:altLabel "polder soil"@en ;
    skos:broader eusoilvoc:AnthropogenicSoils ;
    skos:definition [ dcterms:source agrovoc:c_6059 ;
            rdf:value "Polder soils develop from oceanic and lacustrine sediments covered with seawater, brackish water, and freshwater after artificial drainage."@en ] ;
    skos:exactMatch agrovoc:c_6059 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polder soils"@en .

eusoilvoc:PollutedSoils a skos:Concept ;
    skos:altLabel "polluted soil"@en ;
    skos:broader eusoilvoc:AnthropogenicSoils ;
    skos:exactMatch agrovoc:c_34324 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polluted soils"@en .

eusoilvoc:PolychlorinatedBiphenyls a skos:Concept ;
    skos:altLabel "polychlorinated biphenyl"@en ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_24066 ;
            rdf:value "PCB are toxic and can cause serious health effects in humans and animals, including reproductive impairment and immune system dysfunctions. Once in the environment, PCB enter the food chain. PCBs are toxic to wildlife, including fish, killing them at higher doses and causing spawning failures at lower doses."@en ] ;
    skos:exactMatch agrovoc:c_24066 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polychlorinated biphenyls"@en .

eusoilvoc:PolycyclicAromaticHydrocarbons a skos:Concept ;
    skos:altLabel "polycyclic aromatic hydrocarbon"@en ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_331394 ;
            rdf:value "A class of chemicals that result from burning coal, oil, gas, wood, garbage, or tobacco. They bind to or form small particles in the air. High heat when cooking meat and other foods will also form PAHs."@en ] ;
    skos:exactMatch agrovoc:c_331394 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polycyclic aromatic hydrocarbons"@en .

