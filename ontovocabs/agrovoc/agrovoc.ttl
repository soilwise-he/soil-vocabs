eusoilvoc:Methanogens a skos:Concept ;
    skos:broader eusoilvoc:Archaea ;
    skos:definition [ dcterms:source agrovoc:c_27572 ;
            rdf:value "Methanogens are anaerobic archaea that grow by producing methane gas. Methane-producing archaea, or methanogens, are characterized by their ability to conserve energy for ATP (adenosine triphosphate) synthesis by producing methane gas."@en ] ;
    skos:exactMatch agrovoc:c_27572 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "methanogens"@en .

eusoilvoc:MicrobialDiversity a skos:Concept ;
    skos:broader eusoilvoc:Biodiversity ;
    skos:definition [ dcterms:source agrovoc:c_7f962590 ;
            rdf:value "Microbial diversity comprises the variety that is observed within highly genetically distinct groups, namely, bacteria, archaea, cyanobacteria, fungi, and viruses."@en ] ;
    skos:exactMatch agrovoc:c_7f962590 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "microbial diversity"@en .

eusoilvoc:Microplastics a skos:Concept ;
    skos:broader eusoilvoc:SoilPollutants ;
    skos:definition [ dcterms:source agrovoc:c_ccc97cab ;
            rdf:value "Microplastics are usually defined as plastic items which measure less than 5 mm in their longest dimension, this definition includes also nanoplastics which are particles less than 100 nanometres (nm) in their longest dimension. Plastic items may be manufactured within this size range (primary micro- and nanoplastics) or result from the degradation and fragmentation of larger plastic items (secondary micro- and nanoplastics)."@en ] ;
    skos:exactMatch agrovoc:c_ccc97cab ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "microplastics"@en .

