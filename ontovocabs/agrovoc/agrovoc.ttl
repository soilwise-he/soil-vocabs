    skos:prefLabel "erosion control plants"@en .

eusoilvoc:EvaporationSuppressants a skos:Concept ;
    skos:altLabel "evaporation suppressant"@en ;
    skos:broader eusoilvoc:SoilAmendments ;
    skos:exactMatch agrovoc:c_2740 ;
