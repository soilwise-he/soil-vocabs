    skos:prefLabel "wetland soils"@en .

eusoilvoc:WheelTracks a skos:Concept ;
    skos:broader eusoilvoc:SoilMorphologicalFeatures ;
    skos:definition [ dcterms:source agrovoc:c_9093eccc ;
            rdf:value "Depressions in the soil which are caused by the rolling of vehicle wheels over the surface of the soil."@en ] ;
    skos:exactMatch agrovoc:c_9093eccc ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wheel tracks"@en .

eusoilvoc:WoodChipsMulches a skos:Concept ;
    skos:broader eusoilvoc:OrganicMulches ;
    skos:definition [ dcterms:source agrovoc:c_b6875485 ;
            rdf:value "A mulch where wood chips are used to cover soil surface. "@en ] ;
    skos:exactMatch agrovoc:c_b6875485 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "wood chips mulches"@en .

eusoilvoc:XRayDiffraction a skos:Concept ;
    skos:broader eusoilvoc:SoilAnalysis ;
    skos:definition [ dcterms:source agrovoc:c_79bab836 ;
            rdf:value "The scattering of x-rays by matter, especially crystals, with accompanying variation in intensity due to interference effects. Analysis of the crystal structure of materials is performed by passing x-rays through them and registering the diffraction image of the rays."@en ] ;
    skos:exactMatch agrovoc:c_79bab836 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "X-ray diffraction"@en .

