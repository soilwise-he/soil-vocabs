    skos:broader eusoilvoc:Enzymes ;
    skos:exactMatch agrovoc:c_29494 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "beta glucosidase"@en .

eusoilvoc:Biochar a skos:Concept ;
    skos:broader eusoilvoc:SoilAmendments ;
    skos:exactMatch agrovoc:c_e25876d3 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biochar"@en .

eusoilvoc:Biodegradation a skos:Concept ;
    skos:broader eusoilvoc:SoilBiologicalProcesses ;
    skos:definition [ dcterms:source agrovoc:c_9261 ;
            rdf:value "Biodegradation is the physical and chemical breakdown of a substance by living organisms, mainly bacteria and/or fungi."@en ] ;
    skos:exactMatch agrovoc:c_9261 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biodegradation"@en .

eusoilvoc:Biodrainage a skos:Concept ;
    skos:broader eusoilvoc:SoilDrainage ;
    skos:definition [ dcterms:source agrovoc:c_ac7696b9 ;
            rdf:value "Biodrainage is defined as the process of removing the excess soil water through transpiration using bio-energy of the plant and radiation energy of the sun."@en ] ;
    skos:exactMatch agrovoc:c_ac7696b9 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "biodrainage"@en .

eusoilvoc:BiologicalFeatures skos:narrower eusoilvoc:Mycorrhizae .

