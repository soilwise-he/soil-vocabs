    skos:prefLabel "sandy soils"@en .

eusoilvoc:SilicateMinerals a skos:Concept ;
    skos:broader eusoilvoc:Minerals ;
    skos:definition [ dcterms:source agrovoc:c_18414ed6 ;
            rdf:value "Silicate minerals are rock-forming minerals made up of silicate groups. They are the largest and most important class of minerals and make up approximately 90 percent of Earth's crust."@en ] ;
    skos:exactMatch agrovoc:c_18414ed6 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:narrower eusoilvoc:Feldspar ;
    skos:prefLabel "silicate minerals"@en .

