    skos:broader eusoilvoc:ChemicalSoilTypes ;
    skos:definition [ dcterms:source agrovoc:c_7144 ;
            rdf:value "A soil that contains sufficient sodium to adversely affect the growth of most crop plants (sodic soils are defined as those soils which have an exchangeable sodium percentage of more than 15)."@en ] ;
    skos:exactMatch agrovoc:c_7144 ;
