    skos:definition [ dcterms:source agrovoc:c_24233 ;
            rdf:value "A method of cultivation by a motorized cultivator that works the soil by means of rotating tines or blades."@en ] ;
    skos:exactMatch agrovoc:c_24233 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "rotary cultivation"@en .

