eusoilvoc:PlantAvailableWater a skos:Concept ;
    skos:broader eusoilvoc:SoilWater ;
    skos:definition [ dcterms:source agrovoc:c_31e02b4d ;
            rdf:value "The portion of water in a soil that can be absorbed by plant roots, that is, water held at a tension of less than 1500 kPa in the soil."@en ] ;
    skos:exactMatch agrovoc:c_31e02b4d ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plant available water"@en .

eusoilvoc:PlantNematodes a skos:Concept ;
    skos:broader eusoilvoc:Nematodes ;
    skos:exactMatch agrovoc:c_5972 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plant nematodes"@en .

eusoilvoc:PlasticMulches a skos:Concept ;
    skos:broader eusoilvoc:DryMulches ;
    skos:definition [ dcterms:source agrovoc:c_13452 ;
            rdf:value "A mulch where plastic sheet is used to cover soil surface. Plants grow through slits or holes in thin plastic sheeting."@en ] ;
    skos:exactMatch agrovoc:c_13452 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "plastic mulches"@en .

eusoilvoc:PlinthosolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_309e7c25 ;
            rdf:value "Plinthosols are soils with plinthite, petroplinthite or pisoliths. Plinthite is a Fe-rich (in some cases also Mn-rich), humus-poor mixture of kaolinitic clay (and other products of strong weathering such as gibbsite) with quartz and other constituents. It usually changes irreversibly to a layer with hard concretions or nodules or to a hardpan on exposure to repeated wetting and drying. Petroplinthite is a continuous or fractured sheet of connected, strongly cemented to indurated concretions or nodules or concentrations in platy, polygonal or reticulate patterns. Pisoliths are discrete, strongly cemented to indurated concretions or nodules. Both petroplinthite and pisoliths develop from plinthite by hardening. Traditional names are Groundwater Laterite Soils and Perched Water Laterite Soils. Many of these soils are known as Plintossolos (Brazil), Sols gris latéritiques (France), Petroferric Kandosols (Australia) and Plinthaquox, Plinthaqualfs, Plinthoxeralfs, Plinthustalfs, Plinthaquults, Plinthohumults, Plinthudults and Plinthustults (United States of America)."@en ] ;
    skos:exactMatch agrovoc:c_309e7c25 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Plinthosols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:PodzolsWRB a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationWRB ;
    skos:definition [ dcterms:source agrovoc:c_6044 ;
            rdf:value "Podzols have an illuvial horizon with accumulation of black organic matter and/or reddish Fe oxides. This illuvial horizon is typically overlain by an ash-grey eluvial horizon. Podzols occur in humid areas in the boreal and temperate zones and locally also in the tropics. The name Podzol is used in most national soil classification systems; other names for many of these soils are Spodosols (China and United States of America), Espodossolos (Brazil) and Podosols (Australia)."@en ] ;
    skos:exactMatch agrovoc:c_6044 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "Podzols"@en ;
    skos:scopeNote "WRB reference soil group. This concept is separate from similarly named FAO-UNESCO or USDA Soil Taxonomy concepts; its definition is not transferred to those systems."@en .

eusoilvoc:PodzoluvisolsFAO a skos:Concept ;
    skos:broader eusoilvoc:SoilClassificationFAO ;
    skos:exactMatch agrovoc:c_6045 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "podzoluvisols"@en ;
    skos:scopeNote "Legacy FAO-UNESCO Soil Map of the World soil group. Kept separate from similarly named taxa in WRB and USDA Soil Taxonomy; this does not assert equivalence between classification systems."@en .

eusoilvoc:PolderSoils a skos:Concept ;
    skos:broader eusoilvoc:AnthropogenicSoils ;
    skos:definition [ dcterms:source agrovoc:c_6059 ;
            rdf:value "Polder soils develop from oceanic and lacustrine sediments covered with seawater, brackish water, and freshwater after artificial drainage."@en ] ;
    skos:exactMatch agrovoc:c_6059 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "polder soils"@en .

