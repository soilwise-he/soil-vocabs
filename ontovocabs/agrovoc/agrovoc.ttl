eusoilvoc:NotPlantAvailableWater a skos:Concept ;
    skos:broader eusoilvoc:SoilWater ;
    skos:definition [ dcterms:source agrovoc:c_aa83b262 ;
            rdf:value "Some soil water is strongly fixed by capillary effects in soil pores and is not available for plants. The smaller the pores the higher the water retention."@en ] ;
    skos:exactMatch agrovoc:c_aa83b262 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "not plant available water"@en .

eusoilvoc:NurseryBedPreparation a skos:Concept ;
    skos:broader eusoilvoc:FieldPreparation ;
    skos:definition [ dcterms:source agrovoc:c_330842 ;
            rdf:value "Good nursery-bed preparation and forming is necessary to ensure accurate sowing of seed; good conditions for plant growth; the use of specialist machinery; and ease of harvesting. It involves preparing raised seedbeds of fine tilth, ensuring that soil fertility is correct, and controlling weeds or other pathogens."@en ] ;
    skos:exactMatch agrovoc:c_330842 ;
    skos:inScheme <https://w3id.org/eusoilvoc> ;
    skos:prefLabel "nursery bed preparation"@en .

