@prefix agrontology: <http://aims.fao.org/aos/agrontology#> .
@prefix bao: <http://www.bioassayontology.org/bao#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eusoilvoc: <https://w3id.org/eusoilvoc#> .
@prefix om: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sio: <http://semanticscience.org/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

skos:Concept a rdfs:Class ;
	rdfs:label "Concept"@en .

skos:ConceptScheme a rdfs:Class ;
	rdfs:label "Concept Scheme"@en .

sosa:ObservableProperty a rdfs:Class ;
	rdfs:label "Observable Property"@en .

sosa:Procedure a rdfs:Class ;
	rdfs:label "Procedure"@en .

agrontology:affects a rdf:Property ;
	rdfs:label "affects"@en .

agrontology:causes a rdf:Property ;
	rdfs:label "causes"@en .

agrontology:compose a rdf:Property ;
	rdfs:label "compose"@en .

agrontology:hasComponent a rdf:Property ;
	rdfs:label "has component"@en .

agrontology:hasObjectOfActivity a rdf:Property ;
	rdfs:label "has object of activity"@en .

agrontology:hasPart a rdf:Property ;
	rdfs:label "has part"@en .

agrontology:includes a rdf:Property ;
	rdfs:label "includes"@en .

agrontology:isAffectedBy a rdf:Property ;
	rdfs:label "is affected by"@en .

agrontology:isCausedBy a rdf:Property ;
	rdfs:label "is caused by"@en .

agrontology:isComponentOf a rdf:Property ;
	rdfs:label "is component of"@en .

agrontology:isComposedOf a rdf:Property ;
	rdfs:label "is composed of"@en .

agrontology:isIncludedIn a rdf:Property ;
	rdfs:label "is included in"@en .

agrontology:isObjectOfActivity a rdf:Property ;
	rdfs:label "is object of activity"@en .

agrontology:isPartOf a rdf:Property ;
	rdfs:label "is part of"@en .

agrontology:isProcessFor a rdf:Property ;
	rdfs:label "is process for"@en .

agrontology:isStudiedBy a rdf:Property ;
	rdfs:label "is studied by"@en .

agrontology:study a rdf:Property ;
	rdfs:label "study"@en .

agrontology:usesProcess a rdf:Property ;
	rdfs:label "uses process"@en .

dcterms:source a rdf:Property ;
	rdfs:label "source"@en .

sio:equivalentTo a rdf:Property ;
	rdfs:label "equivalent to"@en .

rdf:type a rdf:Property ;
	rdfs:label "type"@en .

rdf:value a rdf:Property ;
	rdfs:label "value"@en .

skos:altLabel a rdf:Property ;
	rdfs:label "alternative label"@en .

skos:broader a rdf:Property ;
	rdfs:label "broader"@en .

skos:closeMatch a rdf:Property ;
	rdfs:label "close match"@en .

skos:definition a rdf:Property ;
	rdfs:label "definition"@en .

skos:exactMatch a rdf:Property ;
	rdfs:label "exact match"@en .

skos:hasTopConcept a rdf:Property ;
	rdfs:label "has top concept"@en .

skos:inScheme a rdf:Property ;
	rdfs:label "in scheme"@en .

skos:narrower a rdf:Property ;
	rdfs:label "narrower"@en .

skos:prefLabel a rdf:Property ;
	rdfs:label "preferred label"@en .

skos:related a rdf:Property ;
	rdfs:label "related"@en .

skos:topConceptOf a rdf:Property ;
	rdfs:label "top concept of"@en .

sosa:hasProcedure a rdf:Property ;
	rdfs:label "has procedure"@en .

sosa:isProcedureFor a rdf:Property ;
	rdfs:label "is procedure for"@en .

# BAO does not declare this pair owl:inverseOf in its property module.
# The SML vocabulary explicitly stores and validates both directions.
bao:BAO_0095002 a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has indicator"@en ;
    rdfs:isDefinedBy <http://www.bioassayontology.org/bao/bao_vocabulary_properties.owl> .

bao:BAO_0002586 a rdf:Property, owl:ObjectProperty ;
    rdfs:label "is indicator of"@en ;
    rdfs:isDefinedBy <http://www.bioassayontology.org/bao/bao_vocabulary_properties.owl> .

qudt:hasUnit a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has unit"@en ;
    rdfs:range qudt:Unit ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

qudt:hasFactorUnit a rdf:Property, owl:ObjectProperty ;
    rdfs:label "has factor unit"@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

qudt:exponent a rdf:Property, owl:AnnotationProperty ;
    rdfs:label "exponent"@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

qudt:symbol a rdf:Property, owl:AnnotationProperty ;
    rdfs:label "symbol"@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

qudt:ucumCode a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "UCUM code"@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

qudt:Unit a rdfs:Class, owl:Class ;
    rdfs:label "Unit"@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

qudt:DerivedUnit a rdfs:Class, owl:Class ;
    rdfs:label "Derived unit"@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

qudt:FactorUnit a rdfs:Class, owl:Class ;
    rdfs:label "Factor unit"@en ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

eusoilvoc:SquareKilometrePerYear a qudt:Unit, qudt:DerivedUnit ;
    rdfs:label "square kilometre per year"@en ;
    qudt:symbol "km2/a" ;
    qudt:ucumCode "km2.a-1" ;
    qudt:hasFactorUnit [ a qudt:FactorUnit ;
            qudt:hasUnit unit:KiloM2 ;
            qudt:exponent 1 ],
        [ a qudt:FactorUnit ;
            qudt:hasUnit unit:YR ;
            qudt:exponent -1 ] .

om:centimetrePerDay a qudt:Unit ;
    rdfs:label "centimetre per day"@en ;
    qudt:symbol "cm/d" ;
    rdfs:isDefinedBy <http://www.ontology-of-units-of-measure.org/resource/om-2/> .

unit:CentiM a qudt:Unit ;
    rdfs:label "Centimetre"@en ;
    qudt:symbol "cm" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/CentiM> .

unit:DAY a qudt:Unit ;
    rdfs:label "Day"@en ;
    qudt:symbol "d" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/DAY> .

unit:DeciS-PER-M a qudt:Unit ;
    rdfs:label "Decisiemens per Metre"@en ;
    qudt:symbol "dS/m" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/DeciS-PER-M> .

unit:GM-PER-CentiM3 a qudt:Unit ;
    rdfs:label "Gram per Cubic Centimetre"@en ;
    qudt:symbol "g/cm\u00B3" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/GM-PER-CentiM3> .

unit:GM-PER-KiloGM a qudt:Unit ;
    rdfs:label "Gram per Kilogram"@en ;
    qudt:symbol "g/kg" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/GM-PER-KiloGM> .

unit:KiloM2 a qudt:Unit ;
    rdfs:label "Square Kilometre"@en ;
    qudt:symbol "km\u00B2" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/KiloM2> .

unit:MilliGM-PER-GM a qudt:Unit ;
    rdfs:label "Milligram per Gram"@en ;
    qudt:symbol "mg/g" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/MilliGM-PER-GM> .

unit:MilliGM-PER-KiloGM a qudt:Unit ;
    rdfs:label "Milligram per Kilogram"@en ;
    qudt:symbol "mg/kg" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/MilliGM-PER-KiloGM> .

unit:PERCENT a qudt:Unit ;
    rdfs:label "Percent"@en ;
    qudt:symbol "%" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/PERCENT> .

unit:PERCENT-PER-YR a qudt:Unit ;
    rdfs:label "Percent per Year"@en ;
    qudt:symbol "%/a" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/PERCENT-PER-YR> .

unit:PH a qudt:Unit ;
    rdfs:label "Acidity"@en ;
    qudt:symbol "pH" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/PH> .

unit:TONNE-PER-HA a qudt:Unit ;
    rdfs:label "Tonne per Hectare"@en ;
    qudt:symbol "t/ha" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/TONNE-PER-HA> .

unit:TONNE-PER-HA-YR a qudt:Unit ;
    rdfs:label "Tonne per Hectare Year"@en ;
    qudt:symbol "t/(ha\u00B7a)" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/TONNE-PER-HA-YR> .

unit:UNITLESS a qudt:Unit ;
    rdfs:label "Unitless"@en ;
    qudt:symbol "\u4E00" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/UNITLESS> .

unit:YR a qudt:Unit ;
    rdfs:label "Year"@en ;
    qudt:symbol "a" ;
    rdfs:isDefinedBy <http://qudt.org/vocab/unit/YR> .
